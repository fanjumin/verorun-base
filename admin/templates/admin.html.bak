<!DOCTYPE html>
<!-- V20260514-0930 -->
<html lang="zh-CN">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>管理后台 — easykai.cn</title>
<link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/static/favicon-16x16.png">
<link href="/static/lib/quill/quill.snow.css" rel="stylesheet">
<!-- <script src="/static/lib/dicebear.js"></script> -->
{% if theme_css_url %}<link rel="stylesheet" href="{{ theme_css_url }}">{% endif %}
<style>
:root {
  --w: 220px;
  --bg: #0a0a0a;
  --card: #111118;
  --border: rgba(255,255,255,0.06);
  --text: #e0e0e0;
  --muted: #8b8b8b;
  --dim: #555;
  --accent: #00f5ff;
  --accent2: #a020f0;
  --accent3: #00ff9f;
  --radius: 8px;
  --sidebar-bg: rgba(13,13,24,0.88);
  --sidebar-border: rgba(0,245,255,0.08);
  --glow-accent: rgba(0,245,255,0.12);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans SC",sans-serif;background:var(--bg);color:var(--text);display:flex;min-height:100vh}
.sidebar{width:var(--w);min-width:var(--w);background:var(--sidebar-bg);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-right:1px solid var(--sidebar-border);height:100vh;position:sticky;top:0;overflow-y:auto;overflow-x:hidden;display:flex;flex-direction:column;transition:width .25s ease,min-width .25s ease;z-index:100}
.sidebar::-webkit-scrollbar{width:3px}
.sidebar::-webkit-scrollbar-track{background:transparent}
.sidebar::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.08);border-radius:3px}
.sidebar .logo{padding:14px 16px 12px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--sidebar-border);flex-shrink:0}
.sidebar .logo .logo-icon{width:28px;height:28px;background:linear-gradient(135deg,var(--accent),var(--accent2));border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;color:#000;flex-shrink:0}
.sidebar .logo .logo-text{font-size:14px;font-weight:700;background:linear-gradient(90deg,var(--accent),var(--accent3));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.sidebar .logo .logo-sub{font-size:9px;color:var(--dim);letter-spacing:1px;text-transform:uppercase;margin-top:-1px}
.sidebar nav{padding:6px 0;flex:1}
.ng{margin-bottom:2px}
.ns{display:flex;align-items:center;gap:6px;padding:8px 16px 5px;font-size:12px;color:var(--dim);text-transform:uppercase;letter-spacing:1.2px;cursor:pointer;user-select:none;transition:color .2s}
.ns:hover{color:var(--muted)}
.ns .ns-arrow{font-size:8px;transition:transform .2s;display:inline-block}
.ng-body{overflow:hidden;transition:max-height .25s ease;max-height:500px}
.ng-body.collapsed{max-height:0}
.ni{display:flex;align-items:center;gap:10px;padding:8px 16px;color:var(--muted);font-size:15px;cursor:pointer;border:none;background:none;width:100%;text-align:left;position:relative;transition:all .18s ease;border-left:2px solid transparent}
.ni:hover{color:var(--text);background:linear-gradient(90deg,rgba(255,255,255,0.03),transparent);border-left-color:rgba(255,255,255,0.08)}
.ni.sel{color:var(--accent);background:linear-gradient(90deg,var(--glow-accent),transparent);border-left-color:var(--accent)}
.ni.sel::after{content:'';position:absolute;right:0;top:50%;transform:translateY(-50%);width:3px;height:60%;background:var(--accent);border-radius:3px 0 0 3px;box-shadow:0 0 8px var(--accent)}
.ni svg{width:16px;height:16px;flex-shrink:0;opacity:.65;transition:opacity .2s}
.ni:hover svg{opacity:1}
.ni.sel svg{opacity:1}
.ni span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.main{flex:1;overflow-y:auto;min-width:0}
.top{display:flex;align-items:center;justify-content:space-between;padding:10px 24px;border-bottom:1px solid var(--border);font-size:13px;background:rgba(10,10,10,0.6);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);position:sticky;top:0;z-index:50}
.top .pt{font-weight:600}
.con{padding:20px 24px}
/* Quill dark theme */
.ql-snow .ql-toolbar{background:#1a1a2e;border-color:var(--border);border-radius:8px 8px 0 0}
.ql-snow .ql-stroke{stroke:#b0b0c0}.ql-snow .ql-fill{fill:#b0b0c0}
.ql-snow .ql-picker{color:#b0b0c0}
.ql-container.ql-snow{border-color:var(--border);border-radius:0 0 8px 8px;font-size:14px}
.ql-editor{color:var(--text);min-height:180px}
.ql-editor.ql-blank::before{color:var(--dim);font-style:normal}
.ql-snow .ql-picker-options{background:#1a1a2e;border-color:var(--border)}
.ni{display:flex;align-items:center;gap:8px;padding:7px 16px;color:var(--muted);font-size:12px;cursor:pointer;border:none;background:none;width:100%;text-align:left}
.ni:hover{color:var(--text);background:rgba(255,255,255,.02)}
.ni.sel{color:var(--accent);background:rgba(0,212,170,.06);border-right:2px solid var(--accent)}
.main{flex:1;overflow-y:auto}
.top{display:flex;align-items:center;justify-content:space-between;padding:10px 24px;border-bottom:1px solid var(--border);font-size:13px}
.top .pt{font-weight:600}
.con{padding:20px 24px}
.gr{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;margin-bottom:16px}
.cd{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:14px}
.cd .l{font-size:10px;color:var(--dim);text-transform:uppercase}
.cd .v{font-size:18px;font-weight:700;margin-top:2px}
.cd .v.g{color:var(--accent)}.cd .v.b{color:#58a6ff}.cd .v.r{color:#f85149}
table{width:100%;border-collapse:collapse;font-size:12px;margin-top:8px}
th{background:var(--bg);color:var(--dim);padding:6px 8px;text-align:left;border-bottom:2px solid var(--border);font-weight:500}
td{padding:6px 8px;border-bottom:1px solid var(--border);color:var(--muted)}
.st{font-size:13px;font-weight:600;padding-bottom:6px;border-bottom:1px solid var(--border);margin-bottom:10px}
.em{padding:30px;text-align:center;color:var(--dim);font-size:12px}
.sbar{display:flex;gap:8px;margin-bottom:12px;align-items:center}
.sbar input{padding:6px 10px;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:12px;flex:1;max-width:260px;outline:none}
.sbar input:focus{border-color:var(--accent)}
.btn{padding:5px 12px;border-radius:5px;font-size:11px;font-weight:600;cursor:pointer;border:none}
.bp{background:var(--accent);color:#fff}
.bo{background:transparent;color:var(--text);border:1px solid var(--border)}
.bs{padding:3px 8px;font-size:10px}
.bdg{display:inline-block;padding:1px 6px;border-radius:3px;font-size:10px;font-weight:600}
.bdg.on{background:rgba(0,212,170,.12);color:var(--accent)}
.bdg.off{background:rgba(248,81,73,.1);color:#f85149}
.bdg.pd{background:rgba(240,192,64,.12);color:#f0c040}
.lo{text-align:center;padding:40px;color:var(--dim)}
.s{width:20px;height:20px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:sp .8s linear infinite;margin:0 auto 8px}
@keyframes sp{to{transform:rotate(360deg)}}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
.in{background:var(--bg);border:1px solid var(--border);color:var(--text);padding:5px 8px;border-radius:4px;font-size:12px;outline:none}
.in:focus{border-color:var(--accent)}
.sl{background:var(--bg);border:1px solid var(--border);color:var(--text);padding:5px;border-radius:4px;font-size:12px}
.ta{background:var(--bg);border:1px solid var(--border);color:var(--text);padding:5px;border-radius:4px;font-size:12px;resize:vertical;width:100%}
.fl{display:flex;align-items:center;padding:8px 0;border-bottom:1px solid var(--border);gap:8px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
/* Email detail modal */
.modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.7);z-index:1000;display:flex;align-items:center;justify-content:center}
.modal-box{background:var(--card);border:1px solid var(--border);border-radius:12px;width:640px;max-width:90vw;max-height:80vh;overflow-y:auto;padding:24px}
.modal-box h3{font-size:16px;color:var(--text);margin-bottom:8px;padding-right:30px}
.modal-meta{font-size:12px;color:var(--dim);margin-bottom:16px;line-height:1.8}
.modal-meta span{color:var(--muted);margin-right:12px}
.modal-body{font-size:13px;color:var(--text);line-height:1.7;padding:16px;background:var(--bg);border-radius:8px;border:1px solid var(--border);white-space:pre-wrap;word-break:break-word}
.modal-body img{max-width:100%;border-radius:4px}
.modal-attach{margin-top:12px}
.modal-attach a{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;margin:2px;background:var(--bg);border-radius:4px;font-size:12px;color:var(--accent);text-decoration:none}
.modal-attach a:hover{background:var(--border)}
/* Toast */
.toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%);background:#1a1a2e;color:var(--text);padding:10px 20px;border-radius:8px;font-size:13px;z-index:2000;opacity:0;transition:opacity .3s;pointer-events:none;border:1px solid var(--border)}
.toast.show{opacity:1}
.toast.error{color:#f85149;border-color:#f85149}
.toast.success{color:var(--accent);border-color:var(--accent)}
@keyframes sp{to{transform:rotate(360deg)}}
@media(max-width:768px){.sidebar{width:52px;min-width:52px}.sidebar .logo{padding:12px 10px;justify-content:center}.sidebar .logo .logo-text,.sidebar .logo .logo-sub,.ni span,.ns .ns-label{display:none}.ns{justify-content:center;padding:10px 0 4px}.ns .ns-arrow{display:none}.ni{justify-content:center;padding:8px 0;border-left:none}.ni svg{width:18px;height:18px}.ni.sel::after{display:none}.ni.sel{background:var(--glow-accent);border-left:none}}
</style>
</head>
<body>
<div class="sidebar">
  <div class="logo">
    <div class="logo-icon">E</div>
    <div>
      <div class="logo-text">easykai</div>
      <div class="logo-sub">Admin</div>
    </div>
  </div>
  <nav id="nav"></nav>
</div>
<div class="main">
  <div class="top"><div class="pt" id="pt">控制台</div><div><span id="an">-</span> | <a href="/" style="color:var(--dim);font-size:11px">返回</a> | <a href="javascript:logout()" style="color:#f85149;font-size:11px">退出</a></div></div>
  <div class="con" id="mc"><div class="lo"><div class="s"></div>验证身份中...</div></div>
</div>
<div class="toast" id="adminToast"></div>
<script>
// ── Admin JS runs FIRST, Quill loads async below ──
var T=localStorage.getItem("sso_token")||localStorage.getItem("tm_token")||localStorage.getItem("token");
if(T)document.cookie="sso_token="+T+"; path=/; max-age=604800";
var P=new URLSearchParams(location.search);
if(P.get("token")){T=P.get("token");localStorage.setItem("sso_token",T);localStorage.setItem("tm_token",T);localStorage.setItem("token",T);document.cookie="sso_token="+T+"; path=/; max-age=604800";window.history.replaceState({},"",window.location.pathname)}
function S(p){return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">'+p+'</svg>'}
var I={
  dashboard:S('<rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/>'),
  users:S('<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>'),
  agents:S('<rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8" y2="16.01"/><line x1="16" y1="16" x2="16" y2="16.01"/>'),
  keys:S('<circle cx="8" cy="21" r="2"/><path d="M8 17V3l3 2 3-2 3 2 3-2v8"/><path d="M16 21c0-2.5-2-4-4-4"/>'),
  cms:S('<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>'),
  contentfactory:S('<path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 13h5l-5-5"/><path d="M7 13H2l5-5"/>'),
  posts:S('<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>'),
  community:S('<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>'),
  comments:S('<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="12" y1="13" x2="12" y2="13"/>'),
  matrix:S('<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="2" x2="9" y2="4"/><line x1="15" y1="2" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="22"/><line x1="15" y1="20" x2="15" y2="22"/>'),
  automation:S('<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>'),
  health:S('<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>'),
  analytics:S('<line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/>'),
  plans:S('<path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="22" x2="12" y2="12"/>'),
  subscriptions:S('<rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>'),
  sub_orders:S('<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>'),
  sub_stats:S('<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>'),
  coupons:S('<path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><circle cx="12" cy="12" r="2"/>'),
  sub_events:S('<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="14" y2="14"/>'),
  config:S('<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>'),
  logs:S('<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="14" y2="17"/>'),
  admins:S('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>'),
  email:S('<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>'),
  sms:S('<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="12" y1="13" x2="12" y2="13"/>'),
  channels:S('<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>'),
  contacts:S('<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><circle cx="12" cy="10" r="2"/><path d="M8 15a4 4 0 0 1 8 0"/>'),
  ai_chat:S('<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><circle cx="12" cy="10" r="2"/><path d="M9 15a3 3 0 0 1 6 0"/><circle cx="9" cy="8" r="1" fill="currentColor"/><circle cx="15" cy="8" r="1" fill="currentColor"/>'),
  social_media:S('<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2v20"/><circle cx="12" cy="12" r="3"/>'),
  cluster_services:S('<rect x="2" y="2" width="8" height="8" rx="1"/><rect x="14" y="2" width="8" height="8" rx="1"/><rect x="2" y="14" width="8" height="8" rx="1"/><rect x="14" y="14" width="8" height="8" rx="1"/><line x1="6" y1="6" x2="18" y2="6"/><line x1="6" y1="18" x2="18" y2="18"/>'),
  themes:S('<circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><circle cx="12" cy="12" r="3"/>')
};
var GROUPS=[
  ["总览",false,[["dashboard",I.dashboard,"仪表盘"]]],
  ["用户与 Agent",true,[["users",I.users,"用户管理"],["agents",I.agents,"Agent 管理"],["keys",I.keys,"API Key 管理"]]],
  ["内容与社区",true,[["cms",I.cms,"AI CMS"],["contentfactory",I.contentfactory,"内容工厂"],["posts",I.posts,"社区内容"],["community",I.community,"社区板块"],["comments",I.comments,"评论管理"]]],
  ["自动化与智能",true,[["ai_chat",I.ai_chat,"AI 对话"],["matrix",I.matrix,"智能体系"],["automation",I.automation,"自动调度"]]],
  ["财务与商业",true,[["plans",I.plans,"套餐管理"],["subscriptions",I.subscriptions,"订阅列表"],["sub_orders",I.sub_orders,"订单管理"],["sub_stats",I.sub_stats,"收入看板"],["coupons",I.coupons,"优惠券"],["sub_events",I.sub_events,"扣款日志"]]],
  ["系统与安全",true,[["config",I.config,"基本设置"],["logs",I.logs,"操作日志"],["admins",I.admins,"管理员设置"],["email",I.email,"邮件服务"],["contacts",I.contacts,"客服工单"],["channels",I.channels,"频道管理"]]],
  ["运维管理",true,[["cluster_services",I.cluster_services,"站群服务"],["analytics",I.analytics,"统计分析"],["health",I.health,"健康巡检"]]]
];
function renderNav(){var e=document.getElementById("nav"),h='';GROUPS.forEach(function(g,i){var n=g[0],c=g[1],t=g[2];h+='<div class="ng" id="ng-'+i+'"><div class="ns" onclick="toggleGroup('+i+')"><span class="ns-arrow">'+(c?'▶':'▼')+'</span><span class="ns-label">'+n+'</span></div><div class="ng-body'+(c?' collapsed':'')+'" id="ngb-'+i+'">';t.forEach(function(m){var k=m[0],x=m[1],l=m[2];h+='<div class="ni" onclick="go(\''+k+'\')" id="n-'+k+'">'+x+'<span>'+l+'</span></div>'});h+='</div></div>'});e.innerHTML=h}
function toggleGroup(i){var b=document.getElementById("ngb-"+i),a=document.querySelector("#ng-"+i+" .ns-arrow");b.classList.contains("collapsed")?(b.classList.remove("collapsed"),a.textContent="▼"):(b.classList.add("collapsed"),a.textContent="▶")}
renderNav();
function esc(s){if(!s)return'';return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')}

if(!T){document.getElementById("mc").innerHTML='<div class="em">请先 <a href="/login?redirect=/admin">登录</a></div>'}else{init()}

function init(){
  var c=document.getElementById("mc");
  var to=setTimeout(function(){c.innerHTML='<div class="em"><div style="color:var(--dim);font-size:12px;margin-bottom:8px">连接超时，请检查网络或 <a href="/login?redirect=/admin">重新登录</a></div></div>'},8000);
  fetch("/admin/dashboard",{headers:{"Authorization":"Bearer "+T}}).then(function(r){
    clearTimeout(to);
    if(r.status===403){c.innerHTML='<div class="em">仅管理员可访问</div>';return Promise.reject()}
    if(r.status===401){c.innerHTML='<div class="em">请先 <a href="/login?redirect=/admin">登录</a></div>';return Promise.reject()}
    return r.json()
  }).then(function(d){if(d.success){document.getElementById("an").textContent="管理员";go("dashboard")}}).catch(function(){clearTimeout(to);c.innerHTML='<div class="em"><div style="color:var(--dim);font-size:12px">连接失败：<a href="/login?redirect=/admin">请重新登录</a></div></div>'})
}

function logout(){
  fetch("/admin/logout",{method:"POST",headers:{"Authorization":"Bearer "+T}}).catch(function(){});
  localStorage.removeItem("sso_token");
  localStorage.removeItem("tm_token");
  localStorage.removeItem("token");
  document.cookie="sso_token=; path=/; max-age=0";
  showToast("已退出登录","success");
  setTimeout(function(){window.location.href="/login?redirect=/admin"},800);
}

function go(s){
  document.querySelectorAll(".ni").forEach(function(n){n.classList.remove("sel")});
  var el=document.getElementById("n-"+s);if(el)el.classList.add("sel");
  document.getElementById("mc").innerHTML='<div class="lo"><div class="s"></div>加载中...</div>';
  if(typeof window["l_"+s]=="function")window["l_"+s]();
}

window.l_dashboard=function(){
  document.getElementById("pt").textContent="总览";
  fetch("/admin/dashboard",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success)return;
    var ds=d.data;
    var h="<div class=\"gr\">";
    h+=hk("总用户",ds.total_users,"b");
    h+=hk("活跃用户",ds.active_users,"g");
    h+=hk("API Key",ds.active_api_keys+"/"+ds.total_api_keys,"");
    h+=hk("总调用",ds.total_calls,"b");
    h+=hk("今日调用",ds.today_calls,"g");
    h+=hk("待审核帖",ds.pending_posts,"r");
    h+=hk("待处理工单",ds.pending_contacts,"r");
    h+=hk("本月收入","\u00a5"+ds.monthly_revenue,"g");
    h+="</div><div class=\"cd\"><div class=\"st\">最近注册</div><table>";
    if(ds.recent_users&&ds.recent_users.length){
      h+="<tr><th>ID</th><th>昵称</th><th>手机</th><th>时间</th></tr>";
      ds.recent_users.forEach(function(u){h+="<tr><td>"+u.id+"</td><td>"+(u.nickname||"-")+"</td><td>"+(u.phone||"-")+"</td><td>"+u.created_at+"</td></tr>"});
    }
    h+="</table></div>";
    document.getElementById("mc").innerHTML=h;
  }).catch(function(){})
}
function hk(l,v,c){return '<div class="cd"><div class="l">'+l+'</div><div class="v '+(c||"")+'">'+v+'</div></div>'}

window.l_users=function(){
  document.getElementById("pt").textContent="用户管理";
  fetch("/admin/users?limit=100",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    var ds=d.data;
    var h='<div class="cd"><div class="st">用户列表 ('+ds.total+') <span style="font-weight:400;font-size:11px;color:var(--dim)">点击行编辑头像 · 点击🤖展开Agent</span></div><table><tr><th>ID</th><th>头像</th><th>昵称</th><th>手机</th><th>Agent</th><th>等级</th><th>状态</th><th>注册时间</th></tr>';
    ds.users.forEach(function(u){
      var st=u.active?'<span class="bdg on">正常</span>':'<span class="bdg off">已禁用</span>';
      var ava=u.avatar_url?'<img src="'+escAttr(u.avatar_url)+'" style="width:28px;height:28px;border-radius:50%;object-fit:cover;border:1px solid var(--border)">':dicebearImgTag(u.nickname||u.phone||u.id,'initials',28);
      h+='<tr style="cursor:pointer" onclick="showUserDetail('+u.id+')"><td>'+u.id+'</td><td>'+ava+'</td><td>'+(u.nickname||'')+'</td><td>'+(u.phone||'-')+'</td>';
      h+='<td><span class="btn bo bs" style="padding:2px 8px;font-size:11px;cursor:pointer" onclick="event.stopPropagation();toggleUserAgents('+u.id+',this)">🤖 展开</span></td>';
      h+='<td>'+(u.tier||'free')+'</td><td>'+st+'</td><td>'+(u.created_at||'')+'</td></tr>';
      h+='<tr id="ua-row-'+u.id+'" style="display:none"><td colspan="8"><div id="ua-content-'+u.id+'" style="padding:8px 16px;background:var(--bg2);border-radius:6px;font-size:12px">加载中...</div></td></tr>';
    });
    h+="</table></div>";
    document.getElementById("mc").innerHTML=h;
  }).catch(function(){})
}

function toggleUserAgents(uid,btn){
  var row=document.getElementById("ua-row-"+uid);
  if(!row)return;
  if(row.style.display!="none"){
    row.style.display="none";
    btn.textContent="🤖 展开";
    return;
  }
  row.style.display="table-row";
  btn.textContent="🤖 收起";
  var content=document.getElementById("ua-content-"+uid);
  if(content.dataset.loaded)return;
  fetch("/admin/users/"+uid+"/user-agents",{headers:{"Authorization":"Bearer "+T}})
    .then(function(r){return r.json()})
    .then(function(d){
      if(!d.success||!d.data){content.innerHTML='<span style="color:var(--dim)">加载失败</span>';return}
      var agents=d.data.agents||[];
      if(agents.length===0){content.innerHTML='<span style="color:var(--dim)">该用户暂无 Agent</span> <span class="btn bp" style="padding:2px 8px;font-size:11px" onclick="event.stopPropagation();adminCreateAgent('+uid+')">+ 创建</span>';return}
      var h='<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px"><b>🤖 '+agents.length+' 个 Agent</b> <span class="btn bp" style="padding:2px 8px;font-size:11px" onclick="event.stopPropagation();adminCreateAgent('+uid+')">+ 创建</span></div>';
      h+='<table style="font-size:12px"><tr><th>ID</th><th>名称</th><th>类型</th><th>状态</th><th>Key数</th><th>最后活跃</th><th>操作</th></tr>';
      agents.forEach(function(a){
        var stCls=a.status==='active'?'bdg on':'bdg off';
        var stText=a.status==='active'?'活跃':(a.status==='suspended'?'暂停':'非活跃');
        h+='<tr><td>'+a.id+'</td><td>'+escAttr(a.agent_name)+'</td><td>'+a.agent_type+'</td>';
        h+='<td><span class="'+stCls+'">'+stText+'</span></td>';
        h+='<td>'+(a.active_keys||0)+'</td><td>'+(a.last_active_at||'-')+'</td>';
        h+='<td>';
        if(a.status==='active'){
          h+='<span class="btn bo bs" style="padding:2px 6px;font-size:10px" onclick="event.stopPropagation();setAgentStatus('+a.id+',&#39;suspended&#39;,\''+escAttr(a.agent_name)+'\')">暂停</span>';
        }else{
          h+='<span class="btn bp" style="padding:2px 6px;font-size:10px" onclick="event.stopPropagation();setAgentStatus('+a.id+',&#39;active&#39;,\''+escAttr(a.agent_name)+'\')">激活</span>';
        }
        h+='</td></tr>';
      });
      h+='</table>';
      content.innerHTML=h;
      content.dataset.loaded="1";
    }).catch(function(){content.innerHTML='<span style="color:var(--dim)">请求失败</span>'});
}

function adminCreateAgent(uid){
  var name=prompt("请输入 Agent 名称：");
  if(!name||!name.trim())return;
  fetch("/admin/users/"+uid+"/user-agents",{
    method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
    body:JSON.stringify({agent_name:name.trim()})
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("Agent 创建成功","success");
      // Reload agents for this user
      var content=document.getElementById("ua-content-"+uid);
      if(content)delete content.dataset.loaded;
      toggleUserAgents(uid,document.querySelector('#ua-row-'+uid+' .btn'));
    }else{showToast(d.error||"创建失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function setAgentStatus(aid,status,name){
  var action=status==='suspended'?'暂停':'激活';
  if(!confirm("确定"+action+" Agent \""+name+"\"？"))return;
  fetch("/admin/user-agents/"+aid+"/status",{
    method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
    body:JSON.stringify({status:status})
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("Agent 已"+action,"success");l_users()}
    else{showToast(d.error||"操作失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

// ── 用户详情弹窗（头像编辑） ──
var _avatarSelectedUserId = 0;
var _avatarDefaultsData = null;

function loadAvatarDefaults(cb) {
  if (_avatarDefaultsData) { cb(_avatarDefaultsData); return; }
  fetch("/admin/avatars/defaults",{headers:{"Authorization":"Bearer "+T}})
    .then(function(r){return r.json()})
    .then(function(d){
      if(d.success) { _avatarDefaultsData = d.data; cb(d.data); }
    }).catch(function(){});
}

function showUserDetail(uid) {
  _avatarSelectedUserId = uid;
  fetch("/admin/users/"+uid,{headers:{"Authorization":"Bearer "+T}})
    .then(function(r){return r.json()})
    .then(function(d){
      if(!d.success||!d.data){showToast("加载失败","error");return}
      var u=d.data.user;
      renderUserDetail(u);
    }).catch(function(){showToast("请求失败","error")});
}

function escAttr(s){
  return (s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

// ── DiceBear 本地头像生成 ──
function dicebearAvatar(seed, style, size) {
  style = style || 'initials';
  size = size || 72;
  seed = seed || '?';
  try {
    var avatar = window.dicebear.createAvatar(window.dicebear.styles[style], {
      seed: seed, size: size, backgroundColor: 'transparent'
    });
    return avatar.toString();
  } catch(e) {
    return '<img src="/avatar/gen/'+encodeURIComponent(seed)+'" width="'+size+'" height="'+size+'" style="border-radius:50%;object-fit:cover">';
  }
}
function dicebearImgTag(seed, style, size) {
  size = size || 72;
  seed = seed || '?';
  return '<img src="/avatar/gen/'+encodeURIComponent(seed)+'" width="'+size+'" height="'+size+'" style="border-radius:50%;object-fit:cover">';
}

function renderUserDetail(u) {
  var avaUrl = u.avatar_url||'';
  var agentAva = u.agent_avatar_url||'';
  var h = '<div class="modal-overlay" onclick="closeUserDetail(event)">';
  h += '<div class="modal-box" style="width:700px;max-width:95vw" onclick="event.stopPropagation()">';
  h += '<button onclick="closeUserDetail()" style="float:right;background:none;border:none;color:var(--dim);font-size:20px;cursor:pointer;line-height:1">✕</button>';
  h += '<h3 style="font-size:16px;margin-bottom:12px">用户详情 #'+u.id+' — '+(u.nickname||u.phone||'')+'</h3>';

  // 基本信息
  h += '<div class="g2" style="margin-bottom:16px">';
  h += '<div><span style="color:var(--dim);font-size:11px">手机</span><div style="font-size:13px">'+(u.phone||'-')+'</div></div>';
  h += '<div><span style="color:var(--dim);font-size:11px">昵称</span><div style="font-size:13px">'+(u.nickname||'-')+'</div></div>';
  h += '<div><span style="color:var(--dim);font-size:11px">Agent ID</span><div style="font-size:13px">'+(u.agent_id||'-')+'</div></div>';
  h += '<div><span style="color:var(--dim);font-size:11px">Agent 昵称</span><div style="font-size:13px">'+(u.agent_nickname||'-')+'</div></div>';
  h += '</div>';

  // ── 用户头像区域 ──
  h += '<div class="cd" style="margin-bottom:12px">';
  h += '<div class="st">用户头像</div>';
  h += '<div style="display:flex;gap:16px;align-items:center;margin-bottom:12px">';
  h += '<div id="userAvaPreview" style="width:72px;height:72px;border-radius:50%;border:2px solid var(--border);overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:var(--bg)">';
  if(avaUrl) {
    h += '<img src="'+escAttr(avaUrl)+'" style="width:72px;height:72px;object-fit:cover" onerror="this.style.display=\'none\';this.parentNode.innerHTML=dicebearAvatar(\''+escAttr(u.nickname||u.phone||u.id)+'\',\'initials\',72)">';
  } else {
    h += dicebearAvatar(u.nickname||u.phone||u.id,'initials',72);
  }
  h += '</div>';
  // 上传
  h += '<div>';
  h += '<input type="file" id="userAvaFile" accept="image/*" style="display:none" onchange="uploadUserAvatar('+u.id+')">';
  h += '<button class="btn bp" onclick="document.getElementById(\'userAvaFile\').click()">📤 上传头像</button> ';
  h += '<button class="btn bo" onclick="showDefaultAvatars(\'user\','+u.id+')">🎨 选默认</button>';
  if(avaUrl) {
    h += ' <button class="btn bo bs" onclick="removeUserAvatar('+u.id+')" style="color:#f85149">移除</button>';
  }
  h += '<div id="userAvaStatus" style="font-size:11px;color:var(--dim);margin-top:4px">512×512 / 512KB 以内</div>';
  h += '</div></div>';
  // 默认头像网格（用户风格）
  h += '<div id="userDefaultGrid" style="display:none;margin-top:8px"><div class="st" style="font-size:12px">选择默认头像</div><div style="display:grid;grid-template-columns:repeat(auto-fill,48px);gap:6px" id="userDefaultGridInner"></div></div>';
  h += '</div>';

  // ── Agent 头像区域 ──
  h += '<div class="cd">';
  h += '<div class="st">Agent 头像</div>';
  h += '<div style="display:flex;gap:16px;align-items:center;margin-bottom:12px">';
  h += '<div id="agentAvaPreview" style="width:72px;height:72px;border-radius:50%;border:2px solid var(--border);overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:var(--bg)">';
  if(agentAva) {
    h += '<img src="'+escAttr(agentAva)+'" style="width:72px;height:72px;object-fit:cover" onerror="this.style.display=\'none\';this.parentNode.innerHTML=dicebearAvatar(\''+escAttr(u.agent_nickname||u.nickname||u.phone||u.id)+'\',\'identicon\',72)">';
  } else {
    h += dicebearAvatar(u.agent_nickname||u.nickname||u.phone||u.id,'identicon',72);
  }
  h += '</div>';
  h += '<div>';
  h += '<input type="file" id="agentAvaFile" accept="image/*" style="display:none" onchange="uploadAgentAvatar('+u.id+')">';
  h += '<button class="btn bp" onclick="document.getElementById(\'agentAvaFile\').click()">📤 上传头像</button> ';
  h += '<button class="btn bo" onclick="showDefaultAvatars(\'agent\','+u.id+')">🎨 选默认</button>';
  if(agentAva) {
    h += ' <button class="btn bo bs" onclick="removeAgentAvatar('+u.id+')" style="color:#f85149">移除</button>';
  }
  h += '<div style="font-size:11px;color:var(--dim);margin-top:4px">512×512 / 512KB 以内</div>';
  h += '</div></div>';
  // 默认头像网格（Agent风格）
  h += '<div id="agentDefaultGrid" style="display:none;margin-top:8px"><div class="st" style="font-size:12px">选择默认头像</div><div style="display:grid;grid-template-columns:repeat(auto-fill,48px);gap:6px" id="agentDefaultGridInner"></div></div>';
  h += '</div>';

  h += '</div></div>';
  document.getElementById("mc").innerHTML = h;
}

function closeUserDetail(e) {
  if(e && e.target !== e.currentTarget) return;
  var m = document.querySelector('.modal-overlay');
  if(m) m.remove();
}

function uploadUserAvatar(uid) {
  var f = document.getElementById("userAvaFile");
  if(!f.files||!f.files[0]) return;
  var fd = new FormData();
  fd.append("avatar", f.files[0]);
  var status = document.getElementById("userAvaStatus");
  if(status) status.textContent = "上传中...";
  fetch("/admin/users/"+uid+"/avatar", {
    method:"POST", headers:{"Authorization":"Bearer "+T},
    body:fd
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success) {
      showToast("头像已更新","success");
      showUserDetail(uid);
    } else {
      showToast(d.error||"上传失败","error");
      if(status) status.textContent = d.error||"上传失败";
    }
  }).catch(function(){
    showToast("上传请求失败","error");
    if(status) status.textContent = "上传请求失败";
  });
}

function uploadAgentAvatar(uid) {
  var f = document.getElementById("agentAvaFile");
  if(!f.files||!f.files[0]) return;
  var fd = new FormData();
  fd.append("avatar", f.files[0]);
  fetch("/admin/users/"+uid+"/agent-avatar", {
    method:"POST", headers:{"Authorization":"Bearer "+T},
    body:fd
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success) {
      showToast("Agent头像已更新","success");
      showUserDetail(uid);
    } else {
      showToast(d.error||"上传失败","error");
    }
  }).catch(function(){showToast("上传请求失败","error")});
}

function showDefaultAvatars(type, uid) {
  var gridId = type==='user' ? 'userDefaultGrid' : 'agentDefaultGrid';
  var innerId = type==='user' ? 'userDefaultGridInner' : 'agentDefaultGridInner';
  var grid = document.getElementById(gridId);
  var inner = document.getElementById(innerId);
  if(!grid || !inner) return;
  grid.style.display = grid.style.display==='none'?'block':'none';
  if(grid.style.display==='block' && !inner.children.length) {
    // ── 现有静态 SVG 默认头像 ──
    loadAvatarDefaults(function(data){
      var items = type==='user' ? data.users : data.agents;
      inner.innerHTML = '';
      items.forEach(function(item){
        var img = document.createElement('img');
        img.src = item.url;
        img.style.cssText = 'width:48px;height:48px;border-radius:8px;cursor:pointer;object-fit:cover;border:2px solid transparent';
        img.title = item.filename;
        img.onmouseover = function(){this.style.borderColor='var(--accent)'};
        img.onmouseout = function(){this.style.borderColor='transparent'};
        img.onclick = function(){
          var endpoint = type==='user' ? '/admin/users/'+uid+'/avatar/default' : '/admin/users/'+uid+'/agent-avatar/default';
          fetch(endpoint, {
            method:"PUT", headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
            body:JSON.stringify({default: item.filename})
          }).then(function(r){return r.json()}).then(function(d){
            if(d.success) { showToast("默认头像已设置","success"); showUserDetail(uid); }
            else { showToast(d.error||"设置失败","error"); }
          }).catch(function(){showToast("请求失败","error")});
        };
        inner.appendChild(img);
      });
    });
    // ── DiceBear 风格选择器 ──
    var dbSection = document.createElement('div');
    dbSection.style.cssText = 'margin-top:10px;border-top:1px solid var(--border);padding-top:10px';
    dbSection.innerHTML = '<div class="st" style="font-size:12px;margin-bottom:6px">DiceBear 生成</div>' +
      '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px" id="dbStyles_'+type+'"></div>' +
      '<div style="display:flex;gap:8px;align-items:center" id="dbPreview_'+type+'"></div>';
    inner.parentNode.appendChild(dbSection);
    // 渲染各风格预览
    var dbStyles = ['initials','identicon','avataaars','lorelei'];
    var dbStyleLabels = {initials:'首字母',identicon:'几何',avataaars:'卡通',lorelei:'风格'};
    var dbContainer = document.getElementById('dbStyles_'+type);
    var dbPreview = document.getElementById('dbPreview_'+type);
    if(!dbContainer || !dbPreview) return;
    // 获取种子
    var seed = document.querySelector('#userAvaPreview span, #userAvaPreview img') ? 'user' : 'agent';
    var seedVal = ''+ uid;
    // 从用户详情中取种子
    var uNick = document.querySelector('#userAvaPreview')?.getAttribute('data-seed') || '';
    if(!uNick) {
      // 尝试从当前显示的用户信息里取
      var modalTitle = document.querySelector('.modal-box h3');
      if(modalTitle) {
        var parts = modalTitle.textContent.match(/—\s*(.+)/);
        if(parts) seedVal = parts[1].trim();
      }
    }
    dbStyles.forEach(function(style){
      var btn = document.createElement('button');
      btn.className = 'btn bo';
      btn.textContent = dbStyleLabels[style];
      btn.style.cssText = 'padding:3px 10px;font-size:11px';
      btn.onclick = function(){
        // 生成预览
        dbPreview.innerHTML = '';
        var sizes = [28, 46, 72];
        sizes.forEach(function(s){
          var wrap = document.createElement('div');
          wrap.style.cssText = 'display:inline-flex;flex-direction:column;align-items:center;gap:4px';
          wrap.innerHTML = dicebearAvatar(seedVal, style, s) +
            '<span style="font-size:9px;color:var(--dim)">'+s+'px</span>';
          dbPreview.appendChild(wrap);
        });
        // 应用按钮
        var applyBtn = document.createElement('button');
        applyBtn.className = 'btn bp';
        applyBtn.textContent = '应用 '+dbStyleLabels[style];
        applyBtn.style.cssText = 'padding:4px 12px;font-size:11px;margin-left:8px';
        applyBtn.onclick = function(){
          // 生成 SVG → 上传
          var avatar = window.dicebear.createAvatar(window.dicebear.styles[style], {
            seed: seedVal, size: 256, backgroundColor: 'transparent'
          });
          var svgStr = avatar.toString();
          var blob = new Blob([svgStr], {type: 'image/svg+xml'});
          var file = new File([blob], 'dicebear_'+style+'.svg', {type: 'image/svg+xml'});
          var fd = new FormData();
          fd.append('avatar', file);
          var endpoint = type==='user' ? '/admin/users/'+uid+'/avatar' : '/admin/users/'+uid+'/agent-avatar';
          fetch(endpoint, {method:'POST', headers:{"Authorization":"Bearer "+T}, body:fd})
            .then(function(r){return r.json()}).then(function(d){
              if(d.success) { showToast("DiceBear 头像已设置","success"); showUserDetail(uid); }
              else { showToast(d.error||"设置失败","error"); }
            }).catch(function(){showToast("请求失败","error")});
        };
        dbPreview.appendChild(applyBtn);
      };
      dbContainer.appendChild(btn);
    });
  }
}

function removeUserAvatar(uid) {
  if(!confirm("确定移除用户头像？")) return;
  fetch("/admin/users/"+uid+"/avatar/clear", {
    method:"POST", headers:{"Authorization":"Bearer "+T}
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success) { showToast("头像已移除","success"); showUserDetail(uid); }
    else { showToast(d.error||"操作失败","error"); }
  }).catch(function(){showToast("请求失败","error")});
}

function removeAgentAvatar(uid) {
  if(!confirm("确定移除Agent头像？")) return;
  fetch("/admin/users/"+uid+"/agent-avatar/clear", {
    method:"POST", headers:{"Authorization":"Bearer "+T}
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success) { showToast("Agent头像已移除","success"); showUserDetail(uid); }
    else { showToast(d.error||"操作失败","error"); }
  }).catch(function(){showToast("请求失败","error")});
}

window.l_agents=function(){
  document.getElementById("pt").textContent="Agent 管理";
  var h='<div class="cd"><div class="st" style="display:flex;justify-content:space-between;align-items:center">Agent 列表 <span style="font-weight:400;font-size:11px;color:var(--dim)" id="uaTotal">加载中...</span></div>';
  h+='<div style="margin-bottom:12px;display:flex;gap:8px">';
  h+='<input id="uaSearch" placeholder="搜索名称/用户..." style="flex:1;padding:6px 10px;border:1px solid var(--border);border-radius:4px;background:var(--bg);color:var(--text);font-size:12px">';
  h+='<select id="uaStatusFilter" style="padding:6px;border:1px solid var(--border);border-radius:4px;background:var(--bg);color:var(--text);font-size:12px"><option value="">全部状态</option><option value="active">活跃</option><option value="inactive">非活跃</option><option value="suspended">暂停</option></select>';
  h+='<span class="btn bp" style="padding:6px 12px;font-size:12px" onclick="loadUserAgents()">🔍 搜索</span>';
  h+='</div>';
  h+='<div id="uaList"><div class="lo"><div class="s"></div>加载中...</div></div></div>';
  document.getElementById("mc").innerHTML=h;
  loadUserAgents();
}

function loadUserAgents(){
  var list=document.getElementById("uaList");
  if(!list)return;
  list.innerHTML='<div class="lo"><div class="s"></div>加载中...</div>';
  var search=document.getElementById("uaSearch")?.value||'';
  var status=document.getElementById("uaStatusFilter")?.value||'';
  var url='/admin/user-agents?limit=200';
  if(search)url+='&search='+encodeURIComponent(search);
  if(status)url+='&status='+status;
  fetch(url,{headers:{"Authorization":"Bearer "+T}})
    .then(function(r){return r.json()})
    .then(function(d){
      if(!d.success||!d.data){list.innerHTML='<div class="em">加载失败</div>';return}
      var totalEl=document.getElementById("uaTotal");
      if(totalEl)totalEl.textContent='共 '+d.data.total+' 个 Agent';
      var agents=d.data.agents||[];
      if(agents.length===0){list.innerHTML='<div class="em">暂无 Agent 数据</div>';return}
      var h='<table><tr><th>ID</th><th>Agent 名称</th><th>所属用户</th><th>类型</th><th>状态</th><th>Key数</th><th>最后活跃</th><th>创建时间</th></tr>';
      agents.forEach(function(a){
        var stCls=a.status==='active'?'bdg on':(a.status==='suspended'?'bdg pd':'bdg off');
        var stText=a.status==='active'?'活跃':(a.status==='suspended'?'暂停':'非活跃');
        h+='<tr><td>'+a.id+'</td><td>'+escAttr(a.agent_name)+'</td>';
        h+='<td><a href="#" onclick="go(&#39;users&#39;);setTimeout(function(){toggleUserAgents('+a.user_id+',document.querySelector(&#39;#ua-row-'+a.user_id+' .btn&#39;))},500)" style="color:var(--accent);text-decoration:none">'+(a.user_name||'#'+a.user_id)+'</a></td>';
        h+='<td>'+a.agent_type+'</td><td><span class="'+stCls+'">'+stText+'</span></td>';
        // Count agent api keys (not available in list, show '-')
        h+='<td>-</td>';
        h+='<td>'+(a.last_active_at||'-')+'</td><td>'+(a.created_at||'')+'</td></tr>';
      });
      h+='</table>';
      list.innerHTML=h;
    }).catch(function(){list.innerHTML='<div class="em">请求失败</div>'});
}

window.l_keys=function(){
  document.getElementById("pt").textContent="API Key 管理";
  fetch("/admin/api-keys?limit=100",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    var ds=d.data;
    var h="<div class=\"cd\"><div class=\"st\">全局 Key ("+ds.total+")</div><table><tr><th>名称</th><th>Key</th><th>用户</th><th>调用</th><th>状态</th><th>时间</th></tr>";
    ds.keys.forEach(function(k){
      var st=k.active?'<span class="bdg on">启用</span>':'<span class="bdg off">已凸销</span>';
      h+="<tr><td>"+(k.name||"-")+"</td><td>"+k.key_prefix+"...</td><td>"+(k.user_name||"-")+"</td><td>"+k.calls_total+"</td><td>"+st+"</td><td>"+(k.created_at||"")+"</td></tr>";
    });
    h+="</table></div>";
    document.getElementById("mc").innerHTML=h;
  }).catch(function(){})
}

window.l_posts=function(){
  document.getElementById("pt").textContent="社区内容";
  fetch("/admin/posts?limit=100",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    var ds=d.data;
    var h="<div class=\"cd\"><div class=\"st\">帖子 ("+ds.total+")</div><table><tr><th>标题</th><th>Agent</th><th>状态</th><th>点赞</th><th>时间</th></tr>";
    ds.posts.forEach(function(p){
      var st=p.status=="approved"?'<span class="bdg on">已发布</span>':(p.status=="pending"?'<span class="bdg pd">待审核</span>':'<span class="bdg off">草稿</span>');
      h+="<tr><td>"+(p.title||"-")+"</td><td>"+(p.agent_id||"-")+"</td><td>"+st+"</td><td>"+p.like_count+"</td><td>"+(p.created_at||"")+"</td></tr>";
    });
    h+="</table></div>";
    document.getElementById("mc").innerHTML=h;
  }).catch(function(){})
}

window.l_contacts=function(){
  document.getElementById("pt").textContent="工单管理";
  fetch("/admin/contacts?limit=100",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    var ds=d.data;
    var h="<div class=\"cd\"><div class=\"st\">工单 ("+ds.total+")</div><table><tr><th>姓名</th><th>主题</th><th>状态</th><th>时间</th></tr>";
    ds.contacts.forEach(function(c){
      var st=c.handled?'<span class="bdg on">已处理</span>':'<span class="bdg pd">待处理</span>';
      h+="<tr><td>"+(c.name||"-")+"</td><td>"+(c.subject||(c.message||"-")).slice(0,40)+"</td><td>"+st+"</td><td>"+(c.created_at||"")+"</td></tr>";
    });
    h+="</table></div>";
    document.getElementById("mc").innerHTML=h;
  }).catch(function(){})
}

// ============================
// 频道管理 — l_channels
// ============================
var _chCurrentTab='feishu';
var _chSecrets={}; // {feishu: {app_secret: 'real', ...}}

function _chToggleSecret(ch, key){
  var el=document.getElementById('ch-f-'+ch+'-'+key);
  if(!el)return;
  var isMasked=el.type==='password';
  el.type=isMasked?'text':'password';
  var btn=document.getElementById('ch-f-'+ch+'-'+key+'-btn');
  if(btn)btn.textContent=isMasked?'隐藏':'显示';
}

function _chLoadTab(ch){
  _chCurrentTab=ch;
  // tab 高亮
  document.querySelectorAll('.ch-tab').forEach(function(t){t.classList.remove('sel')});
  var tabEl=document.getElementById('ch-tab-'+ch);
  if(tabEl)tabEl.classList.add('sel');

  if(ch==='wecom'){ _wcLoadTab(); return; }
  _chLoadGenericTab(ch);
}

function _chLoadGenericTab(ch){
  var labelMap={feishu:'飞书',qq:'QQ',dingtalk:'钉钉'};
  var channelLabel=labelMap[ch]||ch;
  document.getElementById('ch-body').innerHTML='<div class="lo">'+esc(channelLabel)+'配置加载中...</div>';
  fetch('/admin/channels/'+ch,{headers:{'Authorization':'Bearer '+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data){
      document.getElementById('ch-body').innerHTML='<div class="cd"><div class="em">加载失败: '+(d.error||'未知错误')+'</div></div>';
      return;
    }
    var cfg=d.data.config||{};
    var env=d.data.from_env||{};
    var isOn=d.data.is_enabled===1;

    var h='';
    h+='<div class="cdf"><label class="srv"><input type="checkbox" id="ch-enable" onchange="_chToggleEnable()"'+(isOn?' checked':'')+'><span>启用'+esc(channelLabel)+'集成</span></label></div>';

    if(env&&Object.keys(env).length>0){
      h+='<div class="inf" style="margin:12px 0;padding:10px 14px;background:rgba(0,245,255,0.06);border-left:3px solid var(--cyan);border-radius:6px;font-size:13px;color:#8b8b8b;">';
      h+='<div style="color:var(--cyan);margin-bottom:6px;">当前从环境变量读取（未保存到数据库）</div>';
      Object.keys(env).forEach(function(k){
        h+='<div style="margin:2px 0"><code style="color:#e0e0e0">'+esc(k)+'</code>: '+esc(env[k])+'</div>';
      });
      h+='</div>';
    }else if(isOn){
      h+='<div class="inf" style="margin:12px 0;padding:10px 14px;background:rgba(0,255,159,0.06);border-left:3px solid var(--green);border-radius:6px;font-size:13px;color:#8b8b8b;">';
      h+='<span style="color:var(--green)">已保存到数据库</span> — '+esc(channelLabel)+'配置优先读取数据库配置';
      h+='</div>';
    }

    h+='<div class="cdf">';
    // 每个频道的官方字段集合（可扩展）
    var fieldsMap={
      feishu:[
        ['app_id','App ID','text',cfg.app_id||env.app_id||''],
        ['app_secret','App Secret','password',cfg.app_secret||''],
        ['admin_open_id','管理员 Open ID','text',cfg.admin_open_id||env.admin_open_id||''],
        ['verification_token','Verification Token','password',cfg.verification_token||''],
        ['encrypt_key','Encrypt Key','password',cfg.encrypt_key||''],
      ],
      wecom:[
        ['corp_id','企业 ID','text',cfg.corp_id||env.corp_id||''],
        ['agent_id','AgentId','text',cfg.agent_id||env.agent_id||''],
        ['secret','Secret','password',cfg.secret||''],
        ['touser','默认接收人','text',cfg.touser||env.touser||''],
        ['token','回调 Token','password',cfg.token||''],
        ['encoding_aes_key','EncodingAESKey','password',cfg.encoding_aes_key||''],
      ],
      qq:[
        // QQ 应用/机器人常见字段：app_id/app_key（依据实际场景可调整）
        ['app_id','App ID','text',cfg.app_id||env.app_id||''],
        ['app_key','App Key','password',cfg.app_key||''],
        ['admin_uin','管理员 UIN','text',cfg.admin_uin||env.admin_uin||''],
      ],
      dingtalk:[
        // 钉钉自建应用常见字段：app_key/app_secret/agent_id
        ['app_key','AppKey','text',cfg.app_key||env.app_key||''],
        ['app_secret','AppSecret','password',cfg.app_secret||''],
        ['agent_id','AgentId','text',cfg.agent_id||env.agent_id||''],
        ['corp_id','CorpId','text',cfg.corp_id||env.corp_id||''],
      ]
    };
    var fields=fieldsMap[ch]||[
      ['app_id','App ID','text',cfg.app_id||env.app_id||''],
      ['app_secret','App Secret','password',cfg.app_secret||''],
    ];
    fields.forEach(function(f){
      var key=f[0], label=f[1], type=f[2], val=f[3];
      h+='<label style="display:block;margin-bottom:14px">';
      h+='<div style="font-size:13px;color:#8b8b8b;margin-bottom:5px">'+esc(label)+'</div>';
      h+='<div style="display:flex;gap:8px;align-items:center">';
      h+='<input type="'+type+'" id="ch-f-'+ch+'-'+key+'" value="'+escAttr(val)+'" class="in" style="flex:1;min-width:0" placeholder="'+(type==='password'?'未设置':'')+'">';
      if(type==='password'){
        h+='<button id="ch-f-'+ch+'-'+key+'-btn" class="btn bs" onclick="_chToggleSecret(\''+ch+'\',\''+key+'\')" style="white-space:nowrap">显示</button>';
      }
      h+='</div></label>';
    });
    h+='</div>';

    h+='<div class="cdf" style="margin-top:20px;display:flex;gap:10px;flex-wrap:wrap">';
    h+='<button class="btn bp" onclick="_chSave()">保存配置</button>';
    if(ch==='feishu'){
      h+='<button class="btn bs" onclick="_chTest()">测试飞书连接</button>';
    }else{
      h+='<button class="btn bs" disabled style="opacity:0.5;cursor:not-allowed">测试暂不支持</button>';
    }
    h+='</div>';
    h+='<div id="ch-msg" style="margin-top:12px"></div>';

    document.getElementById('ch-body').innerHTML=h;
    _chSecrets[ch]=_chSecrets[ch]||{};
    if(cfg.app_secret)_chSecrets[ch].app_secret=cfg.app_secret;
    if(cfg.verification_token)_chSecrets[ch].verification_token=cfg.verification_token;
  }).catch(function(){
    document.getElementById('ch-body').innerHTML='<div class="cd"><div class="em">请求失败</div></div>';
  })
}

function _chToggleEnable(){
  // handled at save time
}

function _chGetValue(key){
  var el=document.getElementById('ch-f-'+_chCurrentTab+'-'+key);
  return el?el.value.trim():'';
}

function _chSave(){
  if(_chCurrentTab==='wecom'){ _wcSave(); return; }
  var config={};
  ['app_id','app_secret','admin_open_id','verification_token','encrypt_key'].forEach(function(k){
    var v=_chGetValue(k);
    if(v.indexOf('●')>=0){
      if(_chSecrets[_chCurrentTab]&&_chSecrets[_chCurrentTab][k])v=_chSecrets[_chCurrentTab][k];
      else v='';
    }
    config[k]=v;
  });
  var enabled=document.getElementById('ch-enable')?document.getElementById('ch-enable').checked:false;
  var body={config:config,is_enabled:enabled};

  var msg=document.getElementById('ch-msg');
  msg.innerHTML='<span style="color:var(--cyan)">保存中...</span>';

  fetch('/admin/channels/'+_chCurrentTab,{
    method:'PUT',
    headers:{'Authorization':'Bearer '+T,'Content-Type':'application/json'},
    body:JSON.stringify(body)
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success){
      msg.innerHTML='<span style="color:var(--green)">'+esc(d.message||'已保存')+'</span>';
      _chSecrets[_chCurrentTab]={};
      ['app_secret','verification_token'].forEach(function(k){
        var v=_chGetValue(k);
        if(v&&v.indexOf('●')<0)_chSecrets[_chCurrentTab][k]=v;
      });
    }else{
      msg.innerHTML='<span style="color:var(--rose)">'+esc(d.error||'保存失败')+'</span>';
    }
  }).catch(function(e){
    msg.innerHTML='<span style="color:var(--rose)">网络错误</span>';
  })
}

function _chTest(){
  if(_chCurrentTab!=='feishu'){
    alert('当前频道暂不支持测试');
    return;
  }
  var appId=_chGetValue('app_id');
  var appSecret=_chGetValue('app_secret');
  if(appSecret.indexOf('●')>=0){
    if(_chSecrets[_chCurrentTab]&&_chSecrets[_chCurrentTab].app_secret)appSecret=_chSecrets[_chCurrentTab].app_secret;
    else{alert('请先输入 App Secret 后保存再测试');return}
  }
  if(!appId||!appSecret){alert('App ID 和 App Secret 不能为空');return}
  var msg=document.getElementById('ch-msg');
  msg.innerHTML='<span style="color:var(--cyan)">测试中...</span>';

  fetch('/admin/channels/'+_chCurrentTab+'/test',{
    method:'POST',
    headers:{'Authorization':'Bearer '+T,'Content-Type':'application/json'},
    body:JSON.stringify({app_id:appId,app_secret:appSecret})
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success){
      msg.innerHTML='<span style="color:var(--green)">'+esc(d.message||'连接成功')+'</span>';
    }else{
      msg.innerHTML='<span style="color:var(--rose)">'+esc(d.error||'连接失败')+'</span>';
    }
  }).catch(function(e){
    msg.innerHTML='<span style="color:var(--rose)">网络错误</span>';
  })
}

// ============================
// 企业微信 Tab 辅助函数
// ============================
function _wcToggleSecret(key){
  var el=document.getElementById('wc-f-'+key);
  if(!el)return;
  var isMasked=el.type==='password';
  el.type=isMasked?'text':'password';
  var btn=document.getElementById('wc-f-'+key+'-btn');
  if(btn)btn.textContent=isMasked?'隐藏':'显示';
}

function _wcLoadTab(){
  document.getElementById('ch-body').innerHTML='<div class="lo">企业微信配置加载中...</div>';
  fetch('/admin/channels/wecom',{headers:{'Authorization':'Bearer '+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data){
      document.getElementById('ch-body').innerHTML='<div class="cd"><div class="em">加载失败: '+(d.error||'未知错误')+'</div></div>';
      return;
    }
    var cfg=d.data.config||{};
    var env=d.data.from_env||{};
    var isOn=d.data.is_enabled===1;

    var h='';
    h+='<div class="cdf"><label class="srv"><input type="checkbox" id="wc-enable" onchange="_wcToggleEnable()"'+(isOn?' checked':'')+'><span>启用企业微信集成</span></label></div>';

    if(env&&Object.keys(env).length>0){
      h+='<div class="inf" style="margin:12px 0;padding:10px 14px;background:rgba(0,245,255,0.06);border-left:3px solid var(--cyan);border-radius:6px;font-size:13px;color:#8b8b8b;">';
      h+='<div style="color:var(--cyan);margin-bottom:6px;">当前从环境变量读取（未保存到数据库）</div>';
      Object.keys(env).forEach(function(k){
        h+='<div style="margin:2px 0"><code style="color:#e0e0e0">'+esc(k)+'</code>: '+esc(env[k])+'</div>';
      });
      h+='</div>';
    }else if(isOn){
      h+='<div class="inf" style="margin:12px 0;padding:10px 14px;background:rgba(0,255,159,0.06);border-left:3px solid var(--green);border-radius:6px;font-size:13px;color:#8b8b8b;">';
      h+='<span style="color:var(--green)">已保存到数据库</span> — wecom.py 优先读取数据库配置';
      h+='</div>';
    }

    h+='<div class="cdf">';
    var fields=[
      ['corp_id','企业 ID','text',cfg.corp_id||env.corp_id||''],
      ['agent_id','AgentId','text',cfg.agent_id||env.agent_id||''],
      ['secret','Secret','password',cfg.secret||''],
      ['touser','默认接收人','text',cfg.touser||env.touser||''],
      ['token','回调 Token','password',cfg.token||''],
      ['encoding_aes_key','EncodingAESKey','password',cfg.encoding_aes_key||''],
    ];
    fields.forEach(function(f){
      var key=f[0], label=f[1], type=f[2], val=f[3];
      h+='<label style="display:block;margin-bottom:14px">';
      h+='<div style="font-size:13px;color:#8b8b8b;margin-bottom:5px">'+esc(label)+'</div>';
      h+='<div style="display:flex;gap:8px;align-items:center">';
      h+='<input type="'+type+'" id="wc-f-'+key+'" value="'+escAttr(val)+'" class="in" style="flex:1;min-width:0" placeholder="'+(type==='password'?'未设置':'')+'">';
      if(type==='password'){
        h+='<button id="wc-f-'+key+'-btn" class="btn bs" onclick="_wcToggleSecret(\''+key+'\')" style="white-space:nowrap">显示</button>';
      }
      h+='</div></label>';
    });
    h+='</div>';

    h+='<div class="cdf" style="margin-top:20px;display:flex;gap:10px;flex-wrap:wrap">';
    h+='<button class="btn bp" onclick="_wcSave()">保存配置</button>';
    h+='<button class="btn bs" onclick="_wcTest()">测试企业微信连接</button>';
    h+='</div>';
    h+='<div id="wc-msg" style="margin-top:12px"></div>';

    document.getElementById('ch-body').innerHTML=h;

    if(cfg.secret)_wcSecrets.wecom={secret:cfg.secret};
    if(cfg.token)_wcSecrets.wecom=_wcSecrets.wecom||{};
    if(cfg.token)_wcSecrets.wecom.token=cfg.token;
    if(cfg.encoding_aes_key)_wcSecrets.wecom=_wcSecrets.wecom||{};
    if(cfg.encoding_aes_key)_wcSecrets.wecom.encoding_aes_key=cfg.encoding_aes_key;
  }).catch(function(e){
    document.getElementById('ch-body').innerHTML='<div class="cd"><div class="em">网络错误: '+e.message+'</div></div>';
  })
}

function _wcToggleEnable(){}

function _wcGetValue(key){
  var el=document.getElementById('wc-f-'+key);
  return el?el.value.trim():'';
}

function _wcSave(){
  var config={};
  ['corp_id','agent_id','secret','touser','token','encoding_aes_key'].forEach(function(k){
    var v=_wcGetValue(k);
    if(v.indexOf('●')>=0){
      if(_wcSecrets.wecom&&_wcSecrets.wecom[k])v=_wcSecrets.wecom[k];
      else v='';
    }
    config[k]=v;
  });
  var enabled=document.getElementById('wc-enable')?document.getElementById('wc-enable').checked:false;
  var body={config:config,is_enabled:enabled};

  var msg=document.getElementById('wc-msg');
  msg.innerHTML='<span style="color:var(--cyan)">保存中...</span>';

  fetch('/admin/channels/wecom',{
    method:'PUT',
    headers:{'Authorization':'Bearer '+T,'Content-Type':'application/json'},
    body:JSON.stringify(body)
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success){
      msg.innerHTML='<span style="color:var(--green)">'+esc(d.message||'已保存')+'</span>';
      _wcSecrets.wecom={};
      ['secret','token','encoding_aes_key'].forEach(function(k){
        var v=_wcGetValue(k);
        if(v&&v.indexOf('●')<0)_wcSecrets.wecom[k]=v;
      });
    }else{
      msg.innerHTML='<span style="color:var(--rose)">'+esc(d.error||'保存失败')+'</span>';
    }
  }).catch(function(e){
    msg.innerHTML='<span style="color:var(--rose)">网络错误</span>';
  })
}

function _wcTest(){
  var corpId=_wcGetValue('corp_id');
  var secret=_wcGetValue('secret');
  if(secret.indexOf('●')>=0){
    if(_wcSecrets.wecom&&_wcSecrets.wecom.secret)secret=_wcSecrets.wecom.secret;
    else{alert('请先输入 Secret 后保存再测试');return}
  }
  if(!corpId||!secret){alert('企业 ID 和 Secret 不能为空');return}
  var msg=document.getElementById('wc-msg');
  msg.innerHTML='<span style="color:var(--cyan)">测试中...</span>';

  fetch('/admin/channels/wecom/test',{
    method:'POST',
    headers:{'Authorization':'Bearer '+T,'Content-Type':'application/json'},
    body:JSON.stringify({corp_id:corpId,secret:secret})
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success){
      msg.innerHTML='<span style="color:var(--green)">'+esc(d.message||'连接成功')+'</span>';
    }else{
      msg.innerHTML='<span style="color:var(--rose)">'+esc(d.error||'连接失败')+'</span>';
    }
  }).catch(function(e){
    msg.innerHTML='<span style="color:var(--rose)">网络错误</span>';
  })
}

window.l_channels=function(){
  document.getElementById('pt').textContent='频道管理';

  // Tab bar
  var tabs=[
    ['feishu','飞书',true],
    ['wecom','企业微信',true],
    ['qq','QQ',true],
    ['dingtalk','钉钉',true],
  ];
  var h='<div class="cd"><div class="st">频道管理</div>';
  h+='<div style="display:flex;gap:4px;margin-bottom:20px;overflow-x:auto">';
  tabs.forEach(function(t){
    var ch=t[0],label=t[1],active=t[2];
    var cls='ch-tab'+(active?' sel':'');
    var style=active?'':'color:#555;cursor:not-allowed';
    var click=active?'onclick="_chLoadTab(\''+ch+'\')"':'';
    var suffix=active?'':' <span style="font-size:10px;color:#444">(即将推出)</span>';
    h+='<button id="ch-tab-'+ch+'" class="btn bs '+cls+'" style="'+style+'" '+click+'>'+esc(label)+suffix+'</button>';
  });
  h+='</div>';
  h+='<div id="ch-body">加载中...</div>';
  h+='</div>';
  document.getElementById('mc').innerHTML=h;

  _chCurrentTab='feishu';
  _chLoadTab('feishu');
}

// ============================
// 站群服务管理 — Cluster Services (2026-05-15)
// ============================
var csEditingId=null; // null=create mode, number=edit mode

window.l_cluster_services=function(){
  document.getElementById('pt').textContent='站群服务';
  var mc=document.getElementById('mc');
  mc.innerHTML='<div class="lo"><div class="s"></div>加载中...</div>';
  csEditingId=null;

  fetch('/admin/cluster/services',{headers:{'Authorization':'Bearer '+T}})
  .then(function(r){return r.json()})
  .then(function(d){
    if(!d.success||!d.data){mc.innerHTML='<div class="em">'+esc(d.error||'加载失败')+'</div>';return}
    render(d.data);
  })
  .catch(function(e){mc.innerHTML='<div class="em">请求失败: '+esc(e.message)+'</div>'});

  function render(services){
    var h='<div class="cd"><div class="st" style="display:flex;justify-content:space-between;align-items:center">';
    h+='站群服务 <span style="font-weight:400;font-size:11px;color:var(--dim)">共 '+services.length+' 个服务</span>';
    h+='<span>';
    h+='<button class="btn bs bp" onclick="csShowForm(null)" style="font-size:11px">+ 添加服务</button> ';
    h+='<button class="btn bs" onclick="l_cluster_services()" style="font-size:11px">刷新</button>';
    h+='</span>';
    h+='</div>';

    // Form area (hidden by default)
    h+='<div id="cs-form" style="display:none;margin-bottom:16px;padding:16px 20px;border:1px solid var(--border);border-radius:10px;background:var(--bg-card)">';
    h+='<div id="cs-form-title" style="font-size:14px;font-weight:600;margin-bottom:14px">添加服务</div>';
    h+='<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px 16px">';
    // row 1
    h+='<div><label style="font-size:11px;color:var(--dim)">服务标识 *</label><input id="cs-f-sn" class="in" placeholder="例: myapp" style="width:100%"></div>';
    h+='<div><label style="font-size:11px;color:var(--dim)">显示名称 *</label><input id="cs-f-dn" class="in" placeholder="例: My App" style="width:100%"></div>';
    // row 2
    h+='<div><label style="font-size:11px;color:var(--dim)">域名 *</label><input id="cs-f-dom" class="in" placeholder="例: app.easykai.cn" style="width:100%"></div>';
    h+='<div><label style="font-size:11px;color:var(--dim)">端口 *</label><input id="cs-f-port" class="in" type="number" placeholder="8080" style="width:100%"></div>';
    // row 3
    h+='<div><label style="font-size:11px;color:var(--dim)">管理类型</label><select id="cs-f-mt" class="in" style="width:100%"><option value="tmux">tmux</option><option value="systemd">systemd</option></select></div>';
    h+='<div><label style="font-size:11px;color:var(--dim)">管理名称</label><input id="cs-f-mn" class="in" placeholder="tmux session 或 systemd unit" style="width:100%"></div>';
    // row 4
    h+='<div><label style="font-size:11px;color:var(--dim)">工作目录</label><input id="cs-f-wd" class="in" placeholder="/home/easykai/.../myservice" style="width:100%"></div>';
    h+='<div><label style="font-size:11px;color:var(--dim)">启动命令</label><input id="cs-f-cmd" class="in" placeholder="python3 -B app.py 8080" style="width:100%"></div>';
    // row 5
    h+='<div><label style="font-size:11px;color:var(--dim)">健康检查路径</label><input id="cs-f-hu" class="in" placeholder="/health" style="width:100%"></div>';
    h+='<div><label style="font-size:11px;color:var(--dim)">排序</label><input id="cs-f-so" class="in" type="number" placeholder="0" style="width:100%"></div>';
    h+='</div>';
    h+='<div style="margin-top:12px;display:flex;gap:8px">';
    h+='<button class="btn bp" onclick="csSaveService()" style="font-size:11px">保存</button>';
    h+='<button class="btn bs" onclick="document.getElementById(\'cs-form\').style.display=\'none\';csEditingId=null" style="font-size:11px">取消</button>';
    h+='<span id="cs-form-msg" style="font-size:11px;align-self:center"></span>';
    h+='</div>';
    h+='</div>';

    for(var i=0;i<services.length;i++){
      var s=services[i];
      var st=s.status||{};
      var running=st.running;
      var dot=running?'<span style="color:#00ff9f;font-size:14px">●</span>':'<span style="color:#ff4444;font-size:14px">●</span>';
      var statusText=running?'运行中':'已停止';
      var statusColor=running?'var(--green)':'var(--rose)';

      h+='<div class="svc-card" style="margin-bottom:16px;padding:18px 20px;border:1px solid var(--border);border-radius:10px;background:var(--bg-card)">';

      // Header row
      h+='<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">';
      h+='<div style="display:flex;align-items:center;gap:10px">';
      h+=dot+' ';
      h+='<span style="font-size:15px;font-weight:600">'+esc(s.display_name)+'</span>';
      h+='<span style="font-size:12px;color:var(--dim)">'+esc(s.domain)+' :'+s.port+'</span>';
      h+='<span style="font-size:11px;padding:2px 8px;border-radius:4px;background:'+statusColor+'15;color:'+statusColor+'">'+statusText+'</span>';
      h+='</div>';
      // CRUD buttons (right)
      h+='<div style="display:flex;gap:6px">';
      h+='<button class="btn bs" style="font-size:10px;padding:2px 8px" onclick="csShowForm('+s.id+')">编辑</button>';
      h+='<button class="btn bs" style="font-size:10px;padding:2px 8px;color:var(--rose)" onclick="csDeleteService('+s.id+',\''+escAttr(s.display_name)+'\')">删除</button>';
      h+='</div>';
      h+='</div>';

      // Info row
      h+='<div style="font-size:11px;color:var(--dim);margin-bottom:14px;display:flex;gap:20px;flex-wrap:wrap">';
      if(st.pid) h+='<span>PID: '+st.pid+'</span>';
      if(st.uptime) h+='<span>启动于: '+esc(st.uptime)+'</span>';
      if(st.cpu) h+='<span>CPU: '+esc(st.cpu)+'%</span>';
      if(st.mem) h+='<span>MEM: '+esc(st.mem)+'%</span>';
      h+='<span>管理: '+esc(s.manager_type)+' · '+esc(s.manager_name)+'</span>';
      h+='</div>';

      // Action buttons
      h+='<div style="display:flex;gap:8px;flex-wrap:wrap">';
      h+='<button class="btn bs bp" onclick="csAction('+s.id+',\'start\')" style="font-size:11px" '+(!running?'':'disabled')+'>启动</button>';
      h+='<button class="btn bs" style="font-size:11px;color:var(--rose)" onclick="csAction('+s.id+',\'stop\')" '+(!running?'disabled':'')+'>停止</button>';
      h+='<button class="btn bs" style="font-size:11px" onclick="csAction('+s.id+',\'restart\')">重启</button>';
      h+='<button class="btn bs" style="font-size:11px" onclick="csLogs('+s.id+',\''+escAttr(s.display_name)+'\')">日志</button>';
      h+='<button class="btn bs" style="font-size:11px" onclick="csHealth('+s.id+',\''+escAttr(s.display_name)+'\')">健康检查</button>';
      h+='</div>';

      // Status feedback area
      h+='<div id="cs-msg-'+s.id+'" style="margin-top:10px;font-size:11px"></div>';

      h+='</div>';
    }
    h+='</div>';
    mc.innerHTML=h;
  }
}

// ── Show create/edit form ──
function csShowForm(sid){
  var form=document.getElementById('cs-form');
  if(!form) return;
  form.style.display='block';
  var title=document.getElementById('cs-form-title');
  document.getElementById('cs-form-msg').innerHTML='';

  if(sid===null){
    // Create mode
    csEditingId=null;
    if(title) title.textContent='添加服务';
    document.getElementById('cs-f-sn').value='';
    document.getElementById('cs-f-dn').value='';
    document.getElementById('cs-f-dom').value='';
    document.getElementById('cs-f-port').value='';
    document.getElementById('cs-f-mt').value='tmux';
    document.getElementById('cs-f-mn').value='';
    document.getElementById('cs-f-wd').value='';
    document.getElementById('cs-f-cmd').value='';
    document.getElementById('cs-f-hu').value='/health';
    document.getElementById('cs-f-so').value='0';
    document.getElementById('cs-f-sn').disabled=false;
    form.scrollIntoView({behavior:'smooth'});
    return;
  }

  // Edit mode: fetch service data
  csEditingId=sid;
  if(title) title.textContent='编辑服务';
  fetch('/admin/cluster/services',{headers:{'Authorization':'Bearer '+T}})
  .then(function(r){return r.json()})
  .then(function(d){
    if(!d.success||!d.data) return;
    for(var i=0;i<d.data.length;i++){
      if(d.data[i].id===sid){
        var s=d.data[i];
        document.getElementById('cs-f-sn').value=s.service_name||'';
        document.getElementById('cs-f-sn').disabled=true; // can't change service_name
        document.getElementById('cs-f-dn').value=s.display_name||'';
        document.getElementById('cs-f-dom').value=s.domain||'';
        document.getElementById('cs-f-port').value=s.port||'';
        document.getElementById('cs-f-mt').value=s.manager_type||'tmux';
        document.getElementById('cs-f-mn').value=s.manager_name||'';
        document.getElementById('cs-f-wd').value=s.workdir||'';
        document.getElementById('cs-f-cmd').value=s.start_cmd||'';
        document.getElementById('cs-f-hu').value=s.health_url||'/health';
        document.getElementById('cs-f-so').value=s.sort_order||0;
        break;
      }
    }
    form.scrollIntoView({behavior:'smooth'});
  });
}

// ── Save (create or update) ──
function csSaveService(){
  var msgEl=document.getElementById('cs-form-msg');
  if(!msgEl) return;
  msgEl.innerHTML='<span style="color:var(--dim)">保存中...</span>';

  var body={
    display_name: document.getElementById('cs-f-dn').value.trim(),
    domain: document.getElementById('cs-f-dom').value.trim(),
    port: parseInt(document.getElementById('cs-f-port').value)||0,
    manager_type: document.getElementById('cs-f-mt').value,
    manager_name: document.getElementById('cs-f-mn').value.trim(),
    workdir: document.getElementById('cs-f-wd').value.trim(),
    start_cmd: document.getElementById('cs-f-cmd').value.trim(),
    health_url: document.getElementById('cs-f-hu').value.trim(),
    sort_order: parseInt(document.getElementById('cs-f-so').value)||0
  };

  var isEdit=(csEditingId!==null);
  if(!isEdit){
    body.service_name=document.getElementById('cs-f-sn').value.trim();
    if(!body.service_name||!body.display_name||!body.domain||!body.port){
      msgEl.innerHTML='<span style="color:var(--rose)">标识/名称/域名/端口为必填</span>';return;
    }
  }

  var method=isEdit?'PUT':'POST';
  var url=isEdit?'/admin/cluster/services/'+csEditingId:'/admin/cluster/services';

  fetch(url,{method:method,headers:{'Authorization':'Bearer '+T,'Content-Type':'application/json'},body:JSON.stringify(body)})
  .then(function(r){return r.json()})
  .then(function(d){
    if(d.success){
      msgEl.innerHTML='<span style="color:var(--green)">'+esc(d.message||'保存成功')+'</span>';
      document.getElementById('cs-form').style.display='none';
      csEditingId=null;
      setTimeout(function(){l_cluster_services()},800);
    }else{
      msgEl.innerHTML='<span style="color:var(--rose)">'+esc(d.error||'保存失败')+'</span>';
    }
  })
  .catch(function(e){
    msgEl.innerHTML='<span style="color:var(--rose)">请求失败: '+esc(e.message)+'</span>';
  });
}

// ── Delete service ──
function csDeleteService(sid, name){
  if(!confirm('确定删除服务「'+name+'」？\n此操作不可恢复。')) return;
  var mc=document.getElementById('mc');
  mc.innerHTML='<div class="lo"><div class="s"></div>删除中...</div>';

  fetch('/admin/cluster/services/'+sid,{method:'DELETE',headers:{'Authorization':'Bearer '+T}})
  .then(function(r){return r.json()})
  .then(function(d){
    if(d.success){
      l_cluster_services();
    }else{
      mc.innerHTML='<div class="em">'+esc(d.error||'删除失败')+' <button class="btn bs" onclick="l_cluster_services()">返回</button></div>';
    }
  })
  .catch(function(e){
    l_cluster_services();
  });
}

// ── Helper: action buttons ──
function csAction(sid, action){
  var labels={start:'启动',stop:'停止',restart:'重启'};
  var msgEl=document.getElementById('cs-msg-'+sid);
  if(!msgEl) return;
  msgEl.innerHTML='<span style="color:var(--dim)">⏳ '+labels[action]+'中...</span>';

  fetch('/admin/cluster/services/'+sid+'/'+action,{method:'POST',headers:{'Authorization':'Bearer '+T}})
  .then(function(r){return r.json()})
  .then(function(d){
    if(d.success){
      var st=d.status||{};
      var ok=action==='stop'?!st.running:st.running;
      msgEl.innerHTML='<span style="color:'+(ok?'var(--green)':'var(--amber)')+'">'+(d.message||labels[action]+'完成')+'</span>';
      // Refresh after 1.5s
      setTimeout(function(){l_cluster_services()},1500);
    }else{
      msgEl.innerHTML='<span style="color:var(--rose)">'+esc(d.error||'操作失败')+'</span>';
    }
  })
  .catch(function(e){
    msgEl.innerHTML='<span style="color:var(--rose)">请求失败: '+esc(e.message)+'</span>';
  });
}

function csLogs(sid, name){
  var mc=document.getElementById('mc');
  mc.innerHTML='<div class="cd"><div class="st">'+esc(name)+' — 日志 <button class="btn bs" onclick="l_cluster_services()" style="font-size:11px">← 返回</button> <button class="btn bs" onclick="csLogs('+sid+',\''+escAttr(name)+'\')" style="font-size:11px">刷新</button></div>';
  mc.innerHTML+='<div id="cs-log-area" style="background:#0a0a0e;border:1px solid var(--border);border-radius:8px;padding:14px;max-height:500px;overflow-y:auto;font-family:monospace;font-size:11px;line-height:1.5;white-space:pre-wrap;color:#aaa">加载中...</div>';
  mc.innerHTML+='</div>';

  fetch('/admin/cluster/services/'+sid+'/logs?lines=200',{headers:{'Authorization':'Bearer '+T}})
  .then(function(r){return r.json()})
  .then(function(d){
    var el=document.getElementById('cs-log-area');
    if(!el) return;
    if(d.success){
      var src=d.source?'<div style="color:var(--dim);margin-bottom:8px">来源: '+esc(d.source)+'</div>':'';
      el.innerHTML=src+(d.log||'(无日志)');
    }else{
      el.innerHTML='<span style="color:var(--rose)">'+esc(d.error||'加载失败')+'</span>';
    }
  })
  .catch(function(e){
    var el=document.getElementById('cs-log-area');
    if(el) el.innerHTML='<span style="color:var(--rose)">请求失败: '+esc(e.message)+'</span>';
  });
}

function csHealth(sid, name){
  var mc=document.getElementById('mc');
  mc.innerHTML='<div class="cd"><div class="st">'+esc(name)+' — 健康检查 <button class="btn bs" onclick="l_cluster_services()" style="font-size:11px">← 返回</button></div>';
  mc.innerHTML+='<div id="cs-health-area" style="margin-top:12px">检查中...</div>';
  mc.innerHTML+='</div>';

  fetch('/admin/cluster/services/'+sid+'/health',{headers:{'Authorization':'Bearer '+T}})
  .then(function(r){return r.json()})
  .then(function(d){
    var el=document.getElementById('cs-health-area');
    if(!el) return;
    var h='';
    h+='<div style="margin-bottom:10px">';
    h+='<span style="padding:4px 12px;border-radius:6px;font-size:12px;';
    if(d.healthy) h+='background:rgba(0,255,159,0.12);color:#00ff9f';
    else h+='background:rgba(255,68,68,0.12);color:#ff4444';
    h+='">'+(d.healthy?'● 健康':'● 异常')+'</span>';
    h+=' <span style="font-size:11px;color:var(--dim)">HTTP '+d.http_code+'</span>';
    h+='</div>';
    h+='<div style="font-size:11px;color:var(--dim);margin-bottom:8px">URL: '+esc(d.url)+'</div>';
    if(d.error) h+='<div style="color:var(--rose);font-size:11px;margin-bottom:8px">错误: '+esc(d.error)+'</div>';
    if(d.parsed){
      h+='<div style="background:#0a0a0e;border:1px solid var(--border);border-radius:6px;padding:12px;max-height:300px;overflow-y:auto;font-family:monospace;font-size:11px;white-space:pre-wrap;color:#aaa">'+esc(JSON.stringify(d.parsed,null,2))+'</div>';
    }else if(d.body){
      h+='<div style="background:#0a0a0e;border:1px solid var(--border);border-radius:6px;padding:12px;max-height:300px;overflow-y:auto;font-family:monospace;font-size:11px;white-space:pre-wrap;color:#aaa">'+esc(d.body)+'</div>';
    }
    el.innerHTML=h;
  })
  .catch(function(e){
    var el=document.getElementById('cs-health-area');
    if(el) el.innerHTML='<span style="color:var(--rose)">请求失败: '+esc(e.message)+'</span>';
  });
}
// 套餐管理 — l_plans
// ============================
window.l_plans=function(){
  document.getElementById("pt").textContent="套餐管理";
  var h='<div style="margin-bottom:12px"><button class="btn bp" onclick="showPlanForm()">+ 添加套餐</button></div>';
  h+='<div id="planForm" style="display:none;margin-bottom:16px" class="cd"><div class="st" id="planFormTitle">添加套餐</div>';
  h+='<div class="g2">';
  h+='<div><div style="font-size:11px;color:var(--dim)">标识 (plan_key)</div><input class="in" id="pk" placeholder="如：pro_max" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">名称</div><input class="in" id="pn" placeholder="如：Pro Max" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">月价 (元)</div><input class="in" id="ppm" type="number" step="0.01" value="0" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">年价 (元)</div><input class="in" id="ppy" type="number" step="0.01" value="0" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">日限次数</div><input class="in" id="pdl" type="number" value="0" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">排序</div><input class="in" id="pso" type="number" value="0" style="width:100%"></div>';
  h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">描述</div><textarea class="ta" id="pdesc" rows="2" placeholder="套餐说明..."></textarea></div>';
  h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">特性 (JSON数组)</div><input class="in" id="pfeat" value=\'[]\' placeholder=\'["basic","sentiment"]\' style="width:100%"></div>';
  h+='</div><div style="margin-top:10px"><button class="btn bp" onclick="savePlan()">保存</button> <button class="btn bo" onclick="hidePlanForm()">取消</button><input type="hidden" id="planEditId" value=""></div></div>';
  h+='<div id="planList"><div class="lo"><div class="s"></div></div></div>';
  document.getElementById("mc").innerHTML=h;
  loadPlans();
};

var plansData=[];

function loadPlans(){
  fetch("/admin/plans",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success){document.getElementById("planList").innerHTML='<div class="em">加载失败</div>';return}
    plansData=d.data||[];
    var h='<div class="cd"><div class="st">套餐列表 ('+plansData.length+')</div><table><tr><th>排序</th><th>标识</th><th>名称</th><th>月价</th><th>年价</th><th>日限</th><th>描述</th><th>状态</th><th>操作</th></tr>';
    if(!plansData.length){h+='<tr><td colspan="9"><div class="em">暂无套餐</div></td></tr>'}
    else{
      plansData.forEach(function(p){
        var st=p.is_active?'<span class="bdg on">启用</span>':'<span class="bdg off">禁用</span>';
        var monthly=p.price_month>0?'¥'+p.price_month:'免费';
        var yearly=p.price_year>0?'¥'+p.price_year:'-';
        h+='<tr><td>'+p.sort_order+'</td><td style="font-family:monospace">'+esc(p.plan_key)+'</td><td style="font-weight:600">'+esc(p.name)+'</td>'+
          '<td>'+monthly+'</td><td>'+yearly+'</td><td>'+p.daily_limit+'</td>'+
          '<td style="color:var(--dim);max-width:150px;overflow:hidden;text-overflow:ellipsis">'+esc(p.description)+'</td><td>'+st+'</td>'+
          '<td><button class="btn bo bs" onclick="togglePlan('+p.id+','+p.is_active+')">'+(p.is_active?'禁用':'启用')+'</button> '+
          '<button class="btn bo bs" onclick="editPlan('+p.id+')">编辑</button> '+
          '<button class="btn bo bs" onclick="deletePlan('+p.id+')">删除</button></td></tr>';
      });
    }
    h+='</table></div>';
    document.getElementById("planList").innerHTML=h;
  }).catch(function(){document.getElementById("planList").innerHTML='<div class="em">加载失败</div>'});
}

function showPlanForm(){
  document.getElementById("planForm").style.display="block";
  document.getElementById("planFormTitle").textContent="添加套餐";
  document.getElementById("planEditId").value="";
  document.getElementById("pk").value="";
  document.getElementById("pn").value="";
  document.getElementById("ppm").value="0";
  document.getElementById("ppy").value="0";
  document.getElementById("pdl").value="0";
  document.getElementById("pso").value="0";
  document.getElementById("pdesc").value="";
  document.getElementById("pfeat").value='[]';
}

function hidePlanForm(){
  document.getElementById("planForm").style.display="none";
}

function savePlan(){
  var eid=document.getElementById("planEditId").value;
  var plan_key=document.getElementById("pk").value.trim();
  var name=document.getElementById("pn").value.trim();
  if(!plan_key||!name){showToast("标识和名称不能为空","error");return}
  var body={
    plan_key:plan_key, name:name,
    price_month:parseFloat(document.getElementById("ppm").value)||0,
    price_year:parseFloat(document.getElementById("ppy").value)||0,
    daily_limit:parseInt(document.getElementById("pdl").value)||0,
    sort_order:parseInt(document.getElementById("pso").value)||0,
    description:document.getElementById("pdesc").value.trim(),
    features:document.getElementById("pfeat").value.trim()||'[]',
    is_active:1
  };
  var method=eid?"PUT":"POST";
  var url="/admin/plans"+(eid?"/"+eid:"");
  fetch(url,{method:method,headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(body)}).then(function(r){return r.json()}).then(function(d){
    if(d.success){hidePlanForm();loadPlans();showToast("保存成功","success")}
    else{showToast(d.error||"保存失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function editPlan(id){
  var p=null;
  for(var i=0;i<plansData.length;i++){if(plansData[i].id===id){p=plansData[i];break}}
  if(!p){showToast("未找到套餐","error");return}
  document.getElementById("planForm").style.display="block";
  document.getElementById("planFormTitle").textContent="编辑套餐";
  document.getElementById("planEditId").value=p.id;
  document.getElementById("pk").value=p.plan_key;
  document.getElementById("pn").value=p.name;
  document.getElementById("ppm").value=p.price_month;
  document.getElementById("ppy").value=p.price_year;
  document.getElementById("pdl").value=p.daily_limit;
  document.getElementById("pso").value=p.sort_order;
  document.getElementById("pdesc").value=p.description||"";
  document.getElementById("pfeat").value=p.features||'[]';
}

function deletePlan(id){
  if(!confirm("确定删除此套餐？"))return;
  fetch("/admin/plans/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){loadPlans();showToast("已删除","success")}
    else{showToast(d.error||"删除失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function togglePlan(id,current){
  fetch("/admin/plans/"+id,{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({is_active:current?0:1})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){loadPlans();showToast("已更新","success")}
    else{showToast(d.error||"更新失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

// ============================
// 订阅列表 — l_subscriptions
// ============================
window.l_subscriptions=function(){
  document.getElementById("pt").textContent="订阅列表";
  var h='<div style="margin-bottom:12px;display:flex;gap:8px">';
  h+='<input class="in" id="subSearch" placeholder="搜索用户..." style="flex:1" onkeyup="searchSub(event)">';
  h+='<select class="in" id="subStatusFilter" onchange="loadSubs()" style="width:140px">';
  h+='<option value="">全部状态</option><option value="active">活跃</option><option value="trialing">试用</option>';
  h+='<option value="past_due">逾期</option><option value="canceled">已取消</option><option value="expired">已过期</option>';
  h+='</select></div><div id="subList"><div class="lo"><div class="s"></div></div></div>';
  document.getElementById("mc").innerHTML=h;
  loadSubs();
};
function loadSubs(){
  var search=document.getElementById("subSearch").value;
  var status=document.getElementById("subStatusFilter").value;
  var query='?limit=100';
  if(search)query+='&search='+encodeURIComponent(search);
  if(status)query+='&status='+status;
  fetch("/subscription/admin/subscriptions"+query,{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success){document.getElementById("subList").innerHTML='<div class="em">加载失败</div>';return}
    var list=d.data||d;
    var subs=list.subscriptions||[];
    var h='<div class="cd"><div class="st">订阅 ('+(list.total||subs.length)+')</div><table><tr><th>ID</th><th>用户</th><th>套餐</th><th>周期</th><th>状态</th><th>到期</th><th>自动续费</th><th>支付方式</th><th>操作</th></tr>';
    if(!subs.length)h+='<tr><td colspan="9"><div class="em">暂无订阅</div></td></tr>';
    else subs.forEach(function(s){
      var stCls={active:'on',trialing:'pd',past_due:'off',canceled:'off',expired:'off'};
      var sc=s.status=='past_due'||s.status=='canceled'||s.status=='expired'?'off':'on';
      if(s.status=='trialing')sc='pd';
      h+='<tr><td>'+s.id+'</td><td>'+esc(s.nickname||s.phone||'UID:'+s.user_id)+'</td>';
      h+='<td>'+esc(s.plan_key)+'</td><td>'+s.period+'</td>';
      h+='<td><span class="bdg '+sc+'">'+s.status+'</span></td>';
      h+='<td>'+(s.current_period_end||'-').slice(0,10)+'</td>';
      h+='<td>'+(s.auto_renew?'✅':'❌')+'</td>';
      h+='<td>'+(s.payment_method||'-')+'</td>';
      h+='<td><button class="btn bs bo" onclick="manualRenew('+s.id+')">续费</button> ';
      h+='<button class="btn bs bo" onclick="forceCancel('+s.id+')" style="color:#f85149">取消</button></td></tr>';
    });
    h+='</table></div>';
    document.getElementById("subList").innerHTML=h;
  }).catch(function(){document.getElementById("subList").innerHTML='<div class="em">请求失败</div>'});
}
function searchSub(e){if(e.key=='Enter')loadSubs()}
function manualRenew(sid){
  if(!confirm('确认手动续费该订阅？'))return;
  fetch("/subscription/admin/subscriptions/"+sid+"/manual-renew",{method:"POST",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("✅ 已续费","success");loadSubs()}
    else showToast(d.error||"操作失败","error");
  }).catch(function(){showToast("请求失败","error")});
}
function forceCancel(sid){
  if(!confirm('⚠️ 强制取消后用户将降级为免费版，确定？'))return;
  fetch("/subscription/admin/subscriptions/"+sid+"/force-cancel",{method:"POST",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("✅ 已强制取消","success");loadSubs()}
    else showToast(d.error||"操作失败","error");
  }).catch(function(){showToast("请求失败","error")});
}

// ============================
// 订单管理 — l_sub_orders
// ============================
window.l_sub_orders=function(){
  document.getElementById("pt").textContent="订阅订单管理";
  var h='<div id="subOrderList"><div class="lo"><div class="s"></div></div></div>';
  document.getElementById("mc").innerHTML=h;
  fetch("/subscription/admin/orders?limit=100",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success)return;
    var orders=d.data&&d.data.orders?d.data.orders:(d.orders||[]);
    var h='<div class="cd"><div class="st">订阅订单 ('+(d.data&&d.data.total||orders.length)+')</div><table><tr><th>订单号</th><th>用户</th><th>金额</th><th>类型</th><th>套餐</th><th>支付</th><th>状态</th><th>时间</th></tr>';
    orders.forEach(function(o){
      var st=o.status=='paid'?'<span class="bdg on">已支付</span>':'<span class="bdg pd">'+o.status+'</span>';
      h+='<tr><td style="font-size:11px">'+esc(o.order_no)+'</td><td>'+esc(o.nickname||'UID:'+o.user_id)+'</td>';
      h+='<td>¥'+(o.amount_fen/100).toFixed(2)+'</td><td>'+esc(o.item_type)+'</td>';
      h+='<td>'+esc(o.plan_key)+'/'+o.period+'</td><td>'+(o.payment_method||'-')+'</td>';
      h+='<td>'+st+'</td><td style="font-size:11px">'+(o.paid_at||o.created_at||'').slice(0,16)+'</td></tr>';
    });
    h+='</table></div>';
    document.getElementById("subOrderList").innerHTML=h;
  });
};

// ============================
// 优惠券管理 — l_coupons
// ============================
window.l_coupons=function(){
  document.getElementById("pt").textContent="优惠券管理";
  var h='<div style="margin-bottom:12px"><button class="btn bp" onclick="showCouponForm()">+ 创建优惠券</button></div>';
  h+='<div id="couponForm" style="display:none;margin-bottom:16px" class="cd"><div class="st">创建优惠券</div>';
  h+='<div class="g2">';
  h+='<div><div style="font-size:11px;color:var(--dim)">优惠码</div><input class="in" id="cc" placeholder="如：WELCOME50" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">类型</div><select class="in" id="ct" style="width:100%"><option value="fixed">固定减免(分)</option><option value="percent">百分比(%)</option></select></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">减免值</div><input class="in" id="cv" type="number" value="0" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">最大使用次数(0=不限)</div><input class="in" id="cmu" type="number" value="0" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">每人限用</div><input class="in" id="cmpu" type="number" value="1" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">最低消费(分)</div><input class="in" id="cmaf" type="number" value="0" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">过期时间</div><input class="in" id="ce" type="date" style="width:100%"></div>';
  h+='</div><div style="margin-top:10px"><button class="btn bp" onclick="saveCoupon()">保存</button> <button class="btn bo" onclick="hideCouponForm()">取消</button></div></div>';
  h+='<div id="couponList"><div class="lo"><div class="s"></div></div></div>';
  document.getElementById("mc").innerHTML=h;
  loadCoupons();
};
function loadCoupons(){
  fetch("/subscription/admin/coupons",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success)return;
    var coupons=d.data&&d.data.coupons?d.data.coupons:(d.coupons||[]);
    var h='<div class="cd"><div class="st">优惠券 ('+coupons.length+')</div><table><tr><th>优惠码</th><th>类型</th><th>值</th><th>已用/上限</th><th>过期</th><th>状态</th></tr>';
    if(!coupons.length)h+='<tr><td colspan="6"><div class="em">暂无优惠券</div></td></tr>';
    else coupons.forEach(function(c){
      var st=c.is_active?'<span class="bdg on">启用</span>':'<span class="bdg off">禁用</span>';
      h+='<tr><td><strong>'+esc(c.code)+'</strong></td><td>'+(c.type=='fixed'?c.type+'分':c.type+'%')+'</td>';
      h+='<td>'+c.value+'</td><td>'+c.used_count+'/'+(c.max_uses||'∞')+'</td>';
      h+='<td>'+(c.expires_at?c.expires_at.slice(0,10):'-')+'</td><td>'+st+'</td></tr>';
    });
    h+='</table></div>';
    document.getElementById("couponList").innerHTML=h;
  });
}
function showCouponForm(){
  document.getElementById("couponForm").style.display="block";
}
function hideCouponForm(){
  document.getElementById("couponForm").style.display="none";
}
function saveCoupon(){
  var data={
    code: document.getElementById("cc").value,
    type: document.getElementById("ct").value,
    value: parseInt(document.getElementById("cv").value)||0,
    max_uses: parseInt(document.getElementById("cmu").value)||0,
    max_per_user: parseInt(document.getElementById("cmpu").value)||1,
    min_amount_fen: parseInt(document.getElementById("cmaf").value)||0,
    expires_at: document.getElementById("ce").value||null,
  };
  if(!data.code){showToast("请输入优惠码","error");return}
  fetch("/subscription/admin/coupons",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(data)}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("✅ 优惠券已创建","success");hideCouponForm();loadCoupons()}
    else showToast(d.error||"创建失败","error");
  }).catch(function(){showToast("请求失败","error")});
}

// ============================
// 收入看板 — l_sub_stats
// ============================
window.l_sub_stats=function(){
  document.getElementById("pt").textContent="收入看板";
  document.getElementById("mc").innerHTML='<div class="lo"><div class="s"></div>加载中...</div>';
  fetch("/subscription/admin/stats",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success)return;
    var ds=d.data||d;
    var h='<div class="g2">';
    h+=hk("MRR",ds.mrr_yuan||('¥'+(ds.mrr/100).toFixed(2)),"#00d4aa");
    h+=hk("活跃订阅",ds.active_subscriptions||0,"#58a6ff");
    h+=hk("本月新增",ds.new_this_month||0,"#3fb950");
    h+=hk("本月取消",ds.canceled_this_month||0,"#f85149");
    h+=hk("今日收入","¥"+(ds.today_revenue_fen/100).toFixed(2),"#d2a8ff");
    h+=hk("本月收入","¥"+(ds.month_revenue_fen/100).toFixed(2),"#f0883e");
    h+='</div>';
    // 套餐分布
    if(ds.distribution&&ds.distribution.length){
      h+='<div class="cd" style="margin-top:16px"><div class="st">套餐分布</div><table><tr><th>套餐</th><th>活跃数</th></tr>';
      ds.distribution.forEach(function(x){
        h+='<tr><td>'+esc(x.name||x.plan_key)+'</td><td>'+x.c+'</td></tr>';
      });
      h+='</table></div>';
    }
    document.getElementById("mc").innerHTML=h;
  }).catch(function(){document.getElementById("mc").innerHTML='<div class="em">请求失败</div>'});
}

// ============================
// 扣款日志 — l_sub_events
// ============================
window.l_sub_events=function(){
  document.getElementById("pt").textContent="扣款日志";
  document.getElementById("mc").innerHTML='<div class="lo"><div class="s"></div>加载中...</div>';
  fetch("/subscription/admin/events?limit=100",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success)return;
    var events=d.data&&d.data.events?d.data.events:(d.events||[]);
    var h='<div class="cd"><div class="st">扣款事件 ('+events.length+')</div><table><tr><th>用户</th><th>类型</th><th>渠道</th><th>金额</th><th>结果</th><th>原因</th><th>时间</th></tr>';
    if(!events.length)h+='<tr><td colspan="7"><div class="em">暂无事件</div></td></tr>';
    else events.forEach(function(e){
      var rcls=e.result=='success'?'on':'off';
      h+='<tr><td>'+esc(e.nickname||'UID:'+e.user_id)+'</td><td>'+esc(e.event_type)+'</td>';
      h+='<td>'+esc(e.channel)+'</td>';
      h+='<td>'+(e.amount_fen?'¥'+(e.amount_fen/100).toFixed(2):'-')+'</td>';
      h+='<td><span class="bdg '+rcls+'">'+(e.result||'unk')+'</span></td>';
      h+='<td style="font-size:11px">'+esc(e.fail_reason||'-')+'</td>';
      h+='<td style="font-size:11px">'+(e.created_at||'').slice(0,16)+'</td></tr>';
    });
    h+='</table></div>';
    document.getElementById("mc").innerHTML=h;
  }).catch(function(){document.getElementById("mc").innerHTML='<div class="em">请求失败</div>'});
}

window.l_orders=function(){
  document.getElementById("pt").textContent="订单管理";
  fetch("/admin/orders?limit=100",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    var ds=d.data;
    var h="<div class=\"cd\"><div class=\"st\">订单 ("+ds.total+")</div><table><tr><th>订单号</th><th>用户</th><th>金额</th><th>类型</th><th>状态</th><th>时间</th></tr>";
    ds.orders.forEach(function(o){
      var st=o.status=="paid"?'<span class="bdg on">已支付</span>':'<span class="bdg pd">'+o.status+'</span>';
      h+="<tr><td>"+o.order_no+"</td><td>"+(o.user_name||"-")+"</td><td>\u00a5"+o.amount+"</td><td>"+o.item_type+"</td><td>"+st+"</td><td>"+(o.created_at||"")+"</td></tr>";
    });
    h+="</table></div>";
    document.getElementById("mc").innerHTML=h;
  }).catch(function(){})
}

window.l_config=function(){
  document.getElementById("pt").textContent="基本设置";
  var h='<div class="cd">';
  h+='<div id="config-tab-content"></div>';
  h+='</div>';
  document.getElementById("mc").innerHTML=h;
  loadSystemConfig();
}
function loadSystemConfig(){
  fetch("/user/config",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success){document.getElementById("config-tab-content").innerHTML='<div class="em">无法加载</div>';return}
    var cats=d.categories||[{id:"other",title:"系统配置"}];
    var data=d.data||[];
    var schema=d.schema||{};
    var c="";
    cats.forEach(function(cat){
      var items=data.filter(function(k){return k.category==cat.id});
      if(!items.length)return;
      c+='<div class="cd" style="margin-bottom:12px">';
      c+='<div class="st">'+cat.title+'</div>';
      items.forEach(function(k){
        var isSensitive=k.sensitive;
        var displayVal=k.sensitive?k.masked_value:k.value;
        var safeVal=(k.value||"").replace(/"/g,"&quot;");
        var safeMasked=(k.masked_value||"").replace(/"/g,"&quot;");
        var label=k.label||k.key;
        var ph=k.placeholder||"";
        c+='<div class="fl">';
        c+='<div style="flex:1;min-width:0">';
        c+='<div style="font-size:12px;font-weight:600">'+label+'</div>';
        c+='<div style="font-size:10px;color:var(--dim)">'+(k.description||"")+'</div></div>';
        if(isSensitive){
          c+='<input class="in" id="cf-'+k.key+'" type="password" value="'+safeMasked+'" placeholder="'+ph+'" style="width:180px" onfocus="this.value=\'\'" onblur="if(!this.value)this.value=\''+safeMasked+'\'">';
        }else{
          c+='<input class="in" id="cf-'+k.key+'" value="'+safeVal+'" placeholder="'+ph+'" style="width:200px">';
        }
        c+='<button class="btn bp bs" onclick="scfg(\''+k.key+'\')">保存</button></div>';
      });
      c+='</div>';
    });
    document.getElementById("config-tab-content").innerHTML=c||'<div class="em">暂无配置项</div>';
    loadSmsTemplatesConfig();
  }).catch(function(){document.getElementById("config-tab-content").innerHTML='<div class="em">加载失败</div>'})
}
function loadSmsTemplatesConfig(){
  var ct=document.getElementById("config-tab-content");
  ct.insertAdjacentHTML("beforeend",'<div id="sms-config-loader" style="text-align:center;padding:12px;color:var(--dim)"><div class="s" style="display:inline-block"></div>编码设置加载中...</div>');
  fetch("/admin/sms/templates",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    var loader=document.getElementById("sms-config-loader");if(loader)loader.remove();
    var h='<div class="cd" style="margin-top:12px" id="sms-config-section"><div class="st">编码设置</div>';
    h+='<div style="margin-bottom:12px"><button class="btn bp" onclick="showSmsForm()">+ 添加模板</button></div>';
    h+='<div id="smsForm" style="display:none;margin-bottom:16px" class="cd"><div class="st" id="smsFormTitle">添加模板</div>';
    h+='<div class="g2">';
    h+='<div><div style="font-size:11px;color:var(--dim)">分类</div><select class="sl" id="smsCat" style="width:100%"><option value="captcha">验证码</option><option value="notice">短信通知</option><option value="promo">短信推广</option></select></div>';
    h+='<div><div style="font-size:11px;color:var(--dim)">名称</div><input class="in" id="smsName" placeholder="如：新用户注册" style="width:100%"></div>';
    h+='<div><div style="font-size:11px;color:var(--dim)">模板 CODE</div><input class="in" id="smsCode" placeholder="SMS_xxxxxxxxx" style="width:100%"></div>';
    h+='<div><div style="font-size:11px;color:var(--dim)">备注</div><input class="in" id="smsNote" placeholder="用途说明" style="width:100%"></div>';
    h+='</div>';
    h+='<div style="margin-top:10px"><button class="btn bp" onclick="saveSmsTemplate()">保存</button> <button class="btn bo" onclick="document.getElementById(\'smsForm\').style.display=\'none\'">取消</button><input type="hidden" id="smsEditId" value=""></div></div>';
    if(!d.success||!d.data){h+='<div class="em">加载失败</div>'}
    else{
      var cats=d.data.categories;
      h+='<div id="smsTemplates">';
      var order=["captcha","notice","promo"];
      var hasItems=false;
      order.forEach(function(k){
        var c=cats[k];
        if(!c||!c.items||!c.items.length)return;
        hasItems=true;
        h+='<div class="cd" style="margin-bottom:12px"><div class="st">'+c.title+' ('+c.items.length+')</div><table><tr><th>名称</th><th>模板 CODE</th><th>备注</th><th>操作</th></tr>';
        c.items.forEach(function(t){
          h+='<tr><td>'+esc(t.name)+'</td><td style="font-family:monospace;color:var(--accent)">'+esc(t.template_code)+'</td><td style="color:var(--dim)">'+esc(t.note)+'</td>';
          h+='<td><button class="btn bo bs" onclick="editSmsTemplate('+t.id+',\''+t.category+'\',\''+esc(t.name)+'\',\''+esc(t.template_code)+'\',\''+esc(t.note)+'\')">编辑</button> ';
          h+='<button class="btn bo bs" onclick="deleteSmsTemplate('+t.id+')">删除</button></td></tr>';
        });
        h+='</table></div>';
      });
      if(!hasItems)h+='<div class="em">暂无模板，点击「+ 添加模板」创建</div>';
      h+='</div>';
    }
    h+='</div>';
    ct.insertAdjacentHTML("beforeend",h);
    loadNavConfig();
  }).catch(function(){
    var loader=document.getElementById("sms-config-loader");if(loader)loader.remove();
    ct.insertAdjacentHTML("beforeend",'<div class="em">编码设置加载失败</div>');
    loadNavConfig();
  })
}
function loadNavConfig(){
  var ct=document.getElementById("config-tab-content");
  ct.insertAdjacentHTML("beforeend",'<div id="hn-loader" style="text-align:center;padding:12px;color:var(--dim)"><div class="s" style="display:inline-block"></div>主导航加载中...</div>');
  fetch("/admin/footer-nav",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    var loader=document.getElementById("hn-loader");if(loader)loader.remove();
    if(!d.success){ct.insertAdjacentHTML("beforeend",'<div class="em">加载失败</div>');loadFooterLinksConfig();return}
    var h='<div class="cd" style="margin-top:24px"><div class="st">主导航管理</div>';
    h+='<div style="margin-bottom:12px"><button class="btn bp" onclick="hnShowAddForm()">+ 新增导航</button></div>';
    h+='<div id="hn-list"><table><tr><th style="width:50px">排序</th><th>标题</th><th style="width:240px">URL</th><th style="width:50px">状态</th><th style="width:100px">操作</th></tr>';
    if(!d.data.length){h+='<tr><td colspan="5" class="em">暂无导航项</td></tr>'}
    else{d.data.forEach(function(m,i){
      h+='<tr data-hn-id="'+m.id+'" data-hn-title="'+escAttr(m.title)+'" data-hn-url="'+escAttr(m.url)+'" data-hn-enabled="'+(m.is_enabled?1:0)+'"><td style="display:flex;gap:2px;align-items:center;justify-content:center">';
      if(i>0)h+='<button class="btn bo bs" style="padding:2px 4px;font-size:10px" onclick="hnMove('+m.id+',\'up\')">▲</button>';
      else h+='<span style="width:22px"></span>';
      if(i<d.data.length-1)h+='<button class="btn bo bs" style="padding:2px 4px;font-size:10px" onclick="hnMove('+m.id+',\'down\')">▼</button>';
      else h+='<span style="width:22px"></span>';
      h+='</td><td>'+esc(m.title)+'</td><td style="max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(m.url)+'</td><td>'+(m.is_enabled?'✅':'⛔')+'</td><td style="display:flex;gap:4px"><button class="btn bo bs" onclick="hnEditForm('+m.id+')">编辑</button><button class="btn bo bs" style="color:#f85149" onclick="hnDelete('+m.id+',\''+escAttr(m.title)+'\')">删除</button></td></tr>'
    })}
    h+='</table></div></div>';ct.insertAdjacentHTML("beforeend",h);
    loadFooterLinksConfig();
  }).catch(function(){ct.insertAdjacentHTML("beforeend",'<div class="em">请求失败</div>');loadFooterLinksConfig()})
}
function hnShowAddForm(){
  var ct=document.getElementById("hn-list");
  var existing=document.getElementById("hn-add-row");if(existing)existing.remove();
  var h='<tr id="hn-add-row" style="background:rgba(0,245,255,0.05)"><td colspan="5">';
  h+='<div style="display:flex;gap:8px;align-items:center;padding:6px 0"><input class="in" id="hn-add-title" placeholder="标题" style="width:100px"><input class="in" id="hn-add-url" placeholder="URL" style="flex:1"><button class="btn bp" onclick="hnDoAdd()">添加</button><button class="btn bo" onclick="document.getElementById(\'hn-add-row\').remove()">取消</button></div>';
  h+='</td></tr>';
  ct.querySelector("table").insertAdjacentHTML("beforeend",h);
}
function hnDoAdd(){
  var title=document.getElementById("hn-add-title").value.trim();
  var url=document.getElementById("hn-add-url").value.trim();
  if(!title||!url){showToast("标题和URL必填","error");return}
  fetch("/admin/footer-nav",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({title:title,url:url,is_enabled:true})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("已添加");loadConfigs()}
    else{showToast(d.error||"添加失败","error")}
  }).catch(function(){showToast("请求失败","error")})
}
function hnEditForm(id){
  var row=document.querySelector("#hn-list tr[data-hn-id=\""+id+"\"]");
  if(!row)return;
  var title=row.getAttribute("data-hn-title");
  var url=row.getAttribute("data-hn-url");
  var enabled=row.getAttribute("data-hn-enabled")==="1";
  row.outerHTML='<tr id="hn-edit-row" style="background:rgba(0,245,255,0.05)"><td colspan="5">'+
    '<div style="display:flex;gap:8px;align-items:center;padding:6px 0">'+
    '<input class="in" id="hn-edit-title" value="'+escAttr(title)+'" style="width:100px">'+
    '<input class="in" id="hn-edit-url" value="'+escAttr(url)+'" style="flex:1">'+
    '<label style="font-size:12px;display:flex;align-items:center;gap:4px;white-space:nowrap"><input type="checkbox" id="hn-edit-enabled"'+(enabled?' checked':'')+'>启用</label>'+
    '<button class="btn bp" onclick="hnDoEdit('+id+')">保存</button>'+
    '<button class="btn bo" onclick="loadConfigs()">取消</button></div></td></tr>';
}
function hnDoEdit(id){
  var title=document.getElementById("hn-edit-title").value.trim();
  var url=document.getElementById("hn-edit-url").value.trim();
  var enabled=document.getElementById("hn-edit-enabled").checked;
  if(!title||!url){showToast("标题和URL必填","error");return}
  fetch("/admin/footer-nav/"+id,{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({title:title,url:url,is_enabled:enabled})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("已保存");loadConfigs()}
    else{showToast(d.error||"保存失败","error")}
  }).catch(function(){showToast("请求失败","error")})
}
function hnDelete(id,title){
  if(!confirm("确认删除导航项「"+title+"」？"))return;
  fetch("/admin/footer-nav/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("已删除");loadConfigs()}
    else{showToast(d.error||"删除失败","error")}
  }).catch(function(){showToast("请求失败","error")})
}
function hnMove(id,direction){
  fetch("/admin/footer-nav",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    var items=d.data;
    var idx=-1;
    for(var i=0;i<items.length;i++){if(items[i].id===id){idx=i;break}}
    if(idx<0)return;
    var swapIdx=direction==="up"?idx-1:idx+1;
    if(swapIdx<0||swapIdx>=items.length)return;
    var a=items[idx],b=items[swapIdx];
    Promise.all([
      fetch("/admin/footer-nav/"+a.id,{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({title:a.title,url:a.url,is_enabled:a.is_enabled?true:false,sort_order:b.sort_order})}),
      fetch("/admin/footer-nav/"+b.id,{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({title:b.title,url:b.url,is_enabled:b.is_enabled?true:false,sort_order:a.sort_order})})
    ]).then(function(){loadConfigs()}).catch(function(){showToast("排序失败","error")})
  })
}
function loadFooterLinksConfig(){
  var ct=document.getElementById("config-tab-content");
  ct.insertAdjacentHTML("beforeend",'<div id="fl-loader" style="text-align:center;padding:12px;color:var(--dim)"><div class="s" style="display:inline-block"></div>页脚栏目加载中...</div>');
  fetch("/admin/footer-links",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    var loader=document.getElementById("fl-loader");if(loader)loader.remove();
    if(!d.success){ct.insertAdjacentHTML("beforeend",'<div class="em">加载失败</div>');loadSocialMediaConfig();return}
    var h='<div class="cd" style="margin-top:24px"><div class="st">页脚栏目</div>';
    h+='<div style="margin-bottom:12px"><button class="btn bp" onclick="flShowAddForm()">+ 新增链接</button></div>';
    h+='<div id="fl-list"><table><tr><th style="width:80px">栏目</th><th>标题</th><th style="width:200px">URL</th><th style="width:50px">状态</th><th style="width:60px">操作</th></tr>';
    if(!d.data.length){h+='<tr><td colspan="5" class="em">暂无记录</td></tr>'}
    else{d.data.forEach(function(m){h+='<tr><td>'+esc(m.section)+'</td><td>'+esc(m.title)+'</td><td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(m.url)+'</td><td>'+(m.is_enabled?'✅':'⛔')+'</td><td style="display:flex;gap:4px"><button class="btn bo bs" onclick="flEditForm('+m.id+')">编辑</button><button class="btn bo bs" style="color:#f85149" onclick="flDelete('+m.id+',\''+escAttr(m.title)+'\')">删除</button></td></tr>'})}
    h+='</table></div></div>';ct.insertAdjacentHTML("beforeend",h);
    loadSocialMediaConfig();
  }).catch(function(){ct.insertAdjacentHTML("beforeend",'<div class="em">请求失败</div>');loadSocialMediaConfig()})
}
function loadSocialMediaConfig(){
  var ct=document.getElementById("config-tab-content");
  ct.insertAdjacentHTML("beforeend",'<div id="sm-loader" style="text-align:center;padding:12px;color:var(--dim)"><div class="s" style="display:inline-block"></div>社媒管理加载中...</div>');
  fetch("/admin/social-media",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    var loader=document.getElementById("sm-loader");if(loader)loader.remove();
    if(!d.success||!d.data){ct.insertAdjacentHTML("beforeend",'<div class="em">社媒管理加载失败</div>');return}
    var items=d.data;
    var h='<div class="cd" style="margin-top:24px"><div class="st">社媒管理</div>';
    h+='<div style="margin-bottom:12px"><button class="btn bp" onclick="smShowAddForm()">+ 新增社交媒体</button></div>';
    h+='<div id="sm-list"><div style="font-size:12px;color:var(--dim);margin-bottom:8px">社交媒体链接 ('+items.length+')</div>';
    if(!items.length){
      h+='<div class="em">暂无记录</div>';
      ct.insertAdjacentHTML("beforeend",h);
      return;
    }
    h+='<table id="sm-table"><tr><th style="width:30px">序号</th><th style="width:80px">图标</th><th>平台名称</th><th style="width:200px">URL</th><th>Hover文字</th><th style="width:60px">启用</th><th style="width:80px">操作</th></tr>';
    items.forEach(function(item,idx){
      var enableIcon=item.is_enabled?'✓':'○';
      var enableCls=item.is_enabled?'on':'off';
      var iconHtml=smRenderIcon(item.icon_type,item.icon_value);
      h+='<tr id="sm-row-'+item.id+'" data-id="'+item.id+'" data-order="'+item.display_order+'"';
      h+=' data-platform_name="'+escAttr(item.platform_name)+'" data-icon_type="'+escAttr(item.icon_type||'')+'"';
      h+=' data-icon_value="'+escAttr(item.icon_value||'')+'" data-url="'+escAttr(item.url)+'"';
      h+=' data-hover_text="'+escAttr(item.hover_text||'')+'" data-is_enabled="'+item.is_enabled+'">';
      h+='<td style="text-align:center;color:var(--dim)">'+item.display_order+'</td>';
      h+='<td style="text-align:center">'+iconHtml+'</td>';
      h+='<td>'+esc(item.platform_name)+'</td>';
      h+='<td><span style="font-size:11px;color:var(--muted);word-break:break-all">'+esc(item.url)+'</span></td>';
      h+='<td style="font-size:11px">'+esc(item.hover_text||'-')+'</td>';
      h+='<td><span class="bdg '+enableCls+'">'+enableIcon+'</span></td>';
      h+='<td style="display:flex;gap:4px"><button class="btn bo bs" onclick="smEditForm('+item.id+')">编辑</button><button class="btn bo bs" style="color:#f85149" onclick="smDelete('+item.id+',\''+escAttr(item.platform_name)+'\')">删除</button></td>';
      h+='</tr>';
    });
    h+='</table></div>';
    ct.insertAdjacentHTML("beforeend",h);
    loadPartnersConfig();
  }).catch(function(){ct.insertAdjacentHTML("beforeend",'<div class="em">社媒管理请求失败</div>');loadPartnersConfig()})
}
function loadPartnersConfig(){
  var ct=document.getElementById("config-tab-content");
  ct.insertAdjacentHTML("beforeend",'<div id="pt-loader" style="text-align:center;padding:12px;color:var(--dim)"><div class="s" style="display:inline-block"></div>生态伙伴加载中...</div>');
  fetch("/admin/partners",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    var loader=document.getElementById("pt-loader");if(loader)loader.remove();
    if(!d.success){ct.insertAdjacentHTML("beforeend",'<div class="em">加载失败</div>');return}
    var h='<div class="cd" style="margin-top:12px"><div class="st">生态伙伴</div>';
    h+='<div style="margin-bottom:12px"><button class="btn bp" onclick="ptShowAddForm()">+ 新增伙伴</button></div>';
    h+='<div id="pt-list"><table><tr><th>名称</th><th style="width:200px">URL</th><th style="width:50px">状态</th><th style="width:60px">操作</th></tr>';
    if(!d.data.length){h+='<tr><td colspan="4" class="em">暂无记录</td></tr>'}
    else{d.data.forEach(function(m){h+='<tr><td>'+esc(m.name)+'</td><td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(m.url)+'</td><td>'+(m.is_enabled?'✅':'⛔')+'</td><td style="display:flex;gap:4px"><button class="btn bo bs" onclick="ptEditForm('+m.id+')">编辑</button><button class="btn bo bs" style="color:#f85149" onclick="ptDelete('+m.id+',\''+escAttr(m.name)+'\')">删除</button></td></tr>'})}
    h+='</table></div></div>';ct.insertAdjacentHTML("beforeend",h);
  }).catch(function(){ct.insertAdjacentHTML("beforeend",'<div class="em">请求失败</div>')})
}
// ── Page Footer CRUD Functions ──
function escAttr(s){if(!s)return'';return s.replace(/\\\\/g,'\\\\\\\\').replace(/'/g,"\\\\'").replace(/\\n/g,'\\\\n')}
// 站内连接 CRUD
function flShowAddForm(){var h='<div class="cd" style="margin-top:12px" id="fl-form"><div class="st">新增站内连接</div>';h+='<div style="display:flex;flex-direction:column;gap:8px">';h+='<input class="in" id="fl-section" placeholder="栏目名称 (如: 产品、社区)">';h+='<input class="in" id="fl-title" placeholder="链接标题">';h+='<input class="in" id="fl-url" placeholder="链接 URL">';h+='</div><div style="margin-top:12px;display:flex;gap:8px"><button class="btn bp" onclick="flSubmitCreate()">创建</button><button class="btn bo" onclick="flCancelForm()">取消</button></div></div>';document.getElementById("fl-list").insertAdjacentHTML("beforebegin",h)}
function flEditForm(id){fetch("/admin/footer-links",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){if(!d.success)return;var m=d.data.find(function(x){return x.id==id});if(!m)return;var h='<div class="cd" style="margin-top:12px" id="fl-form"><div class="st">编辑站内连接</div>';h+='<div style="display:flex;flex-direction:column;gap:8px">';h+='<input class="in" id="fl-section" value="'+escAttr(m.section)+'" placeholder="栏目名称">';h+='<input class="in" id="fl-title" value="'+escAttr(m.title)+'" placeholder="链接标题">';h+='<input class="in" id="fl-url" value="'+escAttr(m.url)+'" placeholder="链接 URL">';h+='<label><input type="checkbox" id="fl-enabled"'+(m.is_enabled?' checked':'')+'> 启用</label>';h+='</div><div style="margin-top:12px;display:flex;gap:8px"><button class="btn bp" onclick="flSubmitUpdate('+id+')">保存</button><button class="btn bo" onclick="flCancelForm()">取消</button></div></div>';document.getElementById("fl-list").insertAdjacentHTML("beforebegin",h)})}
function flSubmitCreate(){var d={section:document.getElementById("fl-section").value.trim(),title:document.getElementById("fl-title").value.trim(),url:document.getElementById("fl-url").value.trim(),is_enabled:true};fetch("/admin/footer-links",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(d)}).then(function(r){return r.json()}).then(function(d){if(d.success){flCancelForm();flRefresh()}else{alert(d.error||"创建失败")}}).catch(function(){alert("请求失败")})}
function flSubmitUpdate(id){var d={section:document.getElementById("fl-section").value.trim(),title:document.getElementById("fl-title").value.trim(),url:document.getElementById("fl-url").value.trim(),is_enabled:document.getElementById("fl-enabled").checked};fetch("/admin/footer-links/"+id,{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(d)}).then(function(r){return r.json()}).then(function(d){if(d.success){flCancelForm();flRefresh()}else{alert(d.error||"更新失败")}}).catch(function(){alert("请求失败")})}
function flDelete(id,name){if(!confirm("确定删除「"+name+"」？"))return;fetch("/admin/footer-links/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){if(d.success){flRefresh()}else{alert(d.error||"删除失败")}}).catch(function(){alert("请求失败")})}
function flCancelForm(){var f=document.getElementById("fl-form");if(f)f.remove()}
function flRefresh(){flCancelForm();var el=document.getElementById("fl-list");el.innerHTML='<div style="text-align:center;padding:12px;color:var(--dim)"><div class="s" style="display:inline-block"></div></div>';fetch("/admin/footer-links",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){if(!d.success)return;var h='<table><tr><th style="width:80px">栏目</th><th>标题</th><th style="width:200px">URL</th><th style="width:50px">状态</th><th style="width:60px">操作</th></tr>';if(!d.data.length){h+='<tr><td colspan="5" class="em">暂无记录</td></tr>'}else{d.data.forEach(function(m){h+='<tr><td>'+esc(m.section)+'</td><td>'+esc(m.title)+'</td><td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(m.url)+'</td><td>'+(m.is_enabled?'✅':'⛔')+'</td><td style="display:flex;gap:4px"><button class="btn bo bs" onclick="flEditForm('+m.id+')">编辑</button><button class="btn bo bs" style="color:#f85149" onclick="flDelete('+m.id+',\''+escAttr(m.title)+'\')">删除</button></td></tr>'})}h+='</table>';el.innerHTML=h})}
// 站内导航 CRUD
function fnShowAddForm(){var h='<div class="cd" style="margin-top:12px" id="fn-form"><div class="st">新增站内导航</div>';h+='<div style="display:flex;flex-direction:column;gap:8px">';h+='<input class="in" id="fn-title" placeholder="链接标题">';h+='<input class="in" id="fn-url" placeholder="链接 URL">';h+='</div><div style="margin-top:12px;display:flex;gap:8px"><button class="btn bp" onclick="fnSubmitCreate()">创建</button><button class="btn bo" onclick="fnCancelForm()">取消</button></div></div>';document.getElementById("fn-list").insertAdjacentHTML("beforebegin",h)}
function fnEditForm(id){fetch("/admin/footer-nav",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){if(!d.success)return;var m=d.data.find(function(x){return x.id==id});if(!m)return;var h='<div class="cd" style="margin-top:12px" id="fn-form"><div class="st">编辑站内导航</div>';h+='<div style="display:flex;flex-direction:column;gap:8px">';h+='<input class="in" id="fn-title" value="'+escAttr(m.title)+'" placeholder="链接标题">';h+='<input class="in" id="fn-url" value="'+escAttr(m.url)+'" placeholder="链接 URL">';h+='<label><input type="checkbox" id="fn-enabled"'+(m.is_enabled?' checked':'')+'> 启用</label>';h+='</div><div style="margin-top:12px;display:flex;gap:8px"><button class="btn bp" onclick="fnSubmitUpdate('+id+')">保存</button><button class="btn bo" onclick="fnCancelForm()">取消</button></div></div>';document.getElementById("fn-list").insertAdjacentHTML("beforebegin",h)})}
function fnSubmitCreate(){var d={title:document.getElementById("fn-title").value.trim(),url:document.getElementById("fn-url").value.trim(),is_enabled:true};fetch("/admin/footer-nav",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(d)}).then(function(r){return r.json()}).then(function(d){if(d.success){fnCancelForm();fnRefresh()}else{alert(d.error||"创建失败")}}).catch(function(){alert("请求失败")})}
function fnSubmitUpdate(id){var d={title:document.getElementById("fn-title").value.trim(),url:document.getElementById("fn-url").value.trim(),is_enabled:document.getElementById("fn-enabled").checked};fetch("/admin/footer-nav/"+id,{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(d)}).then(function(r){return r.json()}).then(function(d){if(d.success){fnCancelForm();fnRefresh()}else{alert(d.error||"更新失败")}}).catch(function(){alert("请求失败")})}
function fnDelete(id,name){if(!confirm("确定删除「"+name+"」？"))return;fetch("/admin/footer-nav/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){if(d.success){fnRefresh()}else{alert(d.error||"删除失败")}}).catch(function(){alert("请求失败")})}
function fnCancelForm(){var f=document.getElementById("fn-form");if(f)f.remove()}
function fnRefresh(){fnCancelForm();var el=document.getElementById("fn-list");el.innerHTML='<div style="text-align:center;padding:12px;color:var(--dim)"><div class="s" style="display:inline-block"></div></div>';fetch("/admin/footer-nav",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){if(!d.success)return;var h='<table><tr><th>标题</th><th style="width:200px">URL</th><th style="width:50px">状态</th><th style="width:60px">操作</th></tr>';if(!d.data.length){h+='<tr><td colspan="4" class="em">暂无记录</td></tr>'}else{d.data.forEach(function(m){h+='<tr><td>'+esc(m.title)+'</td><td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(m.url)+'</td><td>'+(m.is_enabled?'✅':'⛔')+'</td><td style="display:flex;gap:4px"><button class="btn bo bs" onclick="fnEditForm('+m.id+')">编辑</button><button class="btn bo bs" style="color:#f85149" onclick="fnDelete('+m.id+',\''+escAttr(m.title)+'\')">删除</button></td></tr>'})}h+='</table>';el.innerHTML=h})}
