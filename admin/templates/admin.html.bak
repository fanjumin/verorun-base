// ── Social Media Management CRUD Functions ──
function smRenderIcon(icon_type,icon_value){
  if(!icon_value)return '<span style="color:var(--dim)">?</span>';
  if(icon_type==='svg')return '<span style="width:22px;height:22px;display:inline-flex;vertical-align:middle;color:var(--accent)">'+icon_value+'</span>';
  if(icon_type==='url')return '<img src="'+escAttr(icon_value)+'" style="width:22px;height:22px;border-radius:3px;object-fit:contain">';
  return '<i class="'+escAttr(icon_value)+'" style="font-size:18px;color:var(--accent)"></i>';
}
function smRefresh(){
  var el=document.getElementById("sm-list");if(el)el.remove();
  var fm=document.getElementById("sm-form");if(fm)fm.remove();
  var ld=document.getElementById("sm-loader");if(ld)ld.remove();
  var ct=document.getElementById("config-tab-content");
  ct.insertAdjacentHTML("beforeend",'<div id="sm-loader" style="text-align:center;padding:12px;color:var(--dim)"><div class="s" style="display:inline-block"></div>刷新中...</div>');
  fetch("/admin/social-media",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    var loader=document.getElementById("sm-loader");if(loader)loader.remove();
    if(!d.success||!d.data){return}
    var items=d.data;
    var h='';
    if(!items.length){h='<div class="em">暂无记录</div>';ct.insertAdjacentHTML("beforeend",'<div id="sm-list">'+h+'</div>');return}
    h+='<table id="sm-table"><tr><th style="width:30px">序号</th><th style="width:80px">图标</th><th>平台名称</th><th style="width:200px">URL</th><th>Hover文字</th><th style="width:60px">启用</th><th style="width:80px">操作</th></tr>';
    items.forEach(function(item,idx){
      var enableIcon=item.is_enabled?'✓':'○';
      var enableCls=item.is_enabled?'on':'off';
      var iconHtml=smRenderIcon(item.icon_type,item.icon_value);
      h+='<tr id="sm-row-'+item.id+'" data-id="'+item.id+'" data-order="'+item.display_order+'"';
      h+=' data-platform_name="'+escAttr(item.platform_name)+'" data-icon_type="'+escAttr(item.icon_type)+'"';
      h+=' data-icon_value="'+escAttr(item.icon_value)+'" data-url="'+escAttr(item.url)+'"';
      h+=' data-hover_text="'+escAttr(item.hover_text||'')+'" data-is_enabled="'+item.is_enabled+'">';
      h+='<td style="text-align:center;color:var(--dim)">'+item.display_order+'</td>';
      h+='<td style="text-align:center">'+iconHtml+'</td>';
      h+='<td>'+esc(item.platform_name)+'</td>';
      h+='<td><span style="font-size:11px;color:var(--muted);word-break:break-all">'+esc(item.url)+'</span></td>';
      h+='<td style="font-size:11px">'+esc(item.hover_text||'-')+'</td>';
      h+='<td><span class="bdg '+enableCls+'">'+enableIcon+'</span></td>';
      h+='<td style="display:flex;gap:4px"><button class="btn bo bs" onclick="smEditForm('+item.id+')">编辑</button><button class="btn bo bs" style="color:#f85149" onclick="smDelete('+item.id+',\''+escAttr(item.platform_name)+'\')">删除</button></td>';
      h+='</tr>';
    });
    h+='</table>';
    ct.insertAdjacentHTML("beforeend",'<div id="sm-list">'+h+'</div>');
  }).catch(function(){var ld=document.getElementById("sm-loader");if(ld)ld.remove()});
}
function smShowAddForm(){
  var fm=document.getElementById("sm-form");if(fm)fm.remove();
  var h='<div id="sm-form" class="cd" style="margin-top:12px;padding:16px;background:var(--bg2);border-radius:8px;border:1px solid var(--accent)">';
  h+='<div class="st" style="margin-bottom:12px">新增社交媒体</div>';
  h+='<div class="fl"><span style="width:80px;font-size:12px">平台名称</span><input class="in" id="sf-platform_name" style="width:200px" placeholder="如：微信"></div>';
  h+='<div class="fl"><span style="width:80px;font-size:12px">图标类型</span><select class="in" id="sf-icon_type" style="width:200px" onchange="smToggleIconInput()"><option value="svg">SVG</option><option value="url">URL图片</option></select></div>';
  h+='<div class="fl"><span style="width:80px;font-size:12px">图标内容</span><input class="in" id="sf-icon_value" style="width:400px" placeholder="SVG代码或图片URL"></div>';
  h+='<div class="fl"><span style="width:80px;font-size:12px">链接 URL</span><input class="in" id="sf-url" style="width:400px" placeholder="https://"></div>';
  h+='<div class="fl"><span style="width:80px;font-size:12px">Hover 文字</span><input class="in" id="sf-hover_text" style="width:200px" placeholder="悬停提示"></div>';
  h+='<div class="fl"><span style="width:80px;font-size:12px">启用</span><label style="font-size:12px"><input type="checkbox" id="sf-is_enabled" checked> 启用</label></div>';
  h+='<div style="margin-top:12px;display:flex;gap:8px"><button class="btn bp" onclick="smSubmitCreate()">创建</button><button class="btn bo" onclick="smCancelForm()">取消</button></div>';
  h+='</div>';
  var ref=document.getElementById("sm-list")||document.getElementById("sm-loader");
  if(ref){ref.insertAdjacentHTML("beforebegin",h)}else{var ct=document.getElementById("config-tab-content");ct.insertAdjacentHTML("beforeend",h)}
}
function smEditForm(id){
  var row=document.getElementById("sm-row-"+id);if(!row)return;
  var fm=document.getElementById("sm-form");if(fm)fm.remove();
  var d=row.dataset;
  var h='<div id="sm-form" class="cd" style="margin-top:12px;padding:16px;background:var(--bg2);border-radius:8px;border:1px solid var(--accent)">';
  h+='<div class="st" style="margin-bottom:12px">编辑 '+esc(d.platform_name)+'</div>';
  h+='<input type="hidden" id="sf-edit-id" value="'+id+'">';
  h+='<div class="fl"><span style="width:80px;font-size:12px">平台名称</span><input class="in" id="sf-platform_name" style="width:200px" value="'+escAttr(d.platform_name)+'"></div>';
  h+='<div class="fl"><span style="width:80px;font-size:12px">图标类型</span><select class="in" id="sf-icon_type" style="width:200px" onchange="smToggleIconInput()"><option value="svg"'+(d.icon_type==='svg'?' selected':'')+'>SVG</option><option value="url"'+(d.icon_type==='url'?' selected':'')+'>URL图片</option></select></div>';
  h+='<div class="fl"><span style="width:80px;font-size:12px">图标内容</span><input class="in" id="sf-icon_value" style="width:400px" value="'+escAttr(d.icon_value)+'"></div>';
  h+='<div class="fl"><span style="width:80px;font-size:12px">链接 URL</span><input class="in" id="sf-url" style="width:400px" value="'+escAttr(d.url)+'"></div>';
  h+='<div class="fl"><span style="width:80px;font-size:12px">Hover 文字</span><input class="in" id="sf-hover_text" style="width:200px" value="'+escAttr(d.hover_text)+'"></div>';
  h+='<div class="fl"><span style="width:80px;font-size:12px">启用</span><label style="font-size:12px"><input type="checkbox" id="sf-is_enabled"'+(d.is_enabled==='1'?' checked':'')+'> 启用</label></div>';
  h+='<div style="margin-top:12px;display:flex;gap:8px"><button class="btn bp" onclick="smSubmitUpdate('+id+')">保存</button><button class="btn bo" onclick="smCancelForm()">取消</button></div>';
  h+='</div>';
  var ref=document.getElementById("sm-list");
  if(ref){ref.insertAdjacentHTML("beforebegin",h)}else{var ct=document.getElementById("config-tab-content");ct.insertAdjacentHTML("beforeend",h)}
}
function smToggleIconInput(){
  var sel=document.getElementById("sf-icon_type");if(!sel)return;
  var inp=document.getElementById("sf-icon_value");if(!inp)return;
  if(sel.value==='url'){inp.placeholder='图片URL (如 https://...)'}else{inp.placeholder='SVG代码'}
}
function smCancelForm(){var fm=document.getElementById("sm-form");if(fm)fm.remove()}
function smSubmitCreate(){
  var d={platform_name:document.getElementById("sf-platform_name").value.trim(),icon_type:document.getElementById("sf-icon_type").value,icon_value:document.getElementById("sf-icon_value").value.trim(),url:document.getElementById("sf-url").value.trim(),hover_text:document.getElementById("sf-hover_text").value.trim(),is_enabled:document.getElementById("sf-is_enabled").checked};
  if(!d.platform_name||!d.icon_value||!d.url){alert("平台名、图标和链接为必填项");return}
  fetch("/admin/social-media",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(d)})
  .then(function(r){return r.json()}).then(function(d){if(d.success){smCancelForm();smRefresh()}else{alert(d.error||"创建失败")}})
  .catch(function(){alert("请求失败")});
}
function smSubmitUpdate(id){
  var d={platform_name:document.getElementById("sf-platform_name").value.trim(),icon_type:document.getElementById("sf-icon_type").value,icon_value:document.getElementById("sf-icon_value").value.trim(),url:document.getElementById("sf-url").value.trim(),hover_text:document.getElementById("sf-hover_text").value.trim(),is_enabled:document.getElementById("sf-is_enabled").checked};
  if(!d.platform_name||!d.icon_value||!d.url){alert("平台名、图标和链接为必填项");return}
  fetch("/admin/social-media/"+id,{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(d)})
  .then(function(r){return r.json()}).then(function(d){if(d.success){smCancelForm();smRefresh()}else{alert(d.error||"更新失败")}})
  .catch(function(){alert("请求失败")});
}
function smDelete(id,name){
  if(!confirm("确定删除「"+name+"」？"))return;
  fetch("/admin/social-media/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}})
  .then(function(r){return r.json()}).then(function(d){if(d.success){smRefresh()}else{alert(d.error||"删除失败")}})
  .catch(function(){alert("请求失败")});
}
// ── Social Media Icons (platform-based) ──
var PLATFORMS={
  wechat:{label:'微信',svg:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><circle cx="9" cy="10" r="1" fill="currentColor"/><circle cx="15" cy="10" r="1" fill="currentColor"/></svg>'},
  weibo:{label:'微博',svg:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M8 10c1-1 3-1 4 0M7 14c1 2 3 3 5 3s4-1 5-3M15 5c2 .5 3 2 3 2"/></svg>'},
  douyin:{label:'抖音',svg:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18V5l12-1v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>'},
  github:{label:'GitHub',svg:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.73c-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.1-1.46-1.1-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02.8-.22 1.65-.33 2.5-.33s1.7.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>'},
  x:{label:'X / Twitter',svg:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4l16 16M20 4L4 20"/></svg>'},
  telegram:{label:'Telegram',svg:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>'},
  bilibili:{label:'B站',svg:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 4l-2 3M15 4l2 3"/><circle cx="12" cy="12" r="2"/><path d="M12 14v2"/></svg>'},
  zhihu:{label:'知乎',svg:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 16v.01"/><path d="M9 10a3 3 0 1 1 3 3v1"/></svg>'},
  xiaohongshu:{label:'小红书',svg:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 8l9 6 9-6"/></svg>'},
  linkedin:{label:'领英',svg:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M6 9v7M6 6v.01M10 16v-5"/><path d="M14 16v-3a2 2 0 0 1 4 0v3M10 11v5"/></svg>'}
};

function loadSocLinks(){
  fetch("/admin/social-links",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    var el=document.getElementById("cl");
    var items=d.data||[];
    var added={};
    items.forEach(function(s){if(s.platform)added[s.platform]=true});
    var h='<div class="cd" style="margin-top:12px"><div class="st">社媒管理</div>';
    h+='<div style="margin-bottom:10px"><div style="font-size:11px;color:var(--dim);margin-bottom:6px">点击添加</div>';
    h+='<div style="display:flex;flex-wrap:wrap;gap:6px">';
    for(var pk in PLATFORMS){
      if(added[pk])continue;
      var p=PLATFORMS[pk];
      h+='<div data-pk="'+escAttr(pk)+'" onclick="socAddPlatform(this)" style="cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;padding:8px;border-radius:6px;border:1px solid var(--border);background:var(--bg-elevated);width:56px" onmouseover="this.style.borderColor=\'var(--accent)\'" onmouseout="this.style.borderColor=\'var(--border)\'">'
        +'<span style="width:22px;height:22px;color:var(--dim)">'+p.svg+'</span>'
        +'<span style="font-size:9px;color:var(--dim)">'+p.label+'</span></div>';
    }
    h+='</div></div>';
    h+='<div id="socList">';
    items.forEach(function(s){
      var pk=s.platform||'';
      var pkg=pk&&PLATFORMS[pk]?PLATFORMS[pk]:null;
      var iconHtml=pkg
        ?'<span style="width:20px;height:20px;display:inline-block;vertical-align:middle;color:var(--text)">'+pkg.svg+'</span>'
        :(s.icon_url
          ?'<img src="'+escAttr(s.icon_url)+'" style="width:20px;height:20px;border-radius:3px" onerror="this.style.display=\'none\'">'
          :'<span style="width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:10px;color:var(--dim);border-radius:3px;background:var(--bg-elevated)">?</span>');
      h+='<div class="socRow" style="display:flex;align-items:center;gap:8px;padding:6px 8px;margin-bottom:4px;border-radius:6px;border:1px solid var(--border)">';
      h+=iconHtml;
      h+='<span style="font-size:12px;min-width:50px;color:var(--text)">'+(pkg?pkg.label:esc(s.name))+'</span>';
      h+='<input class="in" id="socUrl-'+s.id+'" value="'+escAttr(s.url)+'" placeholder="链接 URL" style="flex:1;min-width:100px;font-size:11px">';
      h+='<label style="font-size:11px;color:var(--dim);white-space:nowrap"><input type="checkbox" id="socAct-'+s.id+'" '+(s.is_active?'checked':'')+' onchange="socToggle('+s.id+')"> 显示</label>';
      h+='<button class="btn bo bs" data-id="'+s.id+'" data-label="'+escAttr(pkg?pkg.label:s.name)+'" onclick="socDelete(this)" style="font-size:10px;padding:2px 6px;color:#f85149">删除</button>';
      h+='</div>';
    });
    h+='</div></div>';
    el.innerHTML+=h;
    items.forEach(function(s){
      var inp=document.getElementById("socUrl-"+s.id);
      if(inp)inp.onblur=function(){socSaveUrl(s.id)};
    });
  }).catch(function(){})
}
function socAddPlatform(el){
  var pk=el.getAttribute("data-pk");
  var p=PLATFORMS[pk];if(!p)return;
  fetch("/admin/social-links",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
    body:JSON.stringify({name:p.label,url:"#",icon_url:"",platform:pk})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){loadSocLinks()}else{alert(d.error||"添加失败")}
  })
}
function socSaveUrl(id){
  var url=document.getElementById("socUrl-"+id).value.trim()||"#";
  fetch("/admin/social-links/"+id,{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
    body:JSON.stringify({url:url})}).then(function(r){return r.json()}).then(function(d){
    if(!d.success)alert(d.error||"保存失败")
  })
}
function socToggle(id){
  var act=document.getElementById("socAct-"+id).checked?1:0;
  fetch("/admin/social-links/"+id,{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
    body:JSON.stringify({is_active:act})}).then(function(r){return r.json()}).then(function(d){
    if(!d.success)alert(d.error||"保存失败")
  })
}
function socDelete(el){
  var id=parseInt(el.getAttribute("data-id"));
  var label=el.getAttribute("data-label");
  if(!confirm("删除 "+label+"？"))return;
  fetch("/admin/social-links/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){loadSocLinks()}else{alert(d.error||"删除失败")}
  })
}
function scfg(k){
  var v=document.getElementById("cf-"+k).value.trim();
  if(!v)return;
  fetch("/user/config",{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({key:k,value:v})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){alert("保存成功");loadConfigs()}else{alert(d.error||"保存失败")}
  }).catch(function(){alert("保存失败")})
}
function seedConfig(){
  if(!confirm("初始化所有邮箱/短信配置项（已有项不会被覆盖）？"))return;
  fetch("/user/config/seed",{method:"POST",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){alert(d.message);loadConfigs()}else{alert(d.error||"初始化失败")}
  })
}
function uploadConfig(){
  document.getElementById("csvFile").click();
}
function doUpload(){
  var file=document.getElementById("csvFile").files[0];
  if(!file)return;
  var fd=new FormData();fd.append("file",file);
  fetch("/user/config/upload",{method:"POST",headers:{"Authorization":"Bearer "+T},body:fd}).then(function(r){return r.json()}).then(function(d){
    if(d.success){alert(d.message+" ("+d.access_key_prefix+")");loadConfigs()}else{alert(d.error||"导入失败")}
  }).catch(function(){alert("上传失败")});
  document.getElementById("csvFile").value="";
}

window.l_logs=function(){
  document.getElementById("pt").textContent="操作日志";
  fetch("/admin/logs",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    var h="<div class=\"cd\"><div class=\"st\">审计日志</div><table><tr><th>管理员</th><th>操作</th><th>目标</th><th>详情</th><th>IP</th><th>时间</th></tr>";
    d.data.forEach(function(l){h+="<tr><td>"+(l.admin_name||"-")+"</td><td>"+l.action+"</td><td>"+l.target_type+"/"+l.target_id+"</td><td>"+(l.detail||"")+"</td><td>"+l.ip_address+"</td><td>"+l.created_at+"</td></tr>"});
    h+="</table></div>";
    document.getElementById("mc").innerHTML=h;
  }).catch(function(){})
}

window.l_matrix=function(){
  document.getElementById("pt").textContent="Agent 矩阵";
  var mc=document.getElementById("mc");
  mc.innerHTML='<div class="lo"><div class="s"></div>加载矩阵数据...</div>';
  fetch("/admin/agent-matrix/dashboard",{headers:{"Authorization":"Bearer "+T}})
    .then(function(r){return r.json()})
    .then(function(d){
      if(!d.success){mc.innerHTML='<div class="em">加载失败</div>';return}
      var dat=d.data;
      var stats=dat.stats;
      var agents=dat.active_agents;
      var recent=dat.recent_tasks;
      var master=agents.filter(function(a){return a.role_type=="master"});
      var subs=agents.filter(function(a){return a.role_type=="sub"});
      var h='';

      // Stats cards
      h+='<div class="gr">';
      h+=sc("🧠","Agent",stats.agents.active+"/"+stats.agents.total);
      h+=sc("📋","总任务",stats.tasks.total);
      h+=sc("✅","成功率",stats.tasks.success_rate+"%");
      h+=sc("⚡","今日",stats.tasks.today);
      h+='</div>';

      // Master Agent card
      if(master.length){
        var ma=master[0];
        h+='<div class="cd" style="margin-bottom:12px;border-color:rgba(0,212,170,.3)">';
        h+='<div style="display:flex;justify-content:space-between;align-items:center">';
        h+='<div class="st" style="border:none;margin:0;padding:0">🤖 主 Agent: '+ma.name+' <span class="bdg on">运行中</span></div>';
        h+='<div style="display:flex;gap:6px">';
        h+='<button class="btn bo bs" onclick="l_matrix()">刷新</button>';
        h+='<button class="btn bo bs" onclick="matEditAgent('+ma.id+')">✏️ 编辑</button>';
        h+='<button class="btn bo bs" onclick="matAIServices()">🤖 AI服务</button>';
        h+='<button class="btn bp bs" onclick="go(\'ai_chat\')">💬 AI 对话</button>';
        h+='</div></div>';
        h+='<div style="font-size:11px;color:var(--muted);margin-top:4px">'+ma.description+'</div>';
        h+='<div style="font-size:11px;color:var(--dim);margin-top:2px">'+ma.provider+'/'+ma.model_name+' | 任务: '+ma.tasks_total+' | 成功率: '+(ma.tasks_total?(Math.round(ma.tasks_success/ma.tasks_total*100)):'0')+'%</div>';
        h+='</div>';
      }

      // Sub Agents
      h+='<div class="cd">';
      h+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">';
      h+='<div class="st" style="border:none;margin:0;padding:0">🧠 智能体矩阵 ('+subs.length+')</div>';
      h+='<button class="btn bp bs" onclick="matNewSub()">+ 创建智能体</button>';
      h+='</div>';
      h+='<div id="matNewForm" style="display:none"></div>';
      if(subs.length){
        h+='<table><tr><th>名称</th><th>领域</th><th>管辖模块</th><th>模型</th><th>任务</th><th>状态</th><th>操作</th></tr>';
        subs.forEach(function(a){
          var modules='';
          try{modules=JSON.parse(a.managed_modules||'[]').join(", ")}catch(e){}
          var st=a.is_active?'<span class="bdg on">活跃</span>':'<span class="bdg off">停用</span>';
          var sr=a.tasks_total?Math.round(a.tasks_success/a.tasks_total*100)+'%':'—';
          h+='<tr><td>'+esc(a.name)+'</td><td>'+esc(a.domain)+'</td><td style="max-width:200px;overflow:hidden;text-overflow:ellipsis">'+esc(modules)+'</td><td>'+esc(a.model_name)+'</td><td>'+a.tasks_total+' ('+sr+')</td><td>'+st+'</td><td>';
          h+=matTgBtn(a);
          h+=matEditBtn(a);
          h+=matTestBtn(a);
          h+='</td></tr>';
        });
        h+='</table>';
      }else{
        h+='<div class="em">暂无子 Agent，点击「+ 创建智能体」创建</div>';
      }
      h+='</div>';

      // Recent tasks
      if(recent&&recent.length){
        h+='<div class="cd" style="margin-top:12px">';
        h+='<div class="st">最近任务</div>';
        h+='<table><tr><th>任务ID</th><th>标题</th><th>执行者</th><th>状态</th><th>置信度</th></tr>';
        recent.forEach(function(t){
          var ic=t.status=="completed"?"✅":t.status=="failed"?"❌":t.status=="running"?"🔄":"⏳";
          h+='<tr><td style="font-size:10px;color:var(--dim)">'+esc(t.task_id||"")+'</td><td>'+esc(t.title||"").slice(0,30)+'</td><td>'+(t.target_name||"")+'</td><td>'+ic+' '+esc(t.status)+'</td><td>'+(t.confidence||"—")+'</td></tr>';
        });
        h+='</table></div>';
      }

      mc.innerHTML=h;
    }).catch(function(){
      mc.innerHTML='<div class="em">连接失败，请确认服务已启动</div>';
    });
};

// =============================================
// AI 对话 — 独立 Athena 全页面会话（从矩阵页面拆分）
// =============================================
window.l_ai_chat=function(){
  document.getElementById("pt").textContent="AI 对话 — Athena";
  var mc=document.getElementById("mc");
  mc.innerHTML='<div class="lo"><div class="s"></div>加载对话...</div>';
  var h='';

  // Stats summary
  h+='<div class="cd" style="margin-bottom:12px;border-color:rgba(0,212,170,.3)">';
  h+='<div style="display:flex;justify-content:space-between;align-items:center">';
  h+='<div class="st" style="border:none;margin:0;padding:0">🤖 主 Agent: Athena <span class="bdg on">运行中</span></div>';
  h+='<button class="btn bo bs" onclick="l_ai_chat()">🔄 刷新</button>';
  h+='</div></div>';

  // Session controls
  h+='<div style="display:flex;gap:6px;margin-bottom:8px;flex-wrap:wrap">';
  h+='<button class="btn bo bs" id="aiBtnFast" style="font-size:11px;padding:3px 10px;border-color:var(--accent);background:rgba(0,245,255,0.1)" onclick="aiSetMode(\'fast\')">⚡ 快速</button>';
  h+='<button class="btn bo bs" id="aiBtnDeep" style="font-size:11px;padding:3px 10px" onclick="aiSetMode(\'deep\')">🧠 深度思考</button>';
  h+='<button class="btn bo bs" id="aiBtnImage" style="font-size:11px;padding:3px 10px" onclick="aiSetMode(\'image\')">🎨 图像处理</button>';
  h+='<span style="flex:1"></span>';
  h+='<button class="btn bo bs" style="font-size:11px;padding:3px 10px" onclick="aiNewSession()">🆕 新建会话</button>';
  h+='<button class="btn bo bs" style="font-size:11px;padding:3px 10px;color:#f85149" onclick="aiResetSession()">🔄 重置</button>';
  h+='</div>';

  // Chat messages area
  h+='<div id="aiChatMsgs" style="min-height:300px;max-height:420px;overflow-y:auto;margin-bottom:8px;padding:8px;background:rgba(0,0,0,.2);border-radius:6px;font-size:12px;line-height:1.6">';
  h+='<div style="color:var(--dim);text-align:center;padding:20px">💬 发送指令开始与 Athena 对话</div>';
  h+='</div>';

  // Input area
  h+='<div style="display:flex;gap:4px;margin-bottom:12px">';
  h+='<input type="file" id="aiFileInput" style="display:none" onchange="aiUpload(this)">';
  h+='<button class="btn bo bs" onclick="document.getElementById(\'aiFileInput\').click()" title="上传文件(图片/文档)" style="font-size:14px;padding:3px 8px">📎</button>';
  h+='<textarea class="in" id="aiChatInput" placeholder="输入指令，例如「帮我发一篇CMS文章」" style="flex:1;font-size:12px;resize:none;min-height:36px;max-height:120px;line-height:1.4;padding-top:8px;padding-bottom:8px" onkeydown="if(event.key===\'Enter\'&&!event.ctrlKey&&!event.shiftKey){event.preventDefault();aiSend()}" oninput="aiAutoResize(this)"></textarea>';
  h+='<button class="btn bp" onclick="aiSend()">发送</button>';
  h+='</div>';

  // Session history
  h+='<div class="cd">';
  h+='<div class="st">💬 对话历史</div>';
  h+='<div style="display:flex;gap:4px;margin-bottom:6px">';
  h+='<input class="in" id="aiSearchInput" placeholder="搜索关键词..." style="flex:1;font-size:11px;padding:4px 6px" onkeydown="if(event.key===\'Enter\')aiSearchSessions()">';
  h+='<button class="btn bo bs" style="font-size:10px;padding:2px 6px" onclick="aiSearchSessions()">🔍 搜索</button>';
  h+='<button class="btn bo bs" style="font-size:10px;padding:2px 6px;color:#f85149" onclick="aiBatchDelete()">🗑️ 批量删除</button>';
  h+='</div>';
  h+='<div id="aiSessions"><div class="lo"><div class="s"></div></div></div>';
  h+='</div>';

  mc.innerHTML=h;

  // Load session history
  fetch("/admin/agent-matrix/chat/history",{headers:{"Authorization":"Bearer "+T}})
    .then(function(r){return r.json()})
    .then(function(d){
      if(!d.success||!d.data)return;
      var sl=d.data;
      var el=document.getElementById("aiSessions");
      if(!el)return;
      if(!sl.length){el.innerHTML='<div class="em">暂无对话历史</div>';return}
      var sh='<table><tr><th style="width:30px"><input type="checkbox" id="aiSelAll" onchange="aiToggleAll(this)"></th><th>会话标题</th><th>最后时间</th><th>操作</th></tr>';
      sl.forEach(function(s){
        var title=s.session_name||s.first_query||s.session_id;
        sh+='<tr onclick="aiLoadSession(this.dataset.sid)" data-sid="'+esc(s.session_id)+'" style="cursor:pointer">';
        sh+='<td style="width:30px;text-align:center" onclick="event.stopPropagation()"><input type="checkbox" class="aiSel" value="'+esc(s.session_id)+'"></td>';
        sh+='<td>'+esc(title.slice(0,50))+'</td>';
        sh+='<td style="font-size:10px;color:var(--dim)">'+esc(s.last_msg||"")+'</td>';
        sh+='<td style="width:40px" onclick="event.stopPropagation()"><button class="btn bs" style="font-size:10px;padding:1px 4px" onclick="aiDeleteSession(this)">🗑️</button></td></tr>';
      });
      sh+='</table>';
      el.innerHTML=sh;
    }).catch(function(){});
};

// ── AI Chat helper functions ──
var aiMode="fast";
var aiSessionId="";
var aiUploadedFiles=[];

function aiSetMode(m){
  aiMode=m;
  ["aiBtnFast","aiBtnDeep","aiBtnImage"].forEach(function(id){
    var b=document.getElementById(id);
    if(b){b.style.borderColor="";b.style.background=""}
  });
  var btn=document.getElementById("aiBtn"+m.charAt(0).toUpperCase()+m.slice(1));
  if(btn){btn.style.borderColor="var(--accent)";btn.style.background="rgba(0,245,255,0.1)"}
}

function aiNewSession(){
  aiSessionId="";
  aiUploadedFiles=[];
  var msgs=document.getElementById("aiChatMsgs");
  if(msgs)msgs.innerHTML='<div style="color:var(--dim);text-align:center;padding:20px">🆕 新会话已创建，发送指令开始对话</div>';
  fetch("/admin/agent-matrix/chat/history",{headers:{"Authorization":"Bearer "+T}})
    .then(function(r){return r.json()}).then(function(d){
      if(!d.success||!d.data)return;
      var el=document.getElementById("aiSessions");
      if(!el)return;
      var sl=d.data;
      if(!sl.length){el.innerHTML='<div class="em">暂无对话历史</div>';return}
      var sh='<table><tr><th style="width:30px"><input type="checkbox" id="aiSelAll" onchange="aiToggleAll(this)"></th><th>会话标题</th><th>最后时间</th><th>操作</th></tr>';
      sl.forEach(function(s){
        var title=s.session_name||s.first_query||s.session_id;
        sh+='<tr onclick="aiLoadSession(this.dataset.sid)" data-sid="'+esc(s.session_id)+'" style="cursor:pointer">';
        sh+='<td style="width:30px;text-align:center" onclick="event.stopPropagation()"><input type="checkbox" class="aiSel" value="'+esc(s.session_id)+'"></td>';
        sh+='<td>'+esc(title.slice(0,50))+'</td>';
        sh+='<td style="font-size:10px;color:var(--dim)">'+esc(s.last_msg||"")+'</td>';
        sh+='<td style="width:40px" onclick="event.stopPropagation()"><button class="btn bs" style="font-size:10px;padding:1px 4px" onclick="aiDeleteSession(this)">🗑️</button></td></tr>';
      });
      sh+='</table>';
      el.innerHTML=sh;
    }).catch(function(){});
}

function aiResetSession(){
  if(!aiSessionId){aiNewSession();return}
  if(!confirm("确定重置当前会话？所有消息将被清除。"))return;
  fetch("/admin/agent-matrix/chat/"+encodeURIComponent(aiSessionId)+"/clear",{
    method:"POST",
    headers:{"Authorization":"Bearer "+T}
  }).then(function(r){return r.json()}).then(function(d){
    aiNewSession();
  }).catch(function(){aiNewSession();});
}

function aiDeleteSession(btn){
  var sid=btn.closest('tr').dataset.sid;
  if(!sid||!confirm("确定删除此会话历史？"))return;
  fetch("/admin/agent-matrix/chat/"+encodeURIComponent(sid)+"/clear",{
    method:"POST",
    headers:{"Authorization":"Bearer "+T}
  }).then(function(r){return r.json()}).then(function(d){
    if(d&&d.success){aiNewSession()}
    else{alert("删除失败: "+(d&&d.error||"未知错误"))}
  }).catch(function(){alert("网络错误")});
}

function aiToggleAll(cb){
  var chks=document.querySelectorAll(".aiSel");
  chks.forEach(function(c){c.checked=cb.checked});
}

function aiSearchSessions(){
  var q=document.getElementById("aiSearchInput").value.trim();
  if(!q||q.length<2){alert("关键词至少 2 个字符");return}
  fetch("/admin/agent-matrix/chat/search?q="+encodeURIComponent(q),{
    headers:{"Authorization":"Bearer "+T}
  }).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    var el=document.getElementById("aiSessions");
    if(!el)return;
    var rows=d.data;
    if(!rows.length){el.innerHTML='<div class="em">未找到含 「'+esc(q)+'」 的消息</div>';return}
    var sh='<table><tr><th style="width:30px"></th><th>内容</th><th>会话</th><th>时间</th></tr>';
    rows.forEach(function(r){
      var title=r.session_name||r.session_id;
      var excerpt=(r.content||"").slice(0,100);
      sh+='<tr onclick="aiLoadSession(this.dataset.sid)" data-sid="'+esc(r.session_id)+'" style="cursor:pointer">';
      sh+='<td style="width:30px;text-align:center">'+(r.role=='user'?'👤':'🤖')+'</td>';
      sh+='<td>'+esc(excerpt)+'</td>';
      sh+='<td style="font-size:10px;color:var(--dim)">'+esc(title.slice(0,30))+'</td>';
      sh+='<td style="font-size:10px;color:var(--dim)">'+esc(r.created_at||"")+'</td></tr>';
    });
    sh+='</table><div style="margin-top:6px;font-size:10px;color:var(--dim)">找到 '+rows.length+' 条匹配消息，点击行跳转会话</div>';
    el.innerHTML=sh;
  }).catch(function(){});
}

function aiBatchDelete(){
  var chks=document.querySelectorAll(".aiSel:checked");
  var ids=[];
  chks.forEach(function(c){ids.push(c.value)});
  if(!ids.length){alert("请先勾选要删除的会话");return}
  if(!confirm("确定批量删除 "+ids.length+" 个会话？此操作不可恢复。"))return;
  fetch("/admin/agent-matrix/chat/batch-delete",{
    method:"POST",
    headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
    body:JSON.stringify({session_ids:ids})
  }).then(function(r){return r.json()}).then(function(d){
    if(d&&d.success){aiNewSession()}
    else{alert("删除失败: "+(d&&d.error||"未知错误"))}
  }).catch(function(){alert("网络错误")});
}

function aiAutoResize(el){
  el.style.height="auto";
  el.style.height=Math.min(el.scrollHeight,120)+"px";
}

function aiUpload(input){
  var file=input.files[0];
  if(!file)return;
  var msgs=document.getElementById("aiChatMsgs");
  var uploadMsgId="aiUploadMsg_"+Date.now();
  msgs.innerHTML+='<div style="color:var(--dim);margin:4px 0;font-size:11px" id="'+uploadMsgId+'">📎 上传 '+esc(file.name)+' ('+Math.round(file.size/1024)+'KB)...</div>';
  msgs.scrollTop=msgs.scrollHeight;
  var fd=new FormData();
  fd.append("file",file);
  fetch("/admin/agent-matrix/upload",{
    method:"POST",
    headers:{"Authorization":"Bearer "+T},
    body:fd
  }).then(function(r){return r.json()}).then(function(d){
    var el=document.getElementById(uploadMsgId);
    if(!el)return;
    if(!d.success){el.innerHTML='❌ 上传失败: '+esc(d.error||"未知错误");return}
    var u=d.data;
    el.innerHTML='📎 <a href="'+u.url+'" download target="_blank" style="color:var(--accent)">'+esc(u.original_name)+'</a> ('+u.size_display+')';
    aiUploadedFiles.push(u);
    if(file.type&&file.type.startsWith("image/")){
      el.innerHTML+='<br><img src="'+u.url+'" style="max-width:200px;max-height:120px;border-radius:4px;margin-top:4px;cursor:pointer" onclick="window.open(this.src)" alt="'+esc(u.original_name)+'">';
    }
  }).catch(function(){
    var el=document.getElementById(uploadMsgId);
    if(el)el.innerHTML='❌ 网络错误';
  });
  input.value="";
}

function aiSend(){
  var inp=document.getElementById("aiChatInput");
  var msg=inp.value.trim();
  if(!msg)return;
  inp.value="";
  var msgs=document.getElementById("aiChatMsgs");
  msgs.innerHTML+='<div style="color:var(--accent);margin:4px 0">👤 我: '+esc(msg)+'</div>';
  msgs.scrollTop=msgs.scrollHeight;
  msgs.innerHTML+='<div style="color:var(--muted)">🤖 Athena: 思考中...</div>';

  var body={message:msg,mode:aiMode};
  if(aiUploadedFiles.length){
    var fileCtx="\n\n[已上传文件]:\n";
    aiUploadedFiles.forEach(function(f,i){
      fileCtx+=(i+1)+". "+f.original_name+" → "+f.url+"\n";
    });
    body.message=msg+fileCtx;
    msgs.innerHTML+='<div style="color:var(--dim);margin:4px 0;font-size:11px">📎 已附 '+aiUploadedFiles.length+' 个文件作为参考</div>';
    aiUploadedFiles=[];
  }
  if(aiSessionId)body.session_id=aiSessionId;
  var modeNames={fast:"⚡快速",deep:"🧠深度思考",image:"🎨图像处理"};
  var modeLabel=modeNames[aiMode]||"快速";
  msgs.innerHTML=msgs.innerHTML.replace(
    '<div style="color:var(--muted)">🤖 Athena: 思考中...</div>',
    '<div style="color:var(--muted)">🤖 Athena ['+modeLabel+']: 思考中...</div>'
  );

  fetch("/admin/agent-matrix/chat",{
    method:"POST",
    headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
    body:JSON.stringify(body)
  }).then(function(r){return r.json()}).then(function(d){
    if(!d.success){
      msgs.innerHTML=msgs.innerHTML.replace('思考中...','<span style="color:#f85149">请求失败</span>');
      return;
    }
    if(d.data.session_id)aiSessionId=d.data.session_id;
    var summary=d.data.summary||"无响应";
    msgs.innerHTML=msgs.innerHTML.replace('思考中...','');
    var block='<div style="background:rgba(0,212,170,.05);border-left:2px solid var(--accent);padding:6px 8px;margin:4px 0;white-space:pre-wrap">'+esc(summary)+'</div>';
    var results=d.data.sub_task_results||[];
    for(var i=0;i<results.length;i++){
      var imgUrl=results[i].image_url;
      if(imgUrl)block+='<div style="margin:6px 0;text-align:center"><img src="'+imgUrl+'" style="max-width:100%;max-height:400px;border-radius:8px;border:1px solid rgba(255,255,255,.1)" onerror="this.style.display=\'none\'"></div>';
    }
    msgs.innerHTML+=block;
    msgs.scrollTop=msgs.scrollHeight;
  }).catch(function(){
    msgs.innerHTML=msgs.innerHTML.replace('思考中...','<span style="color:#f85149">网络错误</span>');
  });
}

function aiLoadSession(sid){
  aiSessionId=sid;
  fetch("/admin/agent-matrix/chat/"+encodeURIComponent(sid),{
    headers:{"Authorization":"Bearer "+T}
  }).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    var msgs=document.getElementById("aiChatMsgs");
    msgs.innerHTML="";
    d.data.forEach(function(m){
      var nm=esc(m.content||"");
      if(m.role=="user")msgs.innerHTML+='<div style="color:var(--accent);margin:4px 0">👤 我: '+nm+'</div>';
      else if(m.role=="master")msgs.innerHTML+='<div style="background:rgba(0,212,170,.05);border-left:2px solid var(--accent);padding:6px 8px;margin:4px 0;white-space:pre-wrap">🤖 Athena: '+nm+'</div>';
      else if(m.role=="sub")msgs.innerHTML+='<div style="color:var(--muted);margin:2px 0;font-size:11px">🔄 '+m.agent_name+': '+nm+'</div>';
      else if(m.role=="system")msgs.innerHTML+='<div style="color:var(--dim);margin:2px 0;font-size:11px">'+nm+'</div>';
    });
    msgs.scrollTop=msgs.scrollHeight;
  });
}

// =============================================

function fm(){return '<div id="cf" style="display:none;margin-bottom:16px" class="cd"><div class="st">创建 Agent（旧接口）</div>...旧功能已迁移</div>'}
function sc(ic,lb,vl){return '<div class="cd"><div class="l">'+ic+' '+lb+'</div><div class="v g">'+vl+'</div></div>'}
function esc(s){if(!s)return'';return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;")}

// Chat UI toggle
var matMode="fast";
var matSessionId="";
var matUploadedFiles=[];
function matChat(){
  var a=document.getElementById("matChatArea");
  a.style.display=a.style.display=="none"?"block":"none";
  if(a.style.display=="block"){document.getElementById("matChatInput").focus();matSetMode(matMode)}
}

// Set chat mode and highlight active button
function matSetMode(m){
  matMode=m;
  document.querySelectorAll("#matChatArea > div:first-child + div button").forEach(function(b){b.style.borderColor="";b.style.background=""});
  var btn=document.getElementById("matBtn"+m.charAt(0).toUpperCase()+m.slice(1));
  if(btn){btn.style.borderColor="var(--accent)";btn.style.background="rgba(0,245,255,0.1)"}
}

// New session — clear session and messages
function matNewSession(){
  matSessionId="";
  matUploadedFiles=[];
  var msgs=document.getElementById("matChatMsgs");
  if(msgs)msgs.innerHTML='<div style="color:var(--dim);text-align:center;padding:20px">🆕 新会话已创建，发送指令开始对话</div>';
  fetch("/admin/agent-matrix/chat/history",{headers:{"Authorization":"Bearer "+T}})
    .then(function(r){return r.json()}).then(function(d){
      if(!d.success||!d.data)return;
      var el=document.getElementById("matSessions");
      if(!el)return;
      var sl=d.data;
      if(!sl.length){el.innerHTML='<div class="em">暂无对话历史</div>';return}
      var sh='<table><tr><th>会话</th><th>第一条消息</th><th>最后时间</th></tr>';
      sl.forEach(function(s){
        sh+='<tr onclick="matLoadSession(this.dataset.sid)" data-sid="'+esc(s.session_id)+'" style="cursor:pointer">';
        sh+='<td style="font-size:10px;color:var(--dim)">'+esc(s.session_id)+'</td>';
        sh+='<td>'+esc((s.first_query||"").slice(0,40))+'</td>';
        sh+='<td style="font-size:10px;color:var(--dim)">'+esc(s.last_msg||"")+'</td></tr>';
      });
      sh+='</table>';
      el.innerHTML=sh;
    }).catch(function(){});
}

// Reset session — clear current session on server too
function matResetSession(){
  if(!matSessionId){matNewSession();return}
  if(!confirm("确定重置当前会话？所有消息将被清除。"))return;
  fetch("/admin/agent-matrix/chat/"+encodeURIComponent(matSessionId)+"/clear",{
    method:"POST",
    headers:{"Authorization":"Bearer "+T}
  }).then(function(r){return r.json()}).then(function(d){
    matNewSession();
  }).catch(function(){
    matNewSession();
  });
}

// Auto-resize textarea
function matAutoResize(el){
  el.style.height="auto";
  el.style.height=Math.min(el.scrollHeight,120)+"px";
}

// Upload file to temp storage
function matUpload(input){
  var file=input.files[0];
  if(!file)return;
  var msgs=document.getElementById("matChatMsgs");
  var uploadMsgId="matUploadMsg_"+Date.now();
  msgs.innerHTML+='<div style="color:var(--dim);margin:4px 0;font-size:11px" id="'+uploadMsgId+'">📎 上传 '+esc(file.name)+' ('+Math.round(file.size/1024)+'KB)...</div>';
  msgs.scrollTop=msgs.scrollHeight;
  var fd=new FormData();
  fd.append("file",file);
  fetch("/admin/agent-matrix/upload",{
    method:"POST",
    headers:{"Authorization":"Bearer "+T},
    body:fd
  }).then(function(r){return r.json()}).then(function(d){
    var el=document.getElementById(uploadMsgId);
    if(!el)return;
    if(!d.success){
      el.innerHTML='❌ 上传失败: '+esc(d.error||"未知错误");
      return;
    }
    var u=d.data;
    el.innerHTML='📎 <a href="'+u.url+'" download target="_blank" style="color:var(--accent)">'+esc(u.original_name)+'</a> ('+u.size_display+')';
    matUploadedFiles.push(u);
    // 如果是图片，显示缩略图
    if(file.type&&file.type.startsWith("image/")){
      el.innerHTML+='<br><img src="'+u.url+'" style="max-width:200px;max-height:120px;border-radius:4px;margin-top:4px;cursor:pointer" onclick="window.open(this.src)" alt="'+esc(u.original_name)+'">';
    }
  }).catch(function(){
    var el=document.getElementById(uploadMsgId);
    if(el)el.innerHTML='❌ 网络错误';
  });
  input.value='';
}

// Send message to Master Agent
function matSend(){
  var inp=document.getElementById("matChatInput");
  var msg=inp.value.trim();
  if(!msg)return;
  inp.value="";
  var msgs=document.getElementById("matChatMsgs");
  msgs.innerHTML+='<div style="color:var(--accent);margin:4px 0">👤 我: '+esc(msg)+'</div>';
  msgs.scrollTop=msgs.scrollHeight;
  msgs.innerHTML+='<div style="color:var(--muted)">🤖 Athena: 思考中...</div>';

  var body={message:msg,mode:matMode};
  // 如果有已上传的文件，追加到消息中
  if(matUploadedFiles.length){
    var fileCtx="\n\n[已上传文件]:\n";
    matUploadedFiles.forEach(function(f,i){
      fileCtx+=(i+1)+". "+f.original_name+" → "+f.url+"\n";
    });
    body.message=msg+fileCtx;
    // 在聊天中显示上传的文件参考
    msgs.innerHTML+='<div style="color:var(--dim);margin:4px 0;font-size:11px">📎 已附 '+
      matUploadedFiles.length+' 个文件作为参考</div>';
    matUploadedFiles=[];
  }
  if(matSessionId)body.session_id=matSessionId;
  // Show mode indicator in thinking message
  var modeNames={fast:"⚡快速",deep:"🧠深度思考",image:"🎨图像处理"};
  var modeLabel=modeNames[matMode]||"快速";
  msgs.innerHTML=msgs.innerHTML.replace(
    '<div style="color:var(--muted)">🤖 Athena: 思考中...</div>',
    '<div style="color:var(--muted)">🤖 Athena ['+modeLabel+']: 思考中...</div>'
  );

  fetch("/admin/agent-matrix/chat",{
    method:"POST",
    headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
    body:JSON.stringify(body)
  }).then(function(r){return r.json()}).then(function(d){
    if(!d.success){
      msgs.innerHTML=msgs.innerHTML.replace('思考中...','<span style="color:#f85149">请求失败</span>');
      return;
    }
    if(d.data.session_id)matSessionId=d.data.session_id;
    var summary=d.data.summary||"无响应";
    msgs.innerHTML=msgs.innerHTML.replace('思考中...','');
    var block='<div style="background:rgba(0,212,170,.05);border-left:2px solid var(--accent);padding:6px 8px;margin:4px 0;white-space:pre-wrap">'+esc(summary)+'</div>';
    // 渲染子任务生成的图片到聊天界面
    var results=d.data.sub_task_results||[];
    for(var i=0;i<results.length;i++){
      var imgUrl=results[i].image_url;
      if(imgUrl)block+='<div style="margin:6px 0;text-align:center"><img src="'+imgUrl+'" style="max-width:100%;max-height:400px;border-radius:8px;border:1px solid rgba(255,255,255,.1)" onerror="this.style.display=\'none\'"></div>';
    }
    msgs.innerHTML+=block;
    msgs.scrollTop=msgs.scrollHeight;
  }).catch(function(){
    msgs.innerHTML=msgs.innerHTML.replace('思考中...','<span style="color:#f85149">网络错误</span>');
  });
}

// Load a past session
function matLoadSession(sid){
  matSessionId=sid;
  fetch("/admin/agent-matrix/chat/"+encodeURIComponent(sid),{
    headers:{"Authorization":"Bearer "+T}
  }).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    var msgs=document.getElementById("matChatMsgs");
    msgs.innerHTML='';
    d.data.forEach(function(m){
      var nm=esc(m.content||"");
      if(m.role=="user")msgs.innerHTML+='<div style="color:var(--accent);margin:4px 0">👤 我: '+nm+'</div>';
      else if(m.role=="master")msgs.innerHTML+='<div style="background:rgba(0,212,170,.05);border-left:2px solid var(--accent);padding:6px 8px;margin:4px 0;white-space:pre-wrap">🤖 Athena: '+nm+'</div>';
      else if(m.role=="sub")msgs.innerHTML+='<div style="color:var(--muted);margin:2px 0;font-size:11px">🔄 '+m.agent_name+': '+nm+'</div>';
      else if(m.role=="system")msgs.innerHTML+='<div style="color:var(--dim);margin:2px 0;font-size:11px">'+nm+'</div>';
    });
    msgs.scrollTop=msgs.scrollHeight;
    matChat();
  });
}

// Create new Sub Agent — 增强版（含提示词、多提供商）
function matNewSub(){
  var f=document.getElementById("matNewForm");
  if(f.style.display=="block"){f.style.display="none";return}
  f.style.display="block";
  var h='<div class="cd" style="margin-bottom:12px">';
  h+='<div class="st">+ 新增子 Agent <span style="font-size:10px;color:var(--dim);font-weight:400">｜<a href="javascript:matPromptHelp()" style="color:var(--accent)">📖 提示词管理说明</a></span></div>';
  h+='<div class="g2">';
  // Row 1: Name + Domain
  h+='<div><div style="font-size:11px;color:var(--dim)">名称 *</div><input class="in" id="matNewName" placeholder="如：CMS Agent" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">领域</div><input class="in" id="matNewDomain" placeholder="如：cms" style="width:100%"></div>';
  // Row 2: Description (full width)
  h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">描述</div><input class="in" id="matNewDesc" placeholder="职责描述" style="width:100%"></div>';
  // Row 3: Provider + Model
  h+='<div><div style="font-size:11px;color:var(--dim)">模型提供商</div>';
  h+='<select class="sl" id="matNewProv" onchange="matProvChange()" style="width:100%">';
  h+='<option value="dashscope">DashScope (通义千问 Qwen)</option>';
  h+='<option value="openai">OpenAI (GPT-4o / GPT-4)</option>';
  h+='<option value="deepseek">DeepSeek (DeepSeek-V3)</option>';
  h+='<option value="openrouter">OpenRouter (多模型聚合)</option>';
  h+='<option value="ollama">Ollama (本地部署开源模型)</option>';
  h+='</select></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">模型名称</div><input class="in" id="matNewModel" value="qwen-turbo" style="width:100%;font-size:11px"></div>';
  // Row 4: Base URL + API Key Ref (side by side)
  h+='<div><div style="font-size:11px;color:var(--dim)">API 端点 <span style="color:var(--muted);font-size:10px">自动填充</span></div>';
  h+='<input class="in" id="matNewBaseUrl" value="https://dashscope.aliyuncs.com/compatible-mode/v1" style="width:100%" autocomplete="off"></div>';
  // 隐藏假字段吸收浏览器自动填充
  h+='<input type="text" style="position:absolute;left:-9999px;width:1px;height:1px" tabindex="-1" autocomplete="username">';
  h+='<div><div style="font-size:11px;color:var(--dim)">API Key</div>';
  h+='<input type="password" class="in" id="matNewApiKey" placeholder="输入 API Key（保存后不可查看）" style="width:100%" autocomplete="new-password"></div>';
  // Row 5: Prompt Template Selector
  h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">System Prompt 模板 <span style="color:var(--muted);font-size:10px">（选择后自动填充，可在下方修改）</span></div>';
  h+='<select class="sl" id="matNewPromptTmpl" onchange="matPromptSelect()" style="width:100%">';
  h+='<option value="">— 选择模板（可选）—</option>';
  h+='</select></div>';
  // Row 6: System Prompt
  h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">System Prompt <span style="color:var(--muted);font-size:10px">（粘贴或编写提示词内容）</span></div>';
  h+='<textarea class="ta" id="matNewPrompt" rows="5" placeholder="编写此 Agent 的系统提示词（或选择上方模板）" style="width:100%;min-height:120px;font-family:monospace;font-size:11px"></textarea></div>';
  // Row 7: Managed Modules
  h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">管辖模块（逗号分隔）</div>';
  h+='<input class="in" id="matNewMods" placeholder="如：cms, comments, contentfactory" style="width:100%"></div>';
  h+='</div>'; // close g2
  h+='<div style="margin-top:10px;display:flex;gap:8px;align-items:center">';
  h+='<button class="btn bp" onclick="matCreate()">✅ 确认创建</button>';
  h+='<button class="btn bo" onclick="document.getElementById(\'matNewForm\').style.display=\'none\'">取消</button>';
  h+='</div></div>';
  f.innerHTML=h;
  // Load prompt templates
  matLoadPrompts();
}

// Load prompt templates from API
function matLoadPrompts(){
  var sel=document.getElementById("matNewPromptTmpl");
  if(!sel)return;
  fetch("/admin/agent-matrix/prompts",{headers:{"Authorization":"Bearer "+T}})
    .then(function(r){return r.json()})
    .then(function(d){
      if(!d.success||!d.data)return;
      d.data.forEach(function(p){
        var o=document.createElement("option");
        o.value=p.id;
        o.textContent=p.name+" — "+p.description.slice(0,60);
        sel.appendChild(o);
      });
    }).catch(function(){});
}

// On provider change, auto-fill base URL
function matProvChange(){
  var urls={
    dashscope:"https://dashscope.aliyuncs.com/compatible-mode/v1",
    openai:"https://api.openai.com/v1",
    deepseek:"https://api.deepseek.com",
    openrouter:"https://openrouter.ai/api/v1",
    ollama:"http://localhost:11434/v1"
  };
  var models={
    dashscope:"qwen-turbo",
    openai:"gpt-4o",
    deepseek:"deepseek-chat",
    openrouter:"openai/gpt-4o-mini",
    ollama:"llama3"
  };
  var p=document.getElementById("matNewProv").value;
  if(urls[p]){var el=document.getElementById("matNewBaseUrl");el.value=urls[p];el.selectionStart=el.selectionEnd=0}
  if(models[p]){var el2=document.getElementById("matNewModel");el2.value=models[p];el2.selectionStart=el2.selectionEnd=0}
}

// Edit form: on provider change, auto-fill base URL + model
function matEditProvChange(){
  var urls={
    dashscope:"https://dashscope.aliyuncs.com/compatible-mode/v1",
    openai:"https://api.openai.com/v1",
    deepseek:"https://api.deepseek.com",
    openrouter:"https://openrouter.ai/api/v1",
    ollama:"http://localhost:11434/v1"
  };
  var models={
    dashscope:"qwen-turbo",
    openai:"gpt-4o",
    deepseek:"deepseek-chat",
    openrouter:"openai/gpt-4o-mini",
    ollama:"llama3"
  };
  var p=document.getElementById("matEditProv").value;
  if(urls[p]){var el=document.getElementById("matEditBaseUrl");el.value=urls[p];el.selectionStart=el.selectionEnd=0}
  if(models[p]){var el2=document.getElementById("matEditModel");el2.value=models[p];el2.selectionStart=el2.selectionEnd=0}
}

// Edit form: load prompt templates
function matEditLoadPrompts(){
  var sel=document.getElementById("matEditPromptTmpl");
  if(!sel)return;
  fetch("/admin/agent-matrix/prompts",{headers:{"Authorization":"Bearer "+T}})
    .then(function(r){return r.json()})
    .then(function(d){
      if(!d.success||!d.data)return;
      d.data.forEach(function(p){
        var o=document.createElement("option");
        o.value=p.id;
        o.textContent=p.name+" — "+p.description.slice(0,60);
        sel.appendChild(o);
      });
    }).catch(function(){});
}

// Edit form: on template select, load prompt content
function matEditPromptSelect(){
  var sel=document.getElementById("matEditPromptTmpl");
  var ta=document.getElementById("matEditPrompt");
  if(!sel||!ta)return;
  var val=sel.value;
  if(!val||val=="custom")return;
  fetch("/admin/agent-matrix/prompts/load?path="+encodeURIComponent(val),{
    headers:{"Authorization":"Bearer "+T}
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success&&d.data)ta.value=d.data;
  }).catch(function(){});
}

// Clear API Key button handler
function matClearApiKey(){
  var el=document.getElementById("matEditApiKey");
  var btn=document.getElementById("matClearKeyBtn");
  if(el){el.value="__CLEAR__"}
  if(btn){btn.style.background="rgba(255,80,80,0.3)";btn.textContent="✓ 已标记清除"}
}

// On template select, load prompt content
function matPromptSelect(){
  var sel=document.getElementById("matNewPromptTmpl");
  var ta=document.getElementById("matNewPrompt");
  if(!sel||!ta)return;
  var val=sel.value;
  if(!val||val=="custom")return;
  // Load prompt file content via API
  fetch("/admin/agent-matrix/prompts/load?path="+encodeURIComponent(val),{
    headers:{"Authorization":"Bearer "+T}
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success&&d.data)ta.value=d.data;
  }).catch(function(){});
}

// API: create Sub Agent
function matCreate(){
  var name=document.getElementById("matNewName").value.trim();
  if(!name){alert("请输入名称");return}
  var mods=document.getElementById("matNewMods").value.trim();
  var modules=mods?mods.split(",").map(function(s){return s.trim()}):[];
  var prompt=document.getElementById("matNewPrompt").value.trim();
  var tmpl=document.getElementById("matNewPromptTmpl").value;
  var body={
    name:name,
    role_type:"sub",
    domain:document.getElementById("matNewDomain").value.trim()||"general",
    description:document.getElementById("matNewDesc").value.trim(),
    managed_modules:modules,
    provider:document.getElementById("matNewProv").value,
    model_name:document.getElementById("matNewModel").value||"qwen-turbo",
    base_url:document.getElementById("matNewBaseUrl").value,
    system_prompt:prompt||tmpl||"",
    is_active:1
  };
  var apiKeyVal = document.getElementById("matNewApiKey").value;
  if(apiKeyVal){
    body.api_key = apiKeyVal;
  }
  fetch("/admin/agent-matrix/agents",{
    method:"POST",
    headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
    body:JSON.stringify(body)
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success){l_matrix()}else{alert(d.error||"创建失败")}
  });
}

// Prompt management help dialog
function matPromptHelp(){
  var mc=document.getElementById("mc");
  var h='<div class="cd" style="margin-bottom:12px">';
  h+='<div class="st">📖 提示词管理说明</div>';
  h+='<div style="font-size:12px;line-height:1.8;color:var(--muted)">';
  h+='<p><b>提示词（System Prompt）</b>是 智能体 的核心指令，决定了 Agent 的行为、角色和能力。</p>';
  h+='<br><b>内置模板（8 个预设）：</b>';
  h+='<br>位于服务器 <code>agent_matrix/prompts/</code> 目录，包含完整的角色定义、管辖模块、API 参考、质量标准。';
  h+='<br>创建 Sub Agent 时通过「System Prompt 模板」下拉选择，自动填充到文本框。';
  h+='<br><br><b>自定义提示词：</b>';
  h+='<br>在选择「自定义提示词」后，直接在 System Prompt 文本框中编写。';
  h+='<br>支持的字段：角色定义、管辖模块、核心能力、质量标准、行为准则、可用 API 参考。';
  h+='<br><br><b>提示词存储：</b>';
  h+='<br>• 如果选择内置模板，存储为文件路径（如 prompts/sub_cms_prompt.md）';
  h+='<br>• 如果手动编写，直接存储完整文本内容';
  h+='<br>• 运行时自动加载，支持动态修改';
  h+='<br><br><b>修改提示词：</b>';
  h+='<br>点击 Agent 行末的「✏️ 编辑」按钮，在弹出窗口中修改。';
  h+='<br>也可以直接 SSH 到服务器编辑 <code>agent_matrix/prompts/</code> 下的 .md 文件。';
  h+='</div>';
  h+='<div style="margin-top:10px"><button class="btn bp" onclick="l_matrix()">返回</button></div>';
  h+='</div>';
  mc.innerHTML=h;
}

// Edit agent dialog — unified with create form layout
function matEditAgent(id){
  fetch("/admin/agent-matrix/agents/"+id,{
    headers:{"Authorization":"Bearer "+T}
  }).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data){alert("加载失败");return}
    var a=d.data;
    var modules="";
    try{modules=JSON.parse(a.managed_modules||"[]").join(", ")}catch(e){}
    var h='<div class="cd" style="margin-bottom:12px">';
    h+='<div class="st">✏️ 编辑 Agent: '+esc(a.name)+' <span style="font-size:10px;color:var(--dim);font-weight:400">｜<a href="javascript:matPromptHelp()" style="color:var(--accent)">📖 提示词管理说明</a></span></div>';
    h+='<div class="g2">';
    // Row 1: Name + Domain
    h+='<div><div style="font-size:11px;color:var(--dim)">名称 *</div><input class="in" id="matEditName" value="'+esc(a.name)+'" style="width:100%"></div>';
    h+='<div><div style="font-size:11px;color:var(--dim)">领域</div><input class="in" id="matEditDomain" value="'+esc(a.domain)+'" style="width:100%"></div>';
    // Row 2: Description (full width)
    h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">描述</div><input class="in" id="matEditDesc" value="'+esc(a.description)+'" style="width:100%"></div>';
    // Row 3: Provider + Model
    h+='<div><div style="font-size:11px;color:var(--dim)">模型提供商</div>';
    h+='<select class="sl" id="matEditProv" onchange="matEditProvChange()" style="width:100%">';
    ["dashscope","openai","deepseek","openrouter","ollama"].forEach(function(p){
      h+='<option value="'+p+'"'+(a.provider==p?' selected':'')+'>'+(p=="dashscope"?"DashScope (通义千问 Qwen)":p=="openai"?"OpenAI (GPT-4o / GPT-4)":p=="deepseek"?"DeepSeek (DeepSeek-V3)":p=="openrouter"?"OpenRouter (多模型聚合)":"Ollama (本地部署开源模型)")+'</option>';
    });
    h+='</select></div>';
    h+='<div><div style="font-size:11px;color:var(--dim)">模型名称</div><input class="in" id="matEditModel" value="'+esc(a.model_name)+'" style="width:100%;font-size:11px"></div>';
    // Row 4: Base URL + API Key Ref (side by side)
    h+='<div><div style="font-size:11px;color:var(--dim)">API 端点 <span style="color:var(--muted);font-size:10px">自动填充</span></div>';
    var baseUrlMap={
      dashscope:"https://dashscope.aliyuncs.com/compatible-mode/v1",
      openai:"https://api.openai.com/v1",
      deepseek:"https://api.deepseek.com",
      openrouter:"https://openrouter.ai/api/v1",
      ollama:"http://localhost:11434/v1"
    };
    var defaultUrl=baseUrlMap[a.provider]||"";
    h+='<input class="in" id="matEditBaseUrl" value="'+esc(a.base_url||defaultUrl)+'" style="width:100%" autocomplete="off"></div>';
    // 隐藏假字段吸收浏览器自动填充
    h+='<input type="text" style="position:absolute;left:-9999px;width:1px;height:1px" tabindex="-1" autocomplete="username">';
    h+='<div><div style="font-size:11px;color:var(--dim)">API Key</div>';
    h+='<div style="display:flex;gap:4px;align-items:stretch">';
    // 已配置时掩码显示，未配置时空输入框
    var keyPlaceholder = a.key_configured ? "********（输入新值替换）" : "输入 API Key";
    h+='<input type="password" class="in" id="matEditApiKey" value="" placeholder="'+keyPlaceholder+'" style="flex:1" autocomplete="new-password"></div>';
    if(a.key_configured){
      h+='<button class="btn bo" id="matClearKeyBtn" onclick="matClearApiKey()" style="font-size:10px;white-space:nowrap;padding:4px 8px">清除 Key</button>';
    }
    h+='</div></div>';
    // Row 5: Prompt Template Selector
    h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">System Prompt 模板 <span style="color:var(--muted);font-size:10px">（选择后自动填充，可在下方修改）</span></div>';
    h+='<select class="sl" id="matEditPromptTmpl" onchange="matEditPromptSelect()" style="width:100%">';
    h+='<option value="">— 选择模板（可选）—</option>';
    h+='</select></div>';
    // Row 6: System Prompt
    h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">System Prompt <span style="color:var(--muted);font-size:10px">（粘贴或编写提示词内容）</span></div>';
    h+='<textarea class="ta" id="matEditPrompt" rows="5" placeholder="编写此 Agent 的系统提示词（或选择上方模板）" style="width:100%;min-height:120px;font-family:monospace;font-size:11px">'+esc(a.system_prompt||"")+'</textarea></div>';
    // Row 7: Managed Modules
    h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">管辖模块（逗号分隔）</div>';
    h+='<input class="in" id="matEditMods" value="'+esc(modules)+'" style="width:100%"></div>';
    h+='</div>';
    h+='<div style="margin-top:10px;display:flex;gap:8px;align-items:center">';
    h+='<button class="btn bp" onclick="matSaveEdit('+id+')">💾 保存</button>';
    h+='<button class="btn bo" onclick="l_matrix()">取消</button>';
    h+='</div></div>';
    document.getElementById("mc").innerHTML=h;
    // Load prompt templates
    matEditLoadPrompts();
  });
}

// Save agent edit
function matSaveEdit(id){
  var mods=document.getElementById("matEditMods").value.trim();
  var modules=mods?mods.split(",").map(function(s){return s.trim()}):[];
  var body={
    name:document.getElementById("matEditName").value.trim(),
    domain:document.getElementById("matEditDomain").value.trim(),
    description:document.getElementById("matEditDesc").value.trim(),
    managed_modules:modules,
    provider:document.getElementById("matEditProv").value,
    model_name:document.getElementById("matEditModel").value,
    base_url:document.getElementById("matEditBaseUrl").value,
    system_prompt:document.getElementById("matEditPrompt").value,
  };
  // 仅当用户输入了新 API Key 或点击了清除时才发送
  var apiKeyVal = document.getElementById("matEditApiKey").value;
  if(apiKeyVal){
    body.api_key = apiKeyVal === "__CLEAR__" ? "" : apiKeyVal;
  }
  fetch("/admin/agent-matrix/agents/"+id,{
    method:"PUT",
    headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
    body:JSON.stringify(body)
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success){l_matrix()}else{alert(d.error||"保存失败")}
  });
}

// Add prompt loading endpoint in backend
// We need GET /admin/agent-matrix/agents/<id>/prompt?path=... for loading prompt content
// Actually let me modify matPromptSelect to load via a different method

// Toggle agent
function matTg(id,v){
  fetch("/admin/agent-matrix/agents/"+id+"/toggle",{
    method:"POST",
    headers:{"Authorization":"Bearer "+T}
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success)l_matrix()
  });
}

// Test agent — 升级版，显示完整结果
function matTest(id){
  var q=prompt("输入测试问题：");
  if(!q)return;
  fetch("/admin/agent-matrix/agents/"+id+"/test",{
    method:"POST",
    headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
    body:JSON.stringify({query:q})
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success&&d.data){
      var msg="🧠 测试结果\n━━━━━━━━━━━━━━━━\n";
      msg+="状态: "+d.data.status+"\n";
      msg+="置信度: "+d.data.confidence+"\n";
      if(d.data.logs&&d.data.logs.length){
        msg+="\n📋 执行日志:\n";
        d.data.logs.slice(-5).forEach(function(l){msg+="  "+l+"\n"});
      }
      msg+="\n💬 响应:\n"+d.data.response.slice(0,1500);
      alert(msg);
    }else{alert(d.error||"测试失败")}
  });
}

// Button helpers for agent table
function matTgBtn(a){
  return '<button class="btn bo bs" onclick="matTg('+a.id+','+(a.is_active?0:1)+')">'+(a.is_active?"停用":"启用")+'</button> ';
}
function matEditBtn(a){
  return '<button class="btn bo bs" onclick="matEditAgent('+a.id+')" title="编辑提示词和配置">✏️</button> ';
}
function matTestBtn(a){
  return '<button class="btn bp bs" onclick="matTest('+a.id+')">测试</button>';
}

// =============================================
// AI 服务面板
// =============================================
function matAIServices(){
  document.getElementById("pt").textContent="AI 服务能力";
  var mc=document.getElementById("mc");
  mc.innerHTML='<div class="lo"><div class="s"></div>加载 AI 服务...</div>';
  fetch("/admin/agent-matrix/ai-services",{headers:{"Authorization":"Bearer "+T}})
    .then(function(r){return r.json()})
    .then(function(d){
      if(!d.success){mc.innerHTML='<div class="em">加载失败</div>';return}
      var svcs=d.data;
      var h='<div style="margin-bottom:10px"><button class="btn bo bs" onclick="l_matrix()">← 返回矩阵</button></div>';
      h+='<div class="gr">';
      h+=sc("🤖","AI 服务",svcs.length);
      h+=sc("🔑","已配置",svcs.filter(function(s){return s.key_status=="configured"}).length);
      h+=sc("❌","未配置",svcs.filter(function(s){return s.key_status=="missing"}).length);
      h+='</div>';
      svcs.forEach(function(s){
        var bg=s.key_status=="configured"?"rgba(0,212,170,.05)":"rgba(248,81,73,.05)";
        var bd=s.key_status=="configured"?"rgba(0,212,170,.2)":"rgba(248,81,73,.2)";
        h+='<div class="cd" style="margin-bottom:10px;border-color:'+bd+'">';
        h+='<div style="display:flex;justify-content:space-between;align-items:center">';
        h+='<div class="st" style="border:none;margin:0;padding:0">'+esc(s.name)+' <span class="bdg '+(s.key_status=="configured"?"on":"off")+'">'+(s.key_status=="configured"?"已配置":"未配置 Key")+'</span></div>';
        h+='<span style="font-size:10px;color:var(--dim)">'+esc(s.type)+' | '+esc(s.provider)+'</span>';
        h+='</div>';
        // Key status
        h+='<div style="font-size:11px;color:var(--muted);margin-top:4px">';
        h+='引用配置: <code style="background:rgba(0,0,0,.3);padding:1px 4px;border-radius:3px;font-size:10px">'+esc(s.key_ref)+'</code>';
        h+=' | 模型: '+s.models.join(", ");
        h+='</div>';
        // Used by agents
        if(s.used_by_agents&&s.used_by_agents.length){
          h+='<div style="font-size:11px;color:var(--muted);margin-top:4px">';
          h+='使用此服务的 Agent: ';
          s.used_by_agents.forEach(function(a,i){
            h+='<span class="bdg on" style="font-size:10px;margin-right:4px">'+esc(a.name)+'</span>';
          });
          h+='</div>';
        }
        // Endpoints
        if(s.endpoints&&s.endpoints.length){
          h+='<div style="font-size:10px;color:var(--dim);margin-top:4px">';
          h+='端点: ';
          s.endpoints.forEach(function(e){
            h+='<div style="margin-left:12px">• '+esc(e)+'</div>';
          });
          h+='</div>';
        }
        // Note for unmanaged services
        if(s.note){
          h+='<div style="font-size:10px;color:#f85149;margin-top:4px;background:rgba(248,81,73,.08);padding:4px 8px;border-radius:4px">⚠️ '+esc(s.note)+'</div>';
        }
        // Test button for services that have configured keys
        if(s.key_status=="configured"){
          h+='<div style="margin-top:8px"><button class="btn bp bs" data-svc="'+s.id+'" onclick="matServiceTest(this.dataset.svc)">快速测试</button></div>';
        }else{
          h+='<div style="margin-top:8px"><button class="btn bo bs" onclick="showToast(&#39;请先在系统设置中配置&#39;,&#39;error&#39;)">配置 Key</button></div>';
        }
        h+='</div>';
      });
      mc.innerHTML=h;
    }).catch(function(){
      mc.innerHTML='<div class="em">加载失败</div>';
    });
}

// Quick test AI service
function matServiceTest(svcId){
  var tests={
    qwen_text:{name:"文本生成",q:"用一句话介绍智能体技术"},
    wanx_image:{name:"文生图",q:"画一只蓝色的猫"},
    matrix_chat:{name:"矩阵对话",q:"列出你的子 Agent 有哪些"},
    trademind_chat:{name:"聊天窗口",q:"你好"}
  };
  var t=tests[svcId];
  if(!t){alert("未知服务");return}
  var msg="⏳ 测试 "+t.name+"... 请稍候";
  showToast(msg,"info");
  if(svcId=="qwen_text"){
    fetch("/admin/content-factory/ai-format",{
      method:"POST",
      headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
      body:JSON.stringify({content:t.q})
    }).then(function(r){return r.json()}).then(function(d){
      if(d.success)alert("✅ 测试通过!\n\n响应:\n"+d.data.slice(0,500));
      else alert("❌ 测试失败: "+(d.error||"未知"));
    });
  }else if(svcId=="wanx_image"){
    fetch("/admin/social/generate-image",{
      method:"POST",
      headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
      body:JSON.stringify({prompt:t.q})
    }).then(function(r){return r.json()}).then(function(d){
      if(d.success)alert("✅ 测试通过!\n图片URL: "+(d.data.url||d.data||""));
      else alert("❌ 测试失败: "+(d.error||"未知"));
    });
  }else if(svcId=="trademind_chat"){
    matEditKnowledge();
  }else{
    alert("请使用矩阵对话功能测试");
  }
}

// =============================================
// 聊天窗口知识库管理
// =============================================
function matEditKnowledge(){
  document.getElementById("pt").textContent="聊天窗口管理";
  var mc=document.getElementById("mc");
  mc.innerHTML='<div class="lo"><div class="s"></div>加载知识库...</div>';
  fetch("/admin/agent-matrix/chat/knowledge",{headers:{"Authorization":"Bearer "+T}})
    .then(function(r){return r.json()})
    .then(function(d){
      if(!d.success){mc.innerHTML='<div class="em">加载失败</div>';return}
      var content=d.data||"";
      var h='<div style="margin-bottom:10px"><button class="btn bo bs" onclick="matAIServices()">← 返回 AI 服务</button></div>';
      h+='<div class="cd">';
      h+='<div class="st">💬 聊天窗口管理 <span style="font-size:10px;color:var(--dim);font-weight:400">｜ 由 Agent Matrix Ticket Agent 管理</span></div>';
      h+='<div style="display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap">';
      h+='<div class="cd" style="flex:1;min-width:120px;padding:10px"><div class="l" style="font-size:10px">状态</div><div class="v g">已接入矩阵</div></div>';
      h+='<div class="cd" style="flex:1;min-width:120px;padding:10px"><div class="l" style="font-size:10px">管理 Agent</div><div class="v" style="font-size:14px">Ticket Agent</div></div>';
      h+='</div>';
      h+='<div style="font-size:11px;color:var(--dim);margin-bottom:4px">📖 知识库内容（作为 System Prompt 的一部分注入到聊天窗口）</div>';
      h+='<textarea class="ta" id="matKnowledgeContent" rows="12" style="width:100%;font-family:monospace;font-size:12px;min-height:300px">'+esc(content)+'</textarea>';
      h+='<div style="margin-top:10px;display:flex;gap:8px;align-items:center">';
      h+='<button class="btn bp" onclick="matSaveKnowledge()">💾 保存知识库</button>';
      h+='<button class="btn bo" onclick="matAIServices()">取消</button>';
      h+='<span id="matKbStatus" style="font-size:11px;color:var(--dim)"></span>';
      h+='</div></div>';

      // Test area
      h+='<div class="cd" style="margin-top:12px">';
      h+='<div class="st">🔍 快速测试聊天窗口</div>';
      h+='<div style="display:flex;gap:8px;margin-bottom:8px">';
      h+='<input class="in" id="matTestChatQ" placeholder="输入测试问题..." style="flex:1;font-size:12px">';
      h+='<button class="btn bp" onclick="matTestChatStream()">发送</button>';
      h+='</div>';
      h+='<div id="matTestChatResult" style="background:rgba(0,0,0,.3);border-radius:6px;padding:10px;min-height:80px;font-size:12px;color:var(--muted);white-space:pre-wrap"></div>';
      h+='</div>';

      mc.innerHTML=h;
    }).catch(function(){
      mc.innerHTML='<div class="em">加载失败</div>';
    });
}

// Save knowledge base
function matSaveKnowledge(){
  var content=document.getElementById("matKnowledgeContent").value;
  var st=document.getElementById("matKbStatus");
  st.textContent="保存中...";
  st.style.color="var(--muted)";
  fetch("/admin/agent-matrix/chat/knowledge",{
    method:"PUT",
    headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
    body:JSON.stringify({content:content})
  }).then(function(r){return r.json()}).then(function(d){
    if(d.success){
      st.textContent="✅ 已保存 ("+content.length+" 字符)";
      st.style.color="var(--accent)";
    }else{
      st.textContent="❌ 保存失败";
      st.style.color="#f85149";
    }
  });
}

// Test chat with streaming
function matTestChatStream(){
  var q=document.getElementById("matTestChatQ").value.trim();
  if(!q)return;
  var result=document.getElementById("matTestChatResult");
  result.textContent="";
  fetch("/admin/agent-matrix/chat/stream",{
    method:"POST",
    headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},
    body:JSON.stringify({message:q,history:[]})
  }).then(function(r){
    var reader=r.body.getReader();
    var decoder=new TextDecoder();
    function read(){
      reader.read().then(function(result){
        var text=decoder.decode(result.value,{stream:!result.done});
        var lines=text.split("\\n");
        lines.forEach(function(line){
          line=line.trim();
          if(!line||!line.startsWith("data: "))return;
          var payload=line.slice(6);
          if(payload=="[DONE]")return;
          try{
            var data=JSON.parse(payload);
            if(data.role)return;
            result.textContent+=data;
          }catch(e){}
        });
        if(!result.done)read();
      });
    }
    read();
    return null;
  });
}


window.l_email=function(){
  document.getElementById("pt").textContent="邮件管理";
  var h='<div style="margin-bottom:12px"><button class="btn bp" onclick="se()">写邮件</button></div>';
  h+='<div id="sendForm" style="display:none;margin-bottom:16px" class="cd"><div class="st">写邮件</div>';
  h+='<div style="margin-bottom:10px">';
  h+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px"><span style="font-size:12px;color:var(--dim)">收件人</span><span style="font-size:11px;color:var(--dim)">多个地址用逗号分隔</span></div>';
  h+='<input class="in" id="em-to" placeholder="email1@example.com, email2@example.com" style="width:100%">';
  h+='<div id="em-recipients" style="display:flex;gap:4px;flex-wrap:wrap;margin-top:4px"></div></div>';
  h+='<div style="margin-bottom:10px"><div style="font-size:12px;color:var(--dim);margin-bottom:4px">主题</div><input class="in" id="em-sub" placeholder="邮件主题" style="width:100%"></div>';
  h+='<div style="margin-bottom:10px"><div style="font-size:12px;color:var(--dim);margin-bottom:4px">内容</div><div id="em-editor" style="min-height:200px;background:rgba(0,0,0,.3);border-radius:8px;border:1px solid var(--border)"></div></div>';
  h+='<div style="margin-bottom:10px"><div style="font-size:12px;color:var(--dim);margin-bottom:4px">附件</div>';
  h+='<input type="file" id="em-file" multiple onchange="addAttach()" style="display:none">';
  h+='<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><button class="btn bo bs" onclick="document.getElementById(\'em-file\').click()">+ 添加附件</button><div id="em-attach-list" style="display:flex;gap:6px;flex-wrap:wrap"></div></div></div>';
  h+='<div style="margin-top:10px;display:flex;gap:8px"><button class="btn bp" onclick="ds()">发送</button> <button class="btn bo" onclick="hsf()">取消</button></div></div>';
  h+='<div class="cd"><div class="st">收件箱</div><div id="inboxList"><div class="lo"><div class="s"></div></div></div></div>';
  // Contacts panel
  h+='<div class="cd" style="margin-top:12px"><div class="st" style="cursor:pointer" onclick="toggleContacts()">📇 联系人 <span id="contactToggle" style="font-size:10px;color:var(--dim)">[展开]</span></div>';
  h+='<div id="contactsPanel" style="display:none">';
  h+='<div style="display:flex;gap:8px;margin-bottom:8px;align-items:center">';
  h+='<button class="btn bp bs" onclick="selectAllContacts()">全选</button>';
  h+='<button class="btn bo bs" onclick="deselectAllContacts()">取消全选</button>';
  h+='<button class="btn bp" onclick="sendBulk()" style="font-size:11px">📤 群发到选中联系人</button>';
  h+='<span id="contactCount" style="font-size:11px;color:var(--dim)">0 个联系人</span>';
  h+='</div><div id="contactsList"><div class="lo"><div class="s"></div></div></div></div></div>';
  document.getElementById("mc").innerHTML=h;
  // Prepare Quill
  window.emEditor=null;
  window.emAttachments=[];
  // Load contacts
  loadContacts();
  // Auto-parse recipients on input
  document.getElementById("em-to").addEventListener("input",parseRecipients);
  fetch("/admin/email/inbox",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data){document.getElementById("inboxList").innerHTML='<div class="em">加载失败</div>';return}
    var lst=d.data.items||d.data;
    if(!lst.length){document.getElementById("inboxList").innerHTML='<div class="em">暂无邮件</div>';return}
    var tbl='<table><tr><th>发件人</th><th>主题</th><th>附件</th><th>时间</th><th>操作</th></tr>';
    lst.forEach(function(e){
      var attIcon=e.has_attachments?' <span style="color:var(--accent)">📎</span>':'';
      tbl+='<tr><td>'+(e.from||'-')+'</td><td>'+(e.subject||'(无主题)')+attIcon+'</td><td>'+(e.has_attachments?'<span style="color:var(--accent)">有</span>':'')+'</td><td>'+(e.date||'')+'</td>';
      tbl+='<td><button class="btn bo bs" onclick="re('+e.uid+',\''+e.from.replace(/'/g,'')+'\',\''+(e.subject||'').replace(/'/g,'')+'\')">回复</button> <button class="btn bo" onclick="viewEmail('+e.uid+')">查看</button></td></tr>';
    });
    tbl+='</table>';
    document.getElementById("inboxList").innerHTML=tbl;
  }).catch(function(){})
}

var emContacts=[];
var emSelectedContacts=[];
function loadContacts(){
  fetch("/admin/email/contacts",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success&&d.data){emContacts=d.data;renderContacts()}
  }).catch(function(){})
}
function renderContacts(){
  var el=document.getElementById("contactsList");
  if(!el)return;
  var total=emContacts.length;
  document.getElementById("contactCount").textContent=total+" 个联系人";
  if(!total){el.innerHTML='<div class="em">暂无联系人（发送邮件后自动收集）</div>';return}
  var h='<table><tr><th style="width:36px"><input type="checkbox" onchange="toggleAllContacts(this.checked)"></th><th>名称</th><th>邮箱</th><th>来源</th><th>次数</th></tr>';
  emContacts.forEach(function(c,i){
    var checked=emSelectedContacts.indexOf(c.email)>=0?' checked':'';
    var src=c.source==='contact'?'<span class="bdg pd">表单</span>':'<span class="bdg on">已发送</span>';
    h+='<tr><td><input type="checkbox" class="contact-cb" data-email="'+c.email+'" data-name="'+c.name+'"'+checked+' onchange="toggleContact(this)"></td>'+
      '<td>'+(c.name||'-')+'</td><td style="color:var(--accent)">'+c.email+'</td><td>'+src+'</td><td>'+c.count+'</td></tr>';
  });
  h+='</table>';
  el.innerHTML=h;
}
function toggleAllContacts(checked){
  var cbs=document.querySelectorAll("#contactsList .contact-cb");
  cbs.forEach(function(cb){cb.checked=checked;toggleContact(cb)});
}
function toggleContact(cb){
  var email=cb.getAttribute("data-email");
  if(cb.checked){
    if(emSelectedContacts.indexOf(email)<0)emSelectedContacts.push(email);
  }else{
    emSelectedContacts=emSelectedContacts.filter(function(e){return e!==email});
  }
}
function selectAllContacts(){
  var cbs=document.querySelectorAll("#contactsList .contact-cb");
  cbs.forEach(function(cb){cb.checked=true;if(emSelectedContacts.indexOf(cb.getAttribute("data-email"))<0)emSelectedContacts.push(cb.getAttribute("data-email"))});
}
function deselectAllContacts(){
  var cbs=document.querySelectorAll("#contactsList .contact-cb");
  cbs.forEach(function(cb){cb.checked=false});
  emSelectedContacts=[];
}
function toggleContacts(){
  var p=document.getElementById("contactsPanel");
  var t=document.getElementById("contactToggle");
  if(p.style.display==="none"||!p.style.display){
    p.style.display="block";
    t.textContent="[收起]";
    renderContacts();
  }else{
    p.style.display="none";
    t.textContent="[展开]";
  }
}
function sendBulk(){
  if(!emSelectedContacts.length){alert("请先选择要发送的联系人");return}
  var count=emSelectedContacts.length;
  var el=document.getElementById("em-to");
  el.value=emSelectedContacts.join(", ");
  parseRecipients();
  se();
  emSelectedContacts=[];
  document.querySelectorAll("#contactsList .contact-cb").forEach(function(cb){cb.checked=false});
  showToast("已填入 "+count+" 个收件人，编辑内容后发送","success");
}
function parseRecipients(){
  var el=document.getElementById("em-to");
  var raw=el.value;
  // Extract all emails from comma-separated input
  var addrs=raw.split(",").map(function(a){return a.trim()}).filter(function(a){return a.length>0&&a.includes("@")});
  var container=document.getElementById("em-recipients");
  if(!addrs.length){container.innerHTML="";return}
  var h='';
  addrs.forEach(function(a){
    // Find matching contact name
    var name='';
    for(var i=0;i<emContacts.length;i++){
      if(emContacts[i].email.toLowerCase()===a.toLowerCase()){name=emContacts[i].name;break}
    }
    var label=name||a.split("@")[0];
    h+='<span style="display:inline-flex;align-items:center;gap:4px;padding:3px 8px;background:rgba(0,212,170,.1);border:1px solid rgba(0,212,170,.3);border-radius:4px;font-size:12px">'+label+' <span style="color:var(--dim);font-size:10px">'+a+'</span></span>';
  });
  container.innerHTML=h;
}
var emAttachments=[];
function addAttach(){
  var files=document.getElementById("em-file").files;
  for(var i=0;i<files.length;i++){
    var f=files[i];
    if(f.size>10*1024*1024){alert('附件 '+f.name+' 超过 10MB 限制');continue}
    var reader=new FileReader();
    reader.onload=function(fn,fsize){return function(e){
      emAttachments.push({filename:fn,data:e.target.result.split(',')[1],content_type:fn.split('.').pop()==='pdf'?'application/pdf':'application/octet-stream',size:fsize});
      renderAttachList();
    }}(f.name,f.size);
    reader.readAsDataURL(f);
  }
  document.getElementById("em-file").value='';
}
function renderAttachList(){
  var el=document.getElementById("em-attach-list");
  if(!emAttachments.length){el.innerHTML='';return}
  var h='';
  emAttachments.forEach(function(a,i){
    var size=(a.size/1024).toFixed(1)+'KB';
    if(a.size>1024*1024)size=(a.size/1024/1024).toFixed(1)+'MB';
    h+='<span style="display:inline-flex;align-items:center;gap:4px;padding:4px 8px;background:var(--bg);border-radius:4px;font-size:11px">📎 '+a.filename+' ('+size+') <span onclick="removeAttach('+i+')" style="cursor:pointer;color:var(--dim)">✕</span></span>';
  });
  el.innerHTML=h;
}
function removeAttach(i){emAttachments.splice(i,1);renderAttachList()}
function se(){
  document.getElementById("sendForm").style.display="block";
  if(!window.emEditor){
    window.emEditor=new Quill('#em-editor',{theme:'snow',placeholder:'邮件正文...',modules:{toolbar:[['bold','italic','underline','strike'],[{list:'ordered'},{list:'bullet'}],['link','blockquote','code-block'],[{size:['small',false,'large','huge']}],[{color:[]},{background:[]}],['clean']]}});
  }
  setTimeout(function(){window.emEditor&&window.emEditor.focus()},100)
}
function hsf(){document.getElementById("sendForm").style.display="none"}
function ds(){
  var to=document.getElementById("em-to").value.trim();
  var sub=document.getElementById("em-sub").value.trim();
  var html=window.emEditor?window.emEditor.root.innerHTML:'';
  var text=window.emEditor?window.emEditor.getText().trim():'';
  if(!to||!sub||(!html&&!text)){showToast('请填写完整','error');return}
  var body=text||'';
  fetch("/admin/email/send",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({to:to,subject:sub,body:body,body_html:html||null,attachments:emAttachments.length?emAttachments:null})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast('✅ 发送成功','success');emAttachments=[];renderAttachList();hsf();l_email()}else{showToast('❌ '+(d.error||'发送失败'),'error')}
  }).catch(function(){showToast('❌ 发送失败','error')})
}
function re(uid,from,sub){
  document.getElementById("em-to").value=from;
  var rsub=sub.startsWith("Re:")?sub:"Re: "+sub;
  document.getElementById("em-sub").value=rsub;
  if(window.emEditor)window.emEditor.root.innerHTML='';
  se();
}

// ════════════════════════════════════════════════════════════════
function escAttr(s){
  if(!s)return '';
  return s.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/'/g,'&#39;');
}

function showToast(msg,type){
  var t=document.getElementById("adminToast");
  t.textContent=msg;
  t.className="toast show "+(type||"");
  setTimeout(function(){t.classList.remove("show")},3000);
}
function viewEmail(uid){
  fetch("/admin/email/read/"+uid,{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success){showToast("加载失败: "+(d.error||""),"error");return}
    var m=d.data;
    var bodyHtml=m.body_html||"";
    var bodyText=(m.body||"(无内容)").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/\n/g,"<br>");
    var h='<div class="modal-overlay" onclick="closeEmailModal(event)">';
    h+='<div class="modal-box" onclick="event.stopPropagation()">';
    h+='<button onclick="closeEmailModal()" style="float:right;background:none;border:none;color:var(--dim);font-size:20px;cursor:pointer;line-height:1">✕</button>';
    h+='<h3>'+(m.subject||"(无主题)")+'</h3>';
    h+='<div class="modal-meta">';
    h+='<div><span>发件人</span> '+(m.from||"-")+'</div>';
    h+='<div><span>收件人</span> '+(m.to||"-")+'</div>';
    h+='<div><span>时间</span> '+(m.date||"-")+'</div>';
    h+='</div>';
    h+='<div class="modal-body">';
    if(bodyHtml){h+=bodyHtml}
    else{h+=bodyText}
    h+='</div>';
    // Attachments
    if(m.attachments&&m.attachments.length){
      h+='<div class="modal-attach"><span style="font-size:12px;color:var(--dim)">📎 附件</span>';
      m.attachments.forEach(function(a){
        var fn=a.filename||a.name||"file";
        h+=' <a href="/admin/email/attachment/'+uid+'/'+encodeURIComponent(fn)+'" target="_blank">📎 '+fn+'</a>';
      });
      h+='</div>';
    }
    h+='<div style="margin-top:16px;display:flex;gap:8px">';
    h+='<button class="btn bp" onclick="re('+uid+',\''+(m.from||"").replace(/'/g,"")+'\',\''+(m.subject||"").replace(/'/g,"")+'\');closeEmailModal()">↩ 回复</button>';
    h+='<button class="btn bo" onclick="closeEmailModal()">关闭</button></div></div></div>';
    // Remove any existing modal
    var old=document.querySelector(".modal-overlay");
    if(old)old.remove();
    document.body.insertAdjacentHTML("beforeend",h);
  }).catch(function(){showToast("加载失败","error")});
}
function closeEmailModal(e){
  if(e&&e.target!==e.currentTarget)return;
  var m=document.querySelector(".modal-overlay");
  if(m)m.remove();
}

window.l_sms=function(){
  document.getElementById("pt").textContent="短信管理";
  var h='<div class="cd"><div class="st">📱 短信模板管理</div><div style="margin-bottom:12px"><button class="btn bp" onclick="showSmsForm()">+ 添加模板</button></div>';
  h+='<div id="smsForm" style="display:none;margin-bottom:16px" class="cd"><div class="st" id="smsFormTitle">添加模板</div>';
  h+='<div class="g2">';
  h+='<div><div style="font-size:11px;color:var(--dim)">分类</div><select class="sl" id="smsCat" style="width:100%"><option value="captcha">验证码</option><option value="notice">短信通知</option><option value="promo">短信推广</option></select></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">名称</div><input class="in" id="smsName" placeholder="如：新用户注册" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">模板 CODE</div><input class="in" id="smsCode" placeholder="SMS_xxxxxxxxx" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">备注</div><input class="in" id="smsNote" placeholder="用途说明" style="width:100%"></div>';
  h+='</div>';
  h+='<div style="margin-top:10px"><button class="btn bp" onclick="saveSmsTemplate()">保存</button> <button class="btn bo" onclick="document.getElementById(\'smsForm\').style.display=\'none\'">取消</button><input type="hidden" id="smsEditId" value=""></div></div>';
  h+='<div id="smsTemplates"></div></div>';
  document.getElementById("mc").innerHTML=h;
  loadSmsTemplates();
};

function loadSmsTemplates(){
  fetch("/admin/sms/templates",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data){document.getElementById("smsTemplates").innerHTML='<div class="em">加载失败</div>';return}
    var cats=d.data.categories;
    var h="";
    var order=["captcha","notice","promo"];
    order.forEach(function(k){
      var c=cats[k];
      if(!c||!c.items||!c.items.length){return}
      h+='<div class="cd" style="margin-bottom:12px"><div class="st">'+c.title+' ('+c.items.length+')</div><table><tr><th>名称</th><th>模板 CODE</th><th>备注</th><th>操作</th></tr>';
      c.items.forEach(function(t){
        h+='<tr><td>'+esc(t.name)+'</td><td style="font-family:monospace;color:var(--accent)">'+esc(t.template_code)+'</td><td style="color:var(--dim)">'+esc(t.note)+'</td>';
        h+='<td><button class="btn bo bs" onclick="editSmsTemplate('+t.id+',\''+t.category+'\',\''+esc(t.name)+'\',\''+esc(t.template_code)+'\',\''+esc(t.note)+'\')">编辑</button> ';
        h+='<button class="btn bo bs" onclick="deleteSmsTemplate('+t.id+')">删除</button></td></tr>';
      });
      h+='</table></div>';
    });
    if(!h){h='<div class="em">暂无模板，点击上方「添加模板」创建</div>'}
    document.getElementById("smsTemplates").innerHTML=h;
  }).catch(function(){document.getElementById("smsTemplates").innerHTML='<div class="em">加载失败</div>'})
}

function showSmsForm(){
  document.getElementById("smsForm").style.display="block";
  document.getElementById("smsFormTitle").textContent="添加模板";
  document.getElementById("smsEditId").value="";
  document.getElementById("smsCat").value="captcha";
  document.getElementById("smsName").value="";
  document.getElementById("smsCode").value="";
  document.getElementById("smsNote").value="";
}

function saveSmsTemplate(){
  var eid=document.getElementById("smsEditId").value;
  var cat=document.getElementById("smsCat").value;
  var name=document.getElementById("smsName").value.trim();
  var code=document.getElementById("smsCode").value.trim();
  var note=document.getElementById("smsNote").value.trim();
  if(!name||!code){alert("名称和模板 CODE 不能为空");return}
  var url="/admin/sms/templates";
  var method="POST";
  var body={category:cat,name:name,template_code:code,note:note};
  if(eid){
    url+="/"+eid;
    method="PUT";
    body={name:name,template_code:code,note:note};
  }
  fetch(url,{method:method,headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(body)}).then(function(r){return r.json()}).then(function(d){
    if(d.success){document.getElementById("smsForm").style.display="none";loadSmsTemplates();showToast("保存成功","success")}
    else{alert(d.error||"保存失败")}
  }).catch(function(){alert("保存失败")})
}

function editSmsTemplate(id,cat,name,code,note){
  document.getElementById("smsForm").style.display="block";
  document.getElementById("smsFormTitle").textContent="编辑模板";
  document.getElementById("smsEditId").value=id;
  document.getElementById("smsCat").value=cat;
  document.getElementById("smsName").value=name;
  document.getElementById("smsCode").value=code;
  document.getElementById("smsNote").value=note;
}

function deleteSmsTemplate(id){
  if(!confirm("确定删除此模板？"))return;
  fetch("/admin/sms/templates/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){loadSmsTemplates();showToast("已删除","success")}
    else{alert(d.error||"删除失败")}
  }).catch(function(){alert("删除失败")})
}

window.l_cms=function(){
  document.getElementById("pt").textContent="AI CMS";
  var h='';
  h+='<div style="margin-bottom:12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">';
  h+='<button class="btn bp" onclick="cmsFilterPosts(\'all\')" id="cmsF-all">全部</button>';
  h+='<button class="btn bo" onclick="cmsFilterPosts(\'draft\')" id="cmsF-draft">📝 草稿箱</button>';
  h+='<button class="btn bo" onclick="cmsFilterPosts(\'published\')" id="cmsF-published">✅ 已发布</button>';
  h+='<span style="flex:1"></span>';
  h+='<button class="btn bp" onclick="cmsNewPost()">+ 新建文章</button>';
  h+='<button class="btn bo" onclick="cmsManageCategories()">栏目管理⚙️</button>';
  h+='</div>';
  h+='<div id="cmsPostForm" style="display:none;margin-bottom:14px" class="cd">';
  h+='<div class="st" id="cmsFormTitle">新建文章</div>';
  h+='<div class="g2">';
  h+='<div><div style="font-size:11px;color:var(--dim);margin-bottom:3px">标题</div><input class="in" id="cmsPTitle" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim);margin-bottom:3px">栏目</div><select class="sl" id="cmsPCat" style="width:100%"></select></div>';
  h+='<div><div style="font-size:11px;color:var(--dim);margin-bottom:3px">作者</div><input class="in" id="cmsPAuthor" style="width:100%"></div>';
  h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim);margin-bottom:3px">摘要</div><input class="in" id="cmsPSummary" style="width:100%"></div>';
  h+='</div>';
  h+='<div style="margin-top:8px"><div style="font-size:11px;color:var(--dim);margin-bottom:3px">正文</div>';
  h+='<div id="cmsPBody" style="min-height:350px;background:var(--bg);color:var(--text)"></div></div>';
  h+='<div style="margin-top:8px;display:flex;gap:6px">';
  h+='<button class="btn bo bo" onclick="cmsAiformat()">🤖 AI排版</button> ';
  h+='<button class="btn bo" onclick="cmsAicover()">🎨 AI配图</button></div>';
  // Publish channels section
  h+='<div style="margin-top:12px;padding:10px;background:var(--bg);border-radius:6px;border:1px solid var(--border)">';
  h+='<div style="font-size:12px;font-weight:600;margin-bottom:6px;color:var(--text)">📤 发布渠道（可多选）</div>';
  h+='<div id="cmsChannelLocal" style="margin-bottom:6px"><div style="font-size:10px;color:var(--dim);margin-bottom:3px">本地栏目</div><div id="cmsChLocalList"></div></div>';
  h+='<div id="cmsChannelSocial"><div style="font-size:10px;color:var(--dim);margin-bottom:3px">社媒平台</div><div id="cmsChSocialList"></div></div>';
  h+='</div>';
  h+='<div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap">';
  h+='<button class="btn bo" onclick="cmsSaveDraft()">💾 保存草稿</button> ';
  h+='<button class="btn bp" onclick="cmsPublishPost()">📤 发布到选中渠道</button> ';
  h+='<button class="btn bo" onclick="cmsCloseForm()">取消</button><input type="hidden" id="cmsPEid"></div></div>';
  // Article list
  h+='<div class="cd"><div class="st">文章列表</div><table><tr><th>ID</th><th>标题</th><th>栏目</th><th>作者</th><th>状态</th><th>发布渠道</th><th>👀</th><th>时间</th><th>操作</th></tr><tbody id="cmsPostBody"></tbody></table></div>';
  // Publish history toggle
  h+='<button class="btn bo" style="margin-top:12px" onclick="cmsToggleSocialHistory()">📤 发布历史</button>';
  h+='<div id="cmsSocialHistoryWrap" style="display:none;margin-top:8px"></div>';
  document.getElementById("mc").innerHTML=h;
  // Load categories for dropdown and channel list
  cmsLoadCategories();
  // Load social platform config
  cmsLoadSocialPlatforms();
  cmsFilterPosts('all');
};

var cmsPosts=[];
var cmsQuill=null;
var cmsStatusFilter='all';
var cmsCategories=[];

function cmsInitQuill(content){
  if(cmsQuill){cmsQuill.root.innerHTML=content||'';return}
  cmsQuill=new Quill("#cmsPBody",{theme:"snow",placeholder:"在这里编辑正文...",modules:{toolbar:[["bold","italic","underline","strike"],[{header:1},{header:2}],[{list:"ordered"},{list:"bullet"}],["link","image","code-block"],["clean"]]}});
  if(content)cmsQuill.root.innerHTML=content;
}

// ── Categories ──

function cmsLoadCategories(callback){
  fetch("/admin/cms/categories",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success&&d.data){
      cmsCategories=d.data;
      cmsPopulateCategorySelect();
      cmsPopulateChannelList();
    }
    if(callback)callback();
  }).catch(function(){if(callback)callback()});
}

function cmsPopulateCategorySelect(){
  var sel=document.getElementById("cmsPCat");
  if(!sel)return;
  sel.innerHTML='';
  cmsCategories.forEach(function(c){
    var o=document.createElement("option");
    o.value=c.name;
    o.textContent=c.icon+' '+c.name;
    sel.appendChild(o);
  });
}

function cmsPopulateChannelList(){
  var localDiv=document.getElementById("cmsChLocalList");
  if(!localDiv)return;
  var h='';
  cmsCategories.forEach(function(c){
    h+='<label style="font-size:12px;display:inline-flex;align-items:center;gap:4px;margin:2px 6px 2px 0;cursor:pointer">';
    h+='<input type="checkbox" class="cmsChLocal" value="local:'+c.name+'" checked>';
    h+=c.icon+' '+c.name+'</label>';
  });
  localDiv.innerHTML=h;
}

function cmsLoadSocialPlatforms(){
  var socialDiv=document.getElementById("cmsChSocialList");
  if(!socialDiv)return;
  fetch("/admin/social/check-config",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    var h='';
    d.data.platforms.forEach(function(p){
      var disabled=p.configured?'':'disabled';
      var opacity=p.configured?1:0.4;
      h+='<label style="font-size:12px;display:inline-flex;align-items:center;gap:4px;margin:2px 6px 2px 0;cursor:pointer;opacity:'+opacity+'">';
      h+='<input type="checkbox" class="cmsChSocial" value="'+p.id+'" '+disabled+'>';
      h+=p.icon+' '+p.name;
      if(!p.configured)h+=' <span style="font-size:9px;color:var(--dim)">(未配置)</span>';
      h+='</label>';
    });
    socialDiv.innerHTML=h;
  }).catch(function(){});
}

// ── Filter ──

function cmsFilterPosts(status){
  cmsStatusFilter=status;
  document.querySelectorAll('[id^="cmsF-"]').forEach(function(e){e.className="btn bo"});
  var el=document.getElementById("cmsF-"+status);
  if(el)el.className="btn bp";
  cmsLoadPosts();
}

function cmsLoadPosts(){
  var url="/admin/cms/posts?limit=50";
  if(cmsStatusFilter&&cmsStatusFilter!=='all')url+="&status="+cmsStatusFilter;
  fetch(url,{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data){document.getElementById("cmsPostBody").innerHTML='<tr><td colspan="9"><div class="em">暂无</div></td></tr>';return}
    cmsPosts=d.data||[];
    var h='';
    if(!cmsPosts.length){h='<tr><td colspan="9"><div class="em">暂无文章</div></td></tr>'}
    else{cmsPosts.forEach(function(p){
      var st=p.is_published?'<span class="bdg on">已发布</span>':'<span class="bdg pd">草稿</span>';
      // Build channel display
      var chText='—';
      if(p.publish_channels&&p.publish_channels.length){
        chText=p.publish_channels.map(function(ch){
          if(ch.startsWith('local:'))return ch.replace('local:','');
          var map={wechat:'💬微信',weibo:'📢微博',toutiao:'📰头条'};
          return map[ch]||ch;
        }).join(' · ');
      }
      h+='<tr><td style="font-size:10px">'+p.id+'</td>';
      h+='<td style="font-weight:600;cursor:pointer;color:var(--accent)" onclick="cmsEditPost('+p.id+')">'+esc(p.title||'-')+'</td>';
      h+='<td>'+esc(p.category||'')+'</td><td>'+esc(p.author||'-')+'</td><td>'+st+'</td>';
      h+='<td style="font-size:10px">'+chText+'</td>';
      h+='<td style="font-size:10px;color:var(--dim)">'+(p.views||0)+'</td>';
      h+='<td style="font-size:10px">'+(p.created_at||'').slice(0,10)+'</td>';
      h+='<td><button class="btn bo bs" onclick="cmsEditPost('+p.id+')">编辑</button> ';
      h+='<button class="btn bo bs" onclick="cmsDelPost('+p.id+')">删除</button></td></tr>';
    })}
    document.getElementById("cmsPostBody").innerHTML=h;
  }).catch(function(){document.getElementById("cmsPostBody").innerHTML='<tr><td colspan="9"><div class="em">请求失败</div></td></tr>'});
}

// ── New / Edit / Close ──

function cmsNewPost(){
  document.getElementById("cmsFormTitle").textContent="新建文章";
  document.getElementById("cmsPEid").value="";
  document.getElementById("cmsPTitle").value="";
  document.getElementById("cmsPAuthor").value="";
  document.getElementById("cmsPSummary").value="";
  if(cmsCategories.length)document.getElementById("cmsPCat").value=cmsCategories[0].name;
  document.getElementById("cmsPostForm").style.display="block";
  // Reset channels: all local checked, social unchecked
  document.querySelectorAll(".cmsChLocal").forEach(function(cb){cb.checked=true});
  document.querySelectorAll(".cmsChSocial").forEach(function(cb){cb.checked=false});
  setTimeout(function(){cmsInitQuill("")},100);
}

function cmsEditPost(id){
  var p=null;
  for(var i=0;i<cmsPosts.length;i++){if(cmsPosts[i].id===id){p=cmsPosts[i];break}}
  if(!p){showToast("未找到","error");return}
  document.getElementById("cmsFormTitle").textContent="编辑文章 #"+p.id;
  document.getElementById("cmsPEid").value=p.id;
  document.getElementById("cmsPTitle").value=p.title||"";
  document.getElementById("cmsPAuthor").value=p.author||"";
  document.getElementById("cmsPCat").value=p.category||(cmsCategories.length?cmsCategories[0].name:"");
  document.getElementById("cmsPSummary").value=p.excerpt||"";
  document.getElementById("cmsPostForm").style.display="block";
  // Restore channel selections
  var saved=p.publish_channels||[];
  setTimeout(function(){
    document.querySelectorAll(".cmsChLocal").forEach(function(cb){
      cb.checked=saved.indexOf(cb.value)>=0;
    });
    document.querySelectorAll(".cmsChSocial").forEach(function(cb){
      cb.checked=saved.indexOf(cb.value)>=0;
    });
    cmsInitQuill(p.content||"")
  },100);
}

function cmsCloseForm(){
  document.getElementById("cmsPostForm").style.display="none";
}

// ── Save Draft & Publish ──

function cmsGetFormData(){
  var body=cmsQuill?cmsQuill.root.innerHTML:"";
  return {
    title: document.getElementById("cmsPTitle").value.trim(),
    author: document.getElementById("cmsPAuthor").value.trim(),
    content: body,
    excerpt: document.getElementById("cmsPSummary").value.trim(),
    category: document.getElementById("cmsPCat").value,
    slug: "article-"+Date.now()
  };
}

function cmsGetSelectedChannels(){
  var channels=[];
  document.querySelectorAll(".cmsChLocal:checked").forEach(function(cb){channels.push(cb.value)});
  document.querySelectorAll(".cmsChSocial:checked").forEach(function(cb){channels.push(cb.value)});
  return channels;
}

function cmsSaveDraft(){
  var data=cmsGetFormData();
  if(!data.title||!data.content||data.content==="<p><br></p>"){showToast("标题和正文不能为空","error");return}
  data.is_published=0;
  data.publish_channels=[];
  var eid=document.getElementById("cmsPEid").value;
  if(eid)data.id=parseInt(eid);
  showToast("保存中...","");
  var url=eid?"/admin/cms/posts/"+eid:"/admin/cms/posts";
  var method=eid?"PUT":"POST";
  fetch(url,{method:method,headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(data)}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("草稿已保存","success");cmsCloseForm();cmsLoadPosts()}
    else{showToast(d.error||"保存失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cmsPublishPost(){
  var data=cmsGetFormData();
  if(!data.title||!data.content||data.content==="<p><br></p>"){showToast("标题和正文不能为空","error");return}
  var channels=cmsGetSelectedChannels();
  if(!channels.length){showToast("请至少选择一个发布渠道","error");return}
  data.is_published=1;
  data.publish_channels=channels;
  var eid=document.getElementById("cmsPEid").value;
  if(eid)data.id=parseInt(eid);
  showToast("发布中...","");
  // Step 1: save post
  var url=eid?"/admin/cms/posts/"+eid:"/admin/cms/posts";
  var method=eid?"PUT":"POST";
  fetch(url,{method:method,headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(data)}).then(function(r){return r.json()}).then(function(d){
    if(!d.success){showToast(d.error||"保存失败","error");return}
    var savedId=eid||d.data.id;
    // Check if any social platforms are selected
    var socialChannels=channels.filter(function(ch){return ch!=='local'&&!ch.startsWith('local:')});
    if(!socialChannels.length){
      showToast("已发布到本地栏目","success");
      cmsCloseForm();
      cmsLoadPosts();
      return;
    }
    // Step 2: publish to social
    fetch("/admin/cms/posts/"+savedId+"/publish",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({channels:socialChannels,auto_publish:true})}).then(function(r2){return r2.json()}).then(function(d2){
      if(d2.success){
        var msgs=(d2.data.results.social||[]).map(function(r){return r.platform+": "+(r.message||r.status)});
        showToast("发布完成: "+msgs.join(" | "),"success");
      }else{showToast(d2.error||"社媒发布失败","error")}
      cmsCloseForm();
      cmsLoadPosts();
    }).catch(function(){showToast("社媒发布请求失败","error");cmsCloseForm();cmsLoadPosts()});
  }).catch(function(){showToast("保存失败","error")});
}

function cmsDelPost(id){
  if(!confirm("确定删除文章 #"+id+"？"))return;
  fetch("/admin/cms/posts/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("已删除","success");cmsLoadPosts()}
    else{showToast(d.error||"删除失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cmsAiformat(){
  var body=cmsQuill?cmsQuill.root.innerHTML:"";
  var title=document.getElementById("cmsPTitle").value.trim();
  if(!body||body==="<p><br></p>"){showToast("正文不能为空","error");return}
  showToast("AI排版中（约10秒）...","");
  fetch("/admin/content-factory/ai-format",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({content:body,title:title})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){cmsQuill.root.innerHTML=d.formatted;showToast("排版完成","success")}
    else{showToast(d.error||"排版失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cmsAicover(){
  var title=document.getElementById("cmsPTitle").value.trim()||"文章配图";
  var p=prompt("配图描述（留空自动生成）:",title+" 科技金融 深色科幻");
  if(p===null)return;
  showToast("AI生成配图中（约30秒）...","");
  fetch("/admin/content-factory/ai-cover",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({title:title,prompt:p||""})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){
      var img='<p><img src="'+d.image_url+'" alt="配图" style="max-width:100%;border-radius:8px"></p>';
      cmsQuill.clipboard.dangerouslyPasteHTML(cmsQuill.getLength(),img);
      showToast("配图已插入","success")
    }else{showToast(d.error||"配图失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

// ── Publish History ──

var cmsHistoryVisible=false;
function cmsToggleSocialHistory(){
  cmsHistoryVisible=!cmsHistoryVisible;
  var wrap=document.getElementById("cmsSocialHistoryWrap");
  if(!cmsHistoryVisible){wrap.style.display="none";return}
  wrap.style.display="block";
  wrap.innerHTML='<div class="cd"><div class="s"></div>加载中...</div>';
  fetch("/admin/social/history?limit=50",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data){wrap.innerHTML='<div class="cd"><div class="em">暂无发布记录</div></div>';return}
    var items=d.data.items||[];
    if(!items.length){wrap.innerHTML='<div class="cd"><div class="em">暂无发布记录</div></div>';return}
    var h='<div class="cd"><div class="st">发布历史（社媒）</div><table><tr><th>平台</th><th>标题</th><th>类型</th><th>状态</th><th>时间</th></tr>';
    items.forEach(function(r){
      var stHtml={published:'<span class="bdg on">已发布</span>',draft:'<span class="bdg pd">草稿</span>',publishing:'<span class="bdg pd">发布中</span>',failed:'<span class="bdg off">失败</span>'}[r.status]||'<span class="bdg pd">'+r.status+'</span>';
      h+='<tr><td>'+r.platform+'</td><td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;font-weight:600">'+esc(r.title||"-")+'</td><td style="font-size:10px">'+r.content_type+'</td><td>'+stHtml+'</td><td style="font-size:10px">'+(r.created_at||"").slice(0,16)+'</td></tr>';
    });
    h+='</table></div>';
    wrap.innerHTML=h;
  }).catch(function(){wrap.innerHTML='<div class="cd"><div class="em">请求失败</div></div>'});
}

// ── Category Management Modal ──

function cmsManageCategories(){
  var h='<div class="modal-overlay" onclick="if(event.target===this)cmsCloseModal()">';
  h+='<div class="modal-box" style="width:500px">';
  h+='<h3>栏目管理 <span style="font-size:11px;font-weight:400;color:var(--dim)">CMS 本地发布栏目</span></h3>';
  h+='<div style="margin-bottom:10px;display:flex;gap:6px">';
  h+='<input class="in" id="catInput" placeholder="栏目名称" style="flex:1">';
  h+='<input class="in" id="catIcon" placeholder="图标(emoji)" style="width:50px" value="📄">';
  h+='<button class="btn bp" onclick="cmsAddCategory()">+ 添加</button></div>';
  h+='<div id="catList"><div class="lo"><div class="s"></div></div></div>';
  h+='<div style="margin-top:10px"><button class="btn bo" onclick="cmsCloseModal()">关闭</button></div>';
  h+='</div></div>';
  var m=document.createElement("div");
  m.id="cmsCatModal";
  m.innerHTML=h;
  document.body.appendChild(m);
  cmsReloadCategoryList();
}

function cmsReloadCategoryList(){
  var el=document.getElementById("catList");
  if(!el)return;
  fetch("/admin/cms/categories",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data){el.innerHTML='<div class="em">加载失败</div>';return}
    var cats=d.data;
    if(!cats.length){el.innerHTML='<div class="em">暂无栏目，请添加</div>';return}
    var h='<table><tr><th>排序</th><th>图标</th><th>名称</th><th>状态</th><th>操作</th></tr>';
    cats.forEach(function(c,i){
      var st=c.is_active?'<span class="bdg on">启用</span>':'<span class="bdg off">停用</span>';
      h+='<tr>';
      h+='<td style="font-size:10px">'+(i+1)+'</td>';
      h+='<td style="font-size:16px">'+esc(c.icon||'📄')+'</td>';
      h+='<td>'+esc(c.name)+'</td>';
      h+='<td>'+st+'</td>';
      h+='<td>';
      h+='<button class="btn bo bs" onclick="cmsEditCategory('+c.id+','+c.is_active+')">'+(c.is_active?'停用':'启用')+'</button> ';
      h+='<button class="btn bo bs" onclick="cmsDelCategory('+c.id+',\''+esc(c.name)+'\')">删除</button>';
      h+='</td></tr>';
    });
    h+='</table>';
    el.innerHTML=h;
  }).catch(function(){var el=document.getElementById("catList");if(el)el.innerHTML='<div class="em">请求失败</div>'});
}

function cmsAddCategory(){
  var name=document.getElementById("catInput").value.trim();
  if(!name){showToast("请输入栏目名称","error");return}
  var icon=document.getElementById("catIcon").value.trim()||"📄";
  fetch("/admin/cms/categories",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({name:name,icon:icon})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("已添加","success");document.getElementById("catInput").value="";cmsReloadCategoryList()}
    else{showToast(d.error||"添加失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cmsEditCategory(id,wasActive){
  fetch("/admin/cms/categories/"+id,{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({is_active:wasActive?0:1})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("已更新","success");cmsReloadCategoryList()}
    else{showToast(d.error||"更新失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cmsDelCategory(id,name){
  if(!confirm("确定删除栏目「"+name+"」？"))return;
  fetch("/admin/cms/categories/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("已删除","success");cmsReloadCategoryList()}
    else{showToast(d.error||"删除失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cmsCloseModal(){
  var m=document.getElementById("cmsCatModal");
  if(m)m.remove();
}

// ============================
// 社媒推送
// ============================
window.l_social=function(){
  go("cms");return;
  var h='';
  h+='<div style="margin-bottom:12px;display:flex;gap:4px;flex-wrap:wrap">';
  h+='<button class="btn bp" onclick="socialTab(0)" id="soc-t0">文章编辑</button>';
  h+='<button class="btn bo" onclick="socialTab(1)" id="soc-t1">🎨 配图</button>';
  h+='<button class="btn bo" onclick="socialTab(2)" id="soc-t2">📤 发布</button>';
  h+='<span style="flex:1"></span>';
  h+='<span id="socConfigStatus" style="font-size:10px;color:var(--dim);align-self:center"></span>';
  h+='</div><div id="socContent"></div>';
  document.getElementById("mc").innerHTML=h;
  // Show config status
  fetch("/admin/social/check-config",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success)return;
    var st=[];
    d.data.platforms.forEach(function(p){
      if(p.configured)st.push(p.icon+" "+p.name+"✅");
      else st.push(p.icon+" "+p.name+"❌");
    });
    document.getElementById("socConfigStatus").textContent=st.join(" | ");
  }).catch(function(){});
  socialTab(0);
};

var socArticle={title:"",summary:"",body_html:""};
var socCoverUrl="";

function socialTab(n){
  document.querySelectorAll('[id^="soc-t"]').forEach(function(e){e.className="btn bo"});
  var el=document.getElementById("soc-t"+n);
  if(el)el.className="btn bp";
  if(n===0)socialEditor();
  else if(n===1)socialImageGen();
  else if(n===2)socialPublish();
}

// ── Tab 0: 文章编辑 ──
function socialEditor(){
  var h='<div class="cd"><div class="st">编辑内容</div>';
  h+='<div class="fl"><div style="font-size:11px;color:var(--dim);width:60px">平台</div>';
  h+='<select class="sl" id="socPlatform" style="flex:1" onchange="socialUpdateContentTypes()"><option value="wechat">公众号文章</option><option value="weibo">微博</option></select></div>';
  h+='<div class="fl"><div style="font-size:11px;color:var(--dim);width:60px">类型</div>';
  h+='<select class="sl" id="socType" style="flex:1"><option value="article">文章</option><option value="announcement">通知</option><option value="promotion">推广</option></select></div>';
  h+='<div class="fl"><div style="font-size:11px;color:var(--dim);width:60px">主题</div><input class="in" id="socTopic" placeholder="输入主题，如：AI 改变金融行业" style="flex:1"></div>';
  h+='<div style="margin-top:8px;display:flex;gap:8px">';
  h+='<button class="btn bp" onclick="socialGen()">🤖 AI 生成</button>';
  h+='<button class="btn bo" onclick="socialClearEditor()">清空</button></div></div>';
  h+='<button class="btn bo" onclick="socialImportFromCMS()">📥 从CMS导入</button>';

  h+='<div class="cd" style="margin-top:12px"><div class="st">内容</div>';
  h+='<div class="fl"><div style="font-size:11px;color:var(--dim);width:60px">标题</div><input class="in" id="socTitle" placeholder="标题" style="flex:1" value="'+esc(socArticle.title)+'"></div>';
  h+='<div class="fl" id="socSummaryRow"><div style="font-size:11px;color:var(--dim);width:60px">摘要</div><input class="in" id="socSummary" placeholder="摘要（选填）" style="flex:1" value="'+esc(socArticle.summary)+'"></div>';
  h+='<div style="font-size:11px;color:var(--dim);margin:8px 0 4px">正文</div>';
  h+='<textarea class="ta" id="socBody" style="min-height:200px;width:100%" placeholder="正文内容...">'+esc(socArticle.body_html)+'</textarea>';
  h+='<div style="margin-top:6px;display:flex;gap:6px"><button class="btn bo bs" onclick="socAiformat()">🤖 AI排版</button><button class="btn bo bs" onclick="socAicover()">🎨 AI配图</button></div>';
  h+='<div id="socCmsImportList" style="margin-top:8px;display:none"></div>';
  h+='</div>';

  document.getElementById("socContent").innerHTML=h;
}



function socialImportFromCMS(){
  var el=document.getElementById("socCmsImportList");
  if(!el){showToast("请先在编辑器中使用此功能","error");return}
  if(el.style.display!="none"&&el.innerHTML){el.style.display="none";return}
  el.style.display="block";
  el.innerHTML='<div class="lo"><div class="s"></div>加载CMS文章...</div>';
  fetch("/admin/social/import-from-cms",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data){el.innerHTML='<div class="em">加载失败</div>';return}
    var posts=d.data;
    if(!posts.length){el.innerHTML='<div class="em">暂无已发布的CMS文章</div>';return}
    var h='<div class="st" style="font-size:12px">选择CMS文章导入</div><table><tr><th>标题</th><th>分类</th><th>时间</th><th>操作</th></tr>';
    posts.forEach(function(p){
      h+='<tr><td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;font-weight:600">'+esc(p.title)+'</td>';
      h+='<td>'+esc(p.category)+'</td>';
      h+='<td style="font-size:10px;color:var(--dim)">'+(p.published_at||p.created_at||'').slice(0,10)+'</td>';
      h+='<td><button class="btn bo bs" onclick="socialImportCMSArticle('+p.id+')">导入</button></td></tr>';
    });
    h+='</table><div style="margin-top:8px"><button class="btn bo bs" onclick="document.getElementById(&#39;socCmsImportList&#39;).style.display=&#39;none&#39;">关闭</button></div>';
    el.innerHTML=h;
  }).catch(function(){el.innerHTML='<div class="em">请求失败</div>'});
}

function socialImportCMSArticle(id){
  fetch("/admin/social/import-from-cms",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data){showToast("加载失败","error");return}
    var post=null;
    for(var i=0;i<d.data.length;i++){if(d.data[i].id===id){post=d.data[i];break}}
    if(!post){showToast("文章不存在","error");return}
    socArticle.title=post.title||"";
    socArticle.summary=post.excerpt||"";
    socArticle.body_html=post.content||"";
    socCoverUrl=post.cover_image||"";
    socialEditor();
    showToast("已导入: "+post.title,"success");
    var el=document.getElementById("socCmsImportList");
    if(el)el.style.display="none";
  }).catch(function(){showToast("请求失败","error")});
}

function socAiformat(){
  var body=document.getElementById("socBody").value;
  var title=document.getElementById("socTitle").value.trim();
  if(!body){showToast("正文不能为空","error");return}
  showToast("AI排版中（约10秒）...","");
  fetch("/admin/content-factory/ai-format",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({content:body,title:title})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){document.getElementById("socBody").value=d.formatted;showToast("排版完成","success")}
    else{showToast(d.error||"排版失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function socAicover(){
  var title=document.getElementById("socTitle").value.trim()||"文章配图";
  var p=prompt("配图描述（留空自动生成）:",title+" 科技金融 深色科幻");
  if(p===null)return;
  showToast("AI生成配图中（约30秒）...","");
  fetch("/admin/content-factory/ai-cover",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({title:title,prompt:p||""})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){
      var img='<img src="'+d.image_url+'" style="max-width:100%;border-radius:8px">';
      document.getElementById("socBody").value+="\n\n[配图] "+d.image_url;
      showToast("配图已生成，URL已插入正文底部","success")
    }else{showToast(d.error||"配图失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function socialUpdateContentTypes(){
  var platform=document.getElementById("socPlatform").value;
  var typeSel=document.getElementById("socType");
  var summaryRow=document.getElementById("socSummaryRow");
  if(platform==="weibo"){
    typeSel.innerHTML='<option value="weibo">微博</option>';
    if(summaryRow)summaryRow.style.display="none";
  }else{
    typeSel.innerHTML='<option value="article">文章</option><option value="announcement">通知</option><option value="promotion">推广</option>';
    if(summaryRow)summaryRow.style.display="flex";
  }
}

function socialClearEditor(){
  document.getElementById("socTitle").value="";
  document.getElementById("socSummary").value="";
  document.getElementById("socBody").value="";
}

function socialGen(){
  var topic=document.getElementById("socTopic").value.trim();
  var type=document.getElementById("socType").value;
  if(!topic){showToast("请输入主题","error");return}
  document.getElementById("socContent").innerHTML='<div class="lo"><div class="s"></div>AI 生成中...</div>';
  fetch("/admin/social/generate",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({topic:topic,content_type:type})})
    .then(function(r){return r.json()}).then(function(d){
      if(!d.success){document.getElementById("socContent").innerHTML='<div class="em">'+esc(d.error||"生成失败")+'</div>';return}
      var a=d.data;
      socArticle={title:a.title||"",summary:a.summary||"",body_html:a.body_html||""};
      socialEditor();
      showToast("生成完成","success");
    }).catch(function(){document.getElementById("socContent").innerHTML='<div class="em">请求失败</div>'});
}

// ── Tab 1: 配图 ──
function socialImageGen(){
  var h='<div class="cd"><div class="st">AI 配图生成（通义万相）</div>';
  h+='<div class="fl"><div style="font-size:11px;color:var(--dim);width:60px">描述</div><input class="in" id="socImgPrompt" placeholder="描述图片效果，如：水墨山水画" style="flex:1"></div>';
  h+='<div style="margin:8px 0;display:flex;gap:12px">';
  h+='<label style="font-size:11px;display:flex;align-items:center;gap:4px"><input type="checkbox" id="socIsCover" checked> 作为封面图</label></div>';
  h+='<button class="btn bp" onclick="socialGenImage()">🎨 生成图片</button>';
  h+='</div>';
  h+='<div id="socImgResult" style="margin-top:12px"></div>';
  if(socCoverUrl){
    h+='<div class="cd"><div class="st">当前封面</div><img src="'+esc(socCoverUrl)+'" style="max-width:100%;max-height:300px;border-radius:8px">';
    h+='<div style="margin-top:8px"><button class="btn bo" onclick="socCoverUrl=\'\';showToast(\'已清除\',\'success\')">清除封面</button></div></div>';
  }
  document.getElementById("socContent").innerHTML=h;
}

function socialGenImage(){
  var prompt=document.getElementById("socImgPrompt").value.trim();
  var isCover=document.getElementById("socIsCover").checked;
  var title=socArticle.title;
  if(!prompt&&!title){showToast("请输入图片描述","error");return}
  document.getElementById("socImgResult").innerHTML='<div class="lo"><div class="s"></div>通义万相生成中...</div>';
  fetch("/admin/social/generate-image",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({prompt:prompt,title:title,cover:isCover})})
    .then(function(r){return r.json()}).then(function(d){
      if(!d.success){document.getElementById("socImgResult").innerHTML='<div class="em">'+esc(d.error||"生成失败")+'</div>';return}
      var url=d.data.image_url;
      socCoverUrl=url;
      var h='<div class="cd"><div class="st">生成结果</div>';
      h+='<img src="'+esc(url)+'" style="max-width:100%;max-height:350px;border-radius:8px">';
      h+='<div style="margin-top:8px;display:flex;gap:8px">';
      h+='<button class="btn bp" onclick="socCoverUrl=\''+esc(url)+'\';showToast(\'已设为封面\',\'success\')">设为封面</button>';
      h+='<button class="btn bo" onclick="window.open(\''+esc(url)+'\',\'_blank\')">查看原图</button></div></div>';
      document.getElementById("socImgResult").innerHTML=h;
      showToast("图片已生成","success");
    }).catch(function(){document.getElementById("socImgResult").innerHTML='<div class="em">请求失败</div>'});
}

// ── Tab 2: 发布 ──
function socialPublish(){
  fetch("/admin/social/check-config",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(cfg){
    var platforms=cfg.success?cfg.data.platforms:[];
    var h='';

    // Platform selection
    h+='<div class="cd"><div class="st">推送到</div>';
    h+='<div style="display:flex;gap:12px;flex-wrap:wrap">';
    platforms.forEach(function(p){
      var checked=p.configured?"checked":"";
      var disabled=p.configured?"":"disabled";
      h+='<label style="font-size:12px;display:flex;align-items:center;gap:4px;opacity:'+(p.configured?1:0.4)+'">';
      h+='<input type="checkbox" class="socPlatformCheck" value="'+p.id+'" '+checked+' '+disabled+'>';
      h+=p.icon+' '+p.name;
      if(!p.configured)h+=' <span style="font-size:9px;color:var(--dim)">(未配置)</span>';
      h+='</label>';
    });
    h+='</div></div>';

    // Any platform configured?
    var hasAny=platforms.some(function(p){return p.configured});
    if(!hasAny){
      h+='<div class="cd"><div class="st">⚠️ 暂无已配置平台</div>';
      h+='<p style="font-size:12px;color:var(--dim)">请先在「系统设置」中配置公众号、微博或通义万相的 API Key</p>';
      h+='<button class="btn bp" onclick="go(\'config\')">前往配置</button></div>';
      document.getElementById("socContent").innerHTML=h;
      return;
    }

    // Preview
    h+='<div class="cd"><div class="st">预览</div>';
    h+='<div style="font-size:13px;font-weight:600;margin-bottom:8px">'+esc(socArticle.title||"（无标题）")+'</div>';
    h+='<div style="font-size:11px;color:var(--dim);margin-bottom:8px">'+esc(socArticle.summary||"")+'</div>';
    if(socCoverUrl){
      h+='<img src="'+esc(socCoverUrl)+'" style="max-width:100%;max-height:200px;border-radius:8px;margin-bottom:8px">';
    }
    h+='<div style="font-size:12px;max-height:250px;overflow-y:auto;border:1px solid var(--border);padding:12px;border-radius:8px;background:var(--bg2)">'+(socArticle.body_html||"（无正文）")+'</div>';
    h+='</div>';

    // Publish
    h+='<div class="cd" style="margin-top:12px"><div class="st">发布</div>';
    h+='<label style="font-size:12px;display:flex;align-items:center;gap:6px;margin-bottom:8px"><input type="checkbox" id="socAutoPub"> 微信直接发布（不勾选=仅存草稿；微博始终直接发布）</label>';
    h+='<button class="btn bp" onclick="socialDoPublish()">📤 发送到选中平台</button>';
    h+='</div>';

    // History
    h+='<div class="cd" style="margin-top:12px"><div class="st">推送历史</div><div id="socHistory"><div class="lo"><div class="s"></div></div></div></div>';

    document.getElementById("socContent").innerHTML=h;
    loadSocialHistory();
  }).catch(function(){document.getElementById("socContent").innerHTML='<div class="em">检查配置失败</div>'});
}

function socialDoPublish(){
  var te=document.getElementById("socTitle");
  var se=document.getElementById("socSummary");
  var be=document.getElementById("socBody");
  if(te&&te.value) socArticle.title=te.value;
  if(se&&se.value) socArticle.summary=se.value;
  if(be&&be.value) socArticle.body_html=be.value;

  if(!socArticle.title||!socArticle.body_html){showToast("标题和正文不能为空","error");return}

  // Get selected platforms
  var platforms=[];
  document.querySelectorAll(".socPlatformCheck:checked").forEach(function(cb){platforms.push(cb.value)});
  if(!platforms.length){showToast("请至少选择一个平台","error");return}

  var autoPub=document.getElementById("socAutoPub")&&document.getElementById("socAutoPub").checked;

  fetch("/admin/social/publish",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({
    title:socArticle.title,
    body:socArticle.body_html,
    body_html:socArticle.body_html,
    summary:socArticle.summary,
    author:"admin",
    cover_image_url:socCoverUrl||"",
    platforms:platforms,
    auto_publish:autoPub,
  })}).then(function(r){return r.json()}).then(function(d){
    if(d.success){
      var msgs=d.data.results.map(function(r){return r.platform+": "+(r.message||r.error||r.status)});
      showToast(msgs.join(" | "),d.data.results.some(function(r){return r.status=="failed"})?"error":"success");
      loadSocialHistory();
    }else{
      showToast(d.error||"发送失败","error");
    }
  }).catch(function(){showToast("请求失败","error")});
}

function loadSocialHistory(){
  var el=document.getElementById("socHistory");
  if(!el)return;
  fetch("/admin/social/history?limit=20",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data){el.innerHTML='<div class="em">加载失败</div>';return}
    var items=d.data.items;
    if(!items||!items.length){el.innerHTML='<div class="em">暂无推送记录</div>';return}
    var h='<table><tr><th>平台</th><th>标题</th><th>状态</th><th>ID</th><th>时间</th><th>操作</th></tr>';
    var statusMap={draft:"草稿",publishing:"发布中",published:"已发布",failed:"失败"};
    var platformIcon={wechat:"💬",weibo:"📢",toutiao:"📰"};
    items.forEach(function(r){
      var st=statusMap[r.status]||r.status;
      var stCls=r.status==="published"?"on":(r.status==="failed"?"off":"pd");
      var icon=platformIcon[r.platform]||"📤";
      h+='<tr><td>'+icon+'</td>';
      h+='<td style="max-width:180px;overflow:hidden;text-overflow:ellipsis">'+esc(r.title)+'</td>';
      h+='<td><span class="bdg '+stCls+'">'+st+'</span></td>';
      h+='<td style="font-size:10px;font-family:monospace">'+(r.publish_id||r.media_id?"#"+esc(r.publish_id||r.media_id):"-")+'</td>';
      h+='<td style="font-size:11px;color:var(--dim)">'+(r.created_at||"")+'</td>';
      h+='<td><button class="btn bo bs" onclick="socialDeleteHistory('+r.id+')">删除</button></td></tr>';
    });
    h+='</table><div style="font-size:10px;color:var(--dim);margin-top:8px">共 '+d.data.total+' 条</div>';
    el.innerHTML=h;
  }).catch(function(){el.innerHTML='<div class="em">加载失败</div>'});
}

function socialDeleteHistory(id){
  if(!confirm("确定删除？"))return;
  fetch("/admin/social/history/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){loadSocialHistory();showToast("已删除","success")}
    else{showToast(d.error||"删除失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}


// ============================
// 🌐 社区板块管理
// ============================
window.l_community=function(){
  document.getElementById("pt").textContent="社区板块管理";
  var h='<div style="margin-bottom:12px"><button class="btn bp" onclick="showSectionForm()">+ 添加板块</button></div>';
  h+='<div id="sectionForm" style="display:none;margin-bottom:16px" class="cd"><div class="st" id="sectionFormTitle">添加板块</div>';
  h+='<div class="g2">';
  h+='<div><div style="font-size:11px;color:var(--dim)">名称</div><input class="in" id="secName" placeholder="如：Agent广场" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">图标 (emoji)</div><input class="in" id="secIcon" placeholder="🏛️" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">路径</div><input class="in" id="secPath" placeholder="/plaza" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">排序</div><input class="in" id="secOrder" placeholder="自动" style="width:100%"></div>';
  h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">描述</div><textarea class="ta" id="secDesc" rows="2" placeholder="板块说明..."></textarea></div>';
  h+='</div><div style="margin-top:10px"><button class="btn bp" onclick="saveSection()">保存</button> <button class="btn bo" onclick="hideSectionForm()">取消</button><input type="hidden" id="secEditId" value=""></div></div>';
  h+='<div id="sectionList"><div class="lo"><div class="s"></div></div></div>';
  document.getElementById("mc").innerHTML=h;
  loadSections();
};

var sectionsData=[];

function loadSections(){
  fetch("/admin/community/sections",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success){document.getElementById("sectionList").innerHTML='<div class="em">加载失败</div>';return}
    sectionsData=d.data||[];
    var h='<div class="cd"><div class="st">社区板块列表 ('+sectionsData.length+')</div><table><tr><th>排序</th><th>图标</th><th>名称</th><th>路径</th><th>描述</th><th>状态</th><th>操作</th></tr>';
    if(!sectionsData.length){h+='<tr><td colspan="7"><div class="em">暂无板块</div></td></tr>'}
    else{
      sectionsData.forEach(function(s){
        var st=s.is_active?'<span class="bdg on">启用</span>':'<span class="bdg off">禁用</span>';
        var toggleBtn=s.is_active?('禁用'):('启用');
        h+='<tr><td>'+s.sort_order+'</td><td style="font-size:16px">'+(s.icon||"📄")+'</td><td style="font-weight:600">'+esc(s.name)+'</td>'+
          '<td style="font-family:monospace;color:var(--accent)">'+esc(s.path)+'</td>'+
          '<td style="color:var(--dim);max-width:200px;overflow:hidden;text-overflow:ellipsis">'+esc(s.description)+'</td><td>'+st+'</td>'+
          '<td><button class="btn bo bs" onclick="toggleSection('+s.id+','+s.is_active+')">'+toggleBtn+'</button> '+
          '<button class="btn bo bs" onclick="editSection('+s.id+')">编辑</button> '+
          '<button class="btn bo bs" onclick="deleteSection('+s.id+')">删除</button></td></tr>';
      });
    }
    h+='</table></div>';
    document.getElementById("sectionList").innerHTML=h;
  }).catch(function(){document.getElementById("sectionList").innerHTML='<div class="em">加载失败</div>'});
}

function showSectionForm(){
  document.getElementById("sectionForm").style.display="block";
  document.getElementById("sectionFormTitle").textContent="添加板块";
  document.getElementById("secEditId").value="";
  document.getElementById("secName").value="";
  document.getElementById("secIcon").value="📄";
  document.getElementById("secPath").value="";
  document.getElementById("secDesc").value="";
  document.getElementById("secOrder").value="";
}

function hideSectionForm(){
  document.getElementById("sectionForm").style.display="none";
}

function saveSection(){
  var eid=document.getElementById("secEditId").value;
  var name=document.getElementById("secName").value.trim();
  var icon=document.getElementById("secIcon").value.trim()||"📄";
  var path=document.getElementById("secPath").value.trim();
  var desc=document.getElementById("secDesc").value.trim();
  var order=parseInt(document.getElementById("secOrder").value)||0;
  if(!name||!path){showToast("名称和路径不能为空","error");return}
  var method=eid?"PUT":"POST";
  var url="/admin/community/sections"+(eid?"/"+eid:"");
  var body={name:name,icon:icon,path:path,description:desc,sort_order:order};
  fetch(url,{method:method,headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(body)}).then(function(r){return r.json()}).then(function(d){
    if(d.success){hideSectionForm();loadSections();showToast("保存成功","success")}
    else{showToast(d.error||"保存失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function editSection(id){
  var s=null;
  for(var i=0;i<sectionsData.length;i++){if(sectionsData[i].id===id){s=sectionsData[i];break}}
  if(!s){showToast("未找到板块","error");return}
  document.getElementById("sectionForm").style.display="block";
  document.getElementById("sectionFormTitle").textContent="编辑板块";
  document.getElementById("secEditId").value=s.id;
  document.getElementById("secName").value=s.name;
  document.getElementById("secIcon").value=s.icon||"📄";
  document.getElementById("secPath").value=s.path;
  document.getElementById("secDesc").value=s.description||"";
  document.getElementById("secOrder").value=s.sort_order;
}

function deleteSection(id){
  if(!confirm("确定删除此板块？"))return;
  fetch("/admin/community/sections/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){loadSections();showToast("已删除","success")}
    else{showToast(d.error||"删除失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function toggleSection(id,current){
  fetch("/admin/community/sections/"+id,{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({is_active:current?0:1})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){loadSections();showToast("状态已更新","success")}
    else{showToast(d.error||"操作失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}


// ============================
// 🏭 内容工厂
// ============================
var cfTab=0, cfSources=[], cfRawContents=[], cfProcessed=[];

window.l_contentfactory=function(){
  document.getElementById("pt").textContent="内容工厂";
  var h='<div style="margin-bottom:12px">';
  h+='<button class="btn '+(cfTab===0?'bp':'bo')+'" onclick="cfSwitchTab(0)">📡 来源管理</button> ';
  h+='<button class="btn '+(cfTab===1?'bp':'bo')+'" onclick="cfSwitchTab(1)">📥 原始内容</button> ';
  h+='<button class="btn '+(cfTab===2?'bp':'bo')+'" onclick="cfSwitchTab(2)">✏️ 加工内容</button> ';
  h+='</div><div id="cfTabContent"><div class="lo"><div class="s"></div></div></div>';
  document.getElementById("mc").innerHTML=h;
  cfRenderTab();
};

function cfSwitchTab(t){
  cfTab=t;
  var btns=document.getElementById("mc").querySelectorAll("button");
  btns.forEach(function(b,i){b.className=b.className.replace(/btn bp/g,"btn bo");if(i===t)b.className="btn bp"});
  cfRenderTab();
}

function cfRenderTab(){
  if(cfTab===0)cfRenderSources();
  else if(cfTab===1)cfRenderRaw();
  else if(cfTab===2)cfRenderProcessed();
}

// ── Tab 0: 来源管理 ──
function cfRenderSources(){
  var h='<div style="margin-bottom:10px"><button class="btn bp" onclick="cfShowSourceForm()">+ 添加来源</button></div>';
  h+='<div id="cfSourceForm" style="display:none;margin-bottom:14px" class="cd">';
  h+='<div class="st" id="cfSfTitle">添加来源</div><div class="g2">';
  h+='<div><div style="font-size:11px;color:var(--dim)">名称</div><input class="in" id="cfSn" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">类型</div><select class="sl" id="cfSt" style="width:100%"><option value="rss">RSS</option><option value="api">API</option><option value="web">网页</option></select></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">URL</div><input class="in" id="cfSu" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">采集间隔(秒,0=手动)</div><input class="in" id="cfSi" value="0" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">每轮最多</div><input class="in" id="cfSm" value="10" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">关键词过滤</div><input class="in" id="cfSk" style="width:100%"></div>';
  h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">平台标识(可选)</div><input class="in" id="cfSp" placeholder="rss/xueqiu/sec" style="width:100%"></div>';
  h+='</div><div style="margin-top:8px"><button class="btn bp" onclick="cfSaveSource()">保存</button> <button class="btn bo" onclick="cfHideSourceForm()">取消</button><input type="hidden" id="cfSeid"></div></div>';
  h+='<div class="cd"><div class="st">采集来源 <span id="cfScnt">0</span></div>';
  h+='<table><tr><th>名称</th><th>类型</th><th>URL</th><th>间隔</th><th>上次采集</th><th>状态</th><th>操作</th></tr><tbody id="cfStbody"></tbody></table></div>';
  document.getElementById("cfTabContent").innerHTML=h;
  cfLoadSources();
}

function cfLoadSources(){
  fetch("/admin/content-factory/sources",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success){document.getElementById("cfStbody").innerHTML='<tr><td colspan="7"><div class="em">加载失败</div></td></tr>';return}
    cfSources=d.data||[];
    document.getElementById("cfScnt").textContent=cfSources.length;
    var h='';
    if(!cfSources.length){h='<tr><td colspan="7"><div class="em">暂无来源</div></td></tr>'}
    else{cfSources.forEach(function(s){
      h+='<tr><td style="font-weight:600">'+esc(s.name)+'</td><td><span class="bdg '+(s.source_type==='rss'?'on':'pd')+'">'+s.source_type+'</span></td>';
      h+='<td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;font-family:monospace;font-size:10px">'+esc(s.url)+'</td>';
      h+='<td>'+(s.crawl_interval?s.crawl_interval+'s':'手动')+'</td>';
      h+='<td style="font-size:10px;color:var(--dim)">'+(s.last_crawled_at||'-')+'</td>';
      h+='<td>'+(s.is_active?'<span class="bdg on">启用</span>':'<span class="bdg off">禁用</span>')+'</td>';
      h+='<td><button class="btn bo bs" onclick="cfRunCrawl('+s.id+')">抓取</button> ';
      h+='<button class="btn bo bs" onclick="cfEditSource('+s.id+')">编辑</button> ';
      h+='<button class="btn bo bs" onclick="cfDelSource('+s.id+')">删除</button></td></tr>';
    })}
    document.getElementById("cfStbody").innerHTML=h;
  }).catch(function(){document.getElementById("cfStbody").innerHTML='<tr><td colspan="7"><div class="em">请求失败</div></td></tr>'});
}

function cfShowSourceForm(){
  document.getElementById("cfSourceForm").style.display="block";
  document.getElementById("cfSfTitle").textContent="添加来源";
  document.getElementById("cfSeid").value="";
  var fid=["cfSn","cfSt","cfSu","cfSi","cfSm","cfSk","cfSp"];
  for(var i=0;i<fid.length;i++){document.getElementById(fid[i]).value=""};
}

function cfHideSourceForm(){document.getElementById("cfSourceForm").style.display="none"}

function cfSaveSource(){
  var eid=document.getElementById("cfSeid").value;
  var name=document.getElementById("cfSn").value.trim();
  var st=document.getElementById("cfSt").value;
  var url=document.getElementById("cfSu").value.trim();
  if(!name||!url){showToast("名称和URL不能为空","error");return}
  var body={name:name,source_type:st,url:url,
    crawl_interval:parseInt(document.getElementById("cfSi").value)||0,
    max_per_run:parseInt(document.getElementById("cfSm").value)||10,
    keywords:document.getElementById("cfSk").value.trim(),
    platform:document.getElementById("cfSp").value.trim(),config:{}};
  var method=eid?"PUT":"POST";
  var apiUrl="/admin/content-factory/sources"+(eid?"/"+eid:"");
  fetch(apiUrl,{method:method,headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(body)}).then(function(r){return r.json()}).then(function(d){
    if(d.success){cfHideSourceForm();cfLoadSources();showToast("保存成功","success")}
    else{showToast(d.error||"保存失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cfEditSource(id){
  var s=null;
  for(var i=0;i<cfSources.length;i++){if(cfSources[i].id===id){s=cfSources[i];break}}
  if(!s){showToast("未找到","error");return}
  document.getElementById("cfSourceForm").style.display="block";
  document.getElementById("cfSfTitle").textContent="编辑来源";
  document.getElementById("cfSeid").value=s.id;
  document.getElementById("cfSn").value=s.name;
  document.getElementById("cfSt").value=s.source_type;
  document.getElementById("cfSu").value=s.url;
  document.getElementById("cfSi").value=s.crawl_interval||0;
  document.getElementById("cfSm").value=s.max_per_run||10;
  document.getElementById("cfSk").value=s.keywords||"";
  document.getElementById("cfSp").value=s.platform||"";
}

function cfDelSource(id){
  if(!confirm("确定删除此来源？"))return;
  fetch("/admin/content-factory/sources/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){cfLoadSources();showToast("已删除","success")}
    else{showToast(d.error||"删除失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cfRunCrawl(id){
  showToast("采集中...","");
  fetch("/admin/content-factory/crawl",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({source_id:id})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){cfLoadSources();showToast("采集完成: 新增"+d.inserted+" 跳过"+d.skipped,"success")}
    else{showToast("采集失败: "+d.error,"error")}
  }).catch(function(){showToast("请求失败","error")});
}

// ── Tab 1: 原始内容列表 ──
function cfRenderRaw(){
  var h='<div class="cd"><div class="st">原始内容 <span id="cfRawCnt">0</span></div>';
  h+='<div class="sbar"><input id="cfRawSearch" placeholder="搜索标题..." onkeyup="cfLoadRaw()"> ';
  h+='<select class="sl" id="cfRawStatus" onchange="cfLoadRaw()"><option value="">全部</option><option value="pending">待加工</option><option value="processed">已加工</option><option value="failed">失败</option></select>';
  h+='<button class="btn bp bs" onclick="cfBatchProcess()">⚡ 批量AI加工</button> ';
  h+='<button class="btn bo bs" onclick="cfBatchDelete()">🗑 批量删除</button></div>';
  h+='<table><tr><th style="width:24px"><input type="checkbox" id="cfRawAll" onchange="cfToggleRawAll()"></th><th>来源</th><th>标题</th><th>摘要</th><th>状态</th><th>时间</th><th>操作</th></tr><tbody id="cfRawBody"></tbody></table></div>';
  document.getElementById("cfTabContent").innerHTML=h;
  cfLoadRaw();
}

function cfLoadRaw(){
  var s=document.getElementById("cfRawStatus")?document.getElementById("cfRawStatus").value:"";
  var url="/admin/content-factory/contents?limit=30";
  if(s)url+="&status="+s;
  fetch(url,{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success){document.getElementById("cfRawBody").innerHTML='<tr><td colspan="7"><div class="em">加载失败</div></td></tr>';return}
    cfRawContents=d.data||[];
    var q=document.getElementById("cfRawSearch")?document.getElementById("cfRawSearch").value.trim():"";
    var filtered=cfRawContents;
    if(q){filtered=filtered.filter(function(r){return(r.title||"").indexOf(q)>=0})}
    document.getElementById("cfRawCnt").textContent=filtered.length;
    var h='';
    if(!filtered.length){h='<tr><td colspan="7"><div class="em">暂无内容</div></td></tr>'}
    else{filtered.forEach(function(r){
      var sc={pending:'pd',processed:'on',failed:'off'}[r.status]||'';
      h+='<tr><td><input type="checkbox" class="cfRawCb" value="'+r.id+'"></td>';
      h+='<td style="font-size:10px">'+esc(r.source_name||'')+'</td>';
      h+='<td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;font-weight:600">'+esc(r.title||'无标题')+'</td>';
      h+='<td style="max-width:150px;overflow:hidden;text-overflow:ellipsis;font-size:11px;color:var(--dim)">'+esc((r.summary||r.content_text||'').slice(0,60))+'</td>';
      h+='<td><span class="bdg '+sc+'">'+r.status+'</span></td>';
      h+='<td style="font-size:10px">'+(r.created_at||'').slice(0,16)+'</td>';
      h+='<td>'+(r.status==='pending'?'<button class="btn bo bs" onclick="cfProcessOne('+r.id+')">加工</button>':'')+'</td></tr>';
    })}
    document.getElementById("cfRawBody").innerHTML=h;
  }).catch(function(){document.getElementById("cfRawBody").innerHTML='<tr><td colspan="7"><div class="em">请求失败</div></td></tr>'});
}

function cfToggleRawAll(){
  var chk=document.getElementById("cfRawAll").checked;
  var cbs=document.querySelectorAll(".cfRawCb");
  for(var i=0;i<cbs.length;i++){cbs[i].checked=chk};
}

function cfBatchProcess(){
  var ids=[];
  var cbs=document.querySelectorAll(".cfRawCb:checked");
  for(var i=0;i<cbs.length;i++){ids.push(parseInt(cbs[i].value))};
  if(!ids.length){showToast("请先勾选内容","error");return}
  showToast("AI加工中 ("+ids.length+"条)...","");
  fetch("/admin/content-factory/process",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({raw_ids:ids})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("完成: OK="+d.ok+" FAIL="+d.fail,"success");cfLoadRaw()}
    else{showToast("失败: "+d.error,"error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cfBatchDelete(){
  var ids=[];
  var cbs=document.querySelectorAll(".cfRawCb:checked");
  for(var i=0;i<cbs.length;i++){ids.push(parseInt(cbs[i].value))};
  if(!ids.length){showToast("请先勾选内容","error");return}
  if(!confirm("确定删除 "+ids.length+" 条内容？不可恢复！"))return;
  showToast("删除中...","");
  // 逐条删除 (没有批量删除API, 用DELETE逐条)
  var done=0,fail=0;
  function delNext(){
    if(!ids.length){showToast("删除完成: OK="+done+" FAIL="+fail,"success");cfLoadRaw();return}
    var id=ids.shift();
    fetch("/admin/content-factory/contents/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
      if(d.success){done++}else{fail++}
      delNext();
    }).catch(function(){fail++;delNext()});
  }
  delNext();
}

function cfProcessOne(id){
  showToast("AI加工中...","");
  fetch("/admin/content-factory/process",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({raw_ids:[id]})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("加工完成","success");cfLoadRaw()}
    else{showToast("加工失败: "+d.error,"error")}
  }).catch(function(){showToast("请求失败","error")});
}

// ── Tab 2: 加工内容列表 ──
function cfRenderProcessed(){
  var h='<div class="cd"><div class="st">加工内容 <span id="cfPcCnt">0</span></div>';
  h+='<div class="sbar"><select class="sl" id="cfPcStatus" onchange="cfLoadProcessed()">';
  h+='<option value="">全部</option><option value="draft">草稿</option><option value="review">审核中</option><option value="approved">已通过</option><option value="rejected">已驳回</option><option value="published">已发布</option>';
  h+='</select>';
  h+='<button class="btn bo bs" onclick="cfBatchDeleteProcessed()">🗑 批量删除</button></div>';
  h+='<table><tr><th style="width:24px"><input type="checkbox" id="cfPcAll" onchange="cfTogglePcAll()"></th><th>标题</th><th>类型</th><th>风险</th><th>状态</th><th>时间</th><th>操作</th></tr><tbody id="cfPcBody"></tbody></table></div>';
  h+='<div id="cfPcDetail" style="display:none"></div>';
  document.getElementById("cfTabContent").innerHTML=h;
  cfLoadProcessed();
}

function cfLoadProcessed(){
  var s=document.getElementById("cfPcStatus")?document.getElementById("cfPcStatus").value:"";
  var url="/admin/content-factory/processed?limit=30";
  if(s)url+="&status="+s;
  fetch(url,{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success){document.getElementById("cfPcBody").innerHTML='<tr><td colspan="6"><div class="em">加载失败</div></td></tr>';return}
    cfProcessed=d.data||[];
    document.getElementById("cfPcCnt").textContent=cfProcessed.length;
    var h='';
    if(!cfProcessed.length){h='<tr><td colspan="6"><div class="em">暂无加工内容</div></td></tr>'}
    else{cfProcessed.forEach(function(p){
      var rl={low:'<span class="bdg on">低</span>',normal:'<span class="bdg pd">中</span>',high:'<span class="bdg off">高</span>',critical:'<span class="bdg off" style="background:rgba(248,81,73,.2)">危险</span>'};
      var st_bdg={draft:'pd',review:'pd',approved:'on',rejected:'off',published:'on'}[p.status]||'pd';
      var st_label={draft:'草稿',review:'审核中',approved:'✅已通过',rejected:'❌驳回',published:'已发布'}[p.status]||p.status;
      var st='<span class="bdg '+st_bdg+'">'+st_label+'</span>';
      h+='<tr><td><input type="checkbox" class="cfPcCb" value="'+p.id+'"></td>';
      h+='<td style="font-weight:600;max-width:200px;overflow:hidden;text-overflow:ellipsis">'+esc(p.title||'无标题')+'</td>';
      h+='<td style="font-size:10px">'+p.content_type+'</td>';
      h+='<td>'+(rl[p.risk_level]||'<span class="bdg pd">中</span>')+'</td>';
      h+='<td>'+st+'</td>';
      h+='<td style="font-size:10px">'+(p.created_at||'').slice(0,16)+'</td>';
      h+='<td><button class="btn bo bs" onclick="cfViewProcessed('+p.id+')">查看</button> ';
      if(p.status==='draft'){h+='<button class="btn bo bs" onclick="cfReview('+p.id+',\'submit_review\')">提交审核</button>'}
      if(p.status==='review'){h+='<button class="btn bp bs" onclick="cfReview('+p.id+',\'approve\')">通过</button> <button class="btn bo bs" onclick="cfReview('+p.id+',\'reject\')">驳回</button>'}
      if(p.status==='approved'){h+='<button class="btn bp bs" onclick="cfPublishOne('+p.id+')">📄发布</button> <button class="btn bo bs" onclick="cfPublishToSocial('+p.id+')">📢社媒</button>'}
      if(p.status==='rejected'){h+='<button class="btn bo bs" onclick="cfReview('+p.id+',\'back_to_draft\')">退回草稿</button>'}
      h+='</td></tr>';
    })}
    document.getElementById("cfPcBody").innerHTML=h;
  }).catch(function(){document.getElementById("cfPcBody").innerHTML='<tr><td colspan="6"><div class="em">请求失败</div></td></tr>'});
}

function cfViewProcessed(id){
  var p=null;
  for(var i=0;i<cfProcessed.length;i++){if(cfProcessed[i].id===id){p=cfProcessed[i];break}}
  if(!p){showToast("未找到","error");return}
  var h='<div class="cd" style="margin-top:10px">';
  h+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">';
  h+='<div class="st">'+esc(p.title||'无标题')+'</div>';
  h+='<button class="btn bo bs" onclick="document.getElementById(\'cfPcDetail\').style.display=\'none\'">× 关闭</button></div>';
  h+='<div style="font-size:11px;color:var(--dim);margin-bottom:8px">关键词: '+esc(p.keywords||'')+' | 风险: '+p.risk_level+'</div>';
  h+='<div style="background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:12px;font-size:12px;line-height:1.6;white-space:pre-wrap;max-height:400px;overflow-y:auto">'+esc(p.body||'无正文')+'</div>';
  h+='<div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap">';
  h+='<div style="font-size:11px;color:var(--dim);padding:4px 0;margin-right:12px">状态: <span class="bdg '+
    ({draft:'pd',review:'pd',approved:'on',rejected:'off',published:'on'}[p.status]||'pd')+'">'+
    ({draft:'草稿',review:'审核中',approved:'已通过',rejected:'已驳回',published:'已发布'}[p.status]||p.status)+'</span></div>';
  if(p.status==='draft'){h+='<button class="btn bo bs" onclick="cfReview('+p.id+',\'submit_review\')">📋 提交审核</button>'}
  if(p.status==='review'){h+='<button class="btn bp bs" onclick="cfReview('+p.id+',\'approve\')">✅ 通过</button> <button class="btn bo bs" onclick="cfReview('+p.id+',\'reject\')">❌ 驳回</button>'}
  if(p.status==='approved'){h+='<button class="btn bp bs" onclick="cfPublishOne('+p.id+')">📄 发布到本站</button> <button class="btn bo bs" onclick="cfPublishToSocial('+p.id+')">📢 推送到社媒</button> <button class="btn bo bs" onclick="cfPublishBoth('+p.id+')">📄+📢 同时发布</button>'}
  if(p.status==='rejected'){h+='<button class="btn bo bs" onclick="cfReview('+p.id+',\'back_to_draft\')">↩ 退回草稿</button>'}
  h+='<button class="btn bo bs" onclick="cfEditProcessed('+p.id+')">✏️ 编辑内容</button> ';
  h+='<button class="btn bo bs" onclick="cfPushToSkill('+p.id+')">🧠 Skill推送</button></div></div>';
  document.getElementById("cfPcDetail").innerHTML=h;
  document.getElementById("cfPcDetail").style.display="block";
}

function cfReview(id,action){
  var labels={'submit_review':'提交审核','approve':'通过','reject':'驳回','back_to_draft':'退回草稿'};
  if(!confirm('确定'+labels[action]+'？'))return;
  showToast(labels[action]+'中...','');
  fetch("/admin/content-factory/review",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({processed_id:id,action:action})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast(labels[action]+'成功',"success");cfLoadProcessed();document.getElementById('cfPcDetail').style.display='none'}
    else{showToast(d.error||'操作失败',"error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cfTogglePcAll(){
  var chk=document.getElementById("cfPcAll").checked;
  var cbs=document.querySelectorAll(".cfPcCb");
  for(var i=0;i<cbs.length;i++){cbs[i].checked=chk};
}

function cfBatchDeleteProcessed(){
  var ids=[];
  var cbs=document.querySelectorAll(".cfPcCb:checked");
  for(var i=0;i<cbs.length;i++){ids.push(parseInt(cbs[i].value))};
  if(!ids.length){showToast("请先勾选内容","error");return}
  if(!confirm("确定删除 "+ids.length+" 条加工内容(含已推送的Skill)？不可恢复！"))return;
  showToast("删除中...","");
  fetch("/admin/content-factory/processed/batch-delete",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({ids:ids})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("已删除 "+d.deleted+" 条","success");cfLoadProcessed();document.getElementById('cfPcDetail').style.display='none'}
    else{showToast(d.error||"删除失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cfEditProcessed(id){
  for(var i=0;i<cfProcessed.length;i++){if(cfProcessed[i].id===id){var p=cfProcessed[i];break}}
  if(!p){showToast("未找到","error");return}
  var h='<div class="cd" style="margin-top:10px">';
  h+='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">';
  h+='<div class="st">编辑: '+esc(p.title||'无标题')+'</div>';
  h+='<button class="btn bo bs" onclick="cfCloseEditor('+id+')">× 关闭</button></div>';
  h+='<div style="margin-bottom:8px"><div style="font-size:11px;color:var(--dim);margin-bottom:3px">标题</div>';
  h+='<input class="in" id="cfEditTitle" value="'+esc(p.title||'')+'" style="width:100%"></div>';
  h+='<div style="margin-bottom:8px"><div style="font-size:11px;color:var(--dim);margin-bottom:3px">摘要</div>';
  h+='<input class="in" id="cfEditSummary" value="'+esc(p.summary||'')+'" style="width:100%"></div>';
  h+='<div style="margin-bottom:8px"><div style="font-size:11px;color:var(--dim);margin-bottom:3px">正文 (Markdown)</div>';
  h+='<textarea class="ta" id="cfEditBody" rows="15" style="font-family:monospace;font-size:12px;line-height:1.6">'+esc(p.body||'')+'</textarea></div>';
  h+='<div style="margin-top:8px"><button class="btn bp bs" onclick="cfSaveEdit('+id+')">保存</button></div></div>';
  document.getElementById("cfPcDetail").innerHTML=h;
  document.getElementById("cfPcDetail").style.display="block";
}

function cfSaveEdit(id){
  var title=document.getElementById("cfEditTitle").value.trim();
  var summary=document.getElementById("cfEditSummary").value.trim();
  var body=document.getElementById("cfEditBody").value.trim();
  if(!body){showToast("正文不能为空","error");return}
  fetch("/admin/content-factory/processed/"+id,{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({title:title,summary:summary,body:body})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("保存成功","success");cfLoadProcessed();document.getElementById('cfPcDetail').style.display='none'}
    else{showToast(d.error||"保存失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cfCloseEditor(id){
  if(document.getElementById("cfEditBody")){
    if(!confirm("放弃编辑？"))return;
  }
  document.getElementById("cfPcDetail").style.display="none";
}

function cfPublishOne(id){
  if(!confirm("发布到本站 CMS？"))return;
  fetch("/admin/content-factory/publish",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({processed_id:id,platform:"internal"})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("发布成功 post_id="+d.post_id,"success");cfLoadProcessed()}
    else{showToast(d.error||"发布失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cfPublishToSocial(id){
  var platforms=prompt("推送平台: wechat / weibo / toutiao（逗号分隔）","wechat");
  if(!platforms)return;
  var list=platforms.split(",").map(function(p){return p.trim()}).filter(function(p){return p});
  if(!list.length)return;
  var autoPub=confirm("微信是否直接发布？\n确定=直接发布，取消=仅存草稿");
  fetch("/admin/content-factory/publish",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({processed_id:id,platform:"social",social_platforms:list,auto_publish:autoPub})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){
      var msgs=d.social_results.map(function(r){return r.platform+": "+(r.message||r.error||r.status)});
      showToast("社媒发布: "+msgs.join(" | "),d.social_results.some(function(r){return r.status=="failed"})?"error":"success");
      cfLoadProcessed()
    }else{showToast(d.error||"发布失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cfPublishBoth(id){
  var platforms=prompt("推送平台: wechat / weibo / toutiao（逗号分隔）","wechat");
  if(!platforms)return;
  var list=platforms.split(",").map(function(p){return p.trim()}).filter(function(p){return p});
  if(!list.length)return;
  if(!confirm("同时发布到本站 CMS + 社媒？"))return;
  var autoPub=confirm("微信是否直接发布？\n确定=直接发布，取消=仅存草稿");
  fetch("/admin/content-factory/publish",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({processed_id:id,platform:"both",social_platforms:list,auto_publish:autoPub})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){
      var msgs=["CMS post_id="+d.post_id];
      if(d.social_results)msgs.push(d.social_results.map(function(r){return r.platform+": "+(r.message||r.error||r.status)}).join(" | "));
      showToast("发布完成: "+msgs.join(" ; "),d.social_results&&d.social_results.some(function(r){return r.status=="failed"})?"error":"success");
      cfLoadProcessed()
    }else{showToast(d.error||"发布失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function cfPushToSkill(id){
  var target=prompt("推送目标: hermes / openclaw","hermes");
  if(!target)return;
  showToast("推送中...","");
  fetch("/admin/content-factory/push-skill",{method:"POST",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({processed_id:id,target_agent:target})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){
      var preview=d.skill_content.slice(0,200)+"...";
      var html='<div class="cd" style="margin-top:10px">';
      html+='<div class="st">推送成功 🎉</div>';
      html+='<div style="font-size:12px;margin-bottom:8px;color:var(--accent)">Skill: '+esc(d.skill_name)+' → '+esc(d.target_agent)+'</div>';
      html+='<div style="background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:12px;font-size:11px;font-family:monospace;white-space:pre-wrap;max-height:300px;overflow-y:auto">'+esc(preview)+'</div>';
      html+='<div style="margin-top:8px"><button class="btn bo bs" onclick="document.getElementById(\'cfPcDetail\').innerHTML=\'\'">关闭</button></div></div>';
      document.getElementById("cfPcDetail").innerHTML+=html;
      showToast("推送成功: "+d.skill_name,"success")
    }
    else{showToast(d.error||"推送失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

// ============================================================
// ⚡ 自动调度 (Cron + Workflow)
// ============================================================
window.l_automation=function(){
  document.getElementById("pt").textContent="自动调度";
  document.getElementById("mc").innerHTML='<div class="lo"><div class="s"></div>加载中...</div>';
  aLStats();
}

// 📊 统计分析 (Server-side, Cookieless Analytics)
// ============================================================
window.l_analytics=function(){
  document.getElementById("pt").textContent="统计分析";
  document.getElementById("mc").innerHTML='<div class="lo"><div class="s"></div>加载中...</div>';
  var xhr = new XMLHttpRequest();
  xhr.open('GET', '/admin/analytics/', true);
  xhr.setRequestHeader('Authorization', 'Bearer ' + T);
  xhr.onload = function() {
    if (xhr.status === 200) {
      var html = xhr.responseText;
      // Extract <head> resources: style, link, script tags
      var headMatch = html.match(/<head[^>]*>([\s\S]*?)<\/head>/i);
      var headHtml = headMatch ? headMatch[1] : '';
      var headResources = '';
      headHtml.replace(/<(style|link|script)[^>]*>[\s\S]*?<\/\1>/gi, function(m){ headResources += m; return m; });
      headHtml.replace(/<(style|link|script)[^>]*\/>/gi, function(m){ headResources += m; return m; });
      // Extract <body> content
      var bodyMatch = html.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
      var bodyContent = bodyMatch ? bodyMatch[1] : html;
      // Inject: head CSS/links + body content
      document.getElementById("mc").innerHTML = '<div id="analytics-root">' + headResources + bodyContent + '</div>';
      // Re-create scripts to execute them
      document.getElementById("analytics-root").querySelectorAll("script").forEach(function(oldScript){
        var ns = document.createElement("script");
        if (oldScript.src) { ns.src = oldScript.src; }
        else { ns.textContent = oldScript.textContent; }
        oldScript.parentNode.replaceChild(ns, oldScript);
      });
    } else {
      document.getElementById("mc").innerHTML = '<div class="em">加载失败: HTTP ' + xhr.status + '</div>';
    }
  };
  xhr.onerror = function() {
    document.getElementById("mc").innerHTML = '<div class="em">网络请求失败</div>';
  };
  xhr.send();
}

// 🏥 健康巡检 (Health Check)
window.l_health=function(){
  document.getElementById("pt").textContent="健康巡检";
  document.getElementById("mc").innerHTML='<div class="lo"><div class="s"></div>加载中...</div>';
  var xhr = new XMLHttpRequest();
  xhr.open('GET', '/admin/health/', true);
  xhr.setRequestHeader('Authorization', 'Bearer ' + T);
  xhr.onload = function() {
    if (xhr.status === 200) {
      var html = xhr.responseText;
      var headMatch = html.match(/<head[^>]*>([\s\S]*?)<\/head>/i);
      var headHtml = headMatch ? headMatch[1] : '';
      var headResources = '';
      headHtml.replace(/<(style|link|script)[^>]*>[\s\S]*?<\/\1>/gi, function(m){ headResources += m; return m; });
      headHtml.replace(/<(style|link|script)[^>]*\/>/gi, function(m){ headResources += m; return m; });
      var bodyMatch = html.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
      var bodyContent = bodyMatch ? bodyMatch[1] : html;
      document.getElementById("mc").innerHTML = '<div id="health-root">' + headResources + bodyContent + '</div>';
      document.getElementById("health-root").querySelectorAll("script").forEach(function(oldScript){
        var ns = document.createElement("script");
        if (oldScript.src) { ns.src = oldScript.src; }
        else { ns.textContent = oldScript.textContent; }
        oldScript.parentNode.replaceChild(ns, oldScript);
      });
    } else {
      document.getElementById("mc").innerHTML = '<div class="em">加载失败: HTTP ' + xhr.status + '</div>';
    }
  };
  xhr.onerror = function() {
    document.getElementById("mc").innerHTML = '<div class="em">网络请求失败</div>';
  };
  xhr.send();
}

// 💬 评论管理
// ============================
window.l_comments=function(){
  document.getElementById("pt").textContent="评论管理";
  var h='<div style="margin-bottom:12px;display:flex;gap:4px">';
  h+='<button class="btn bp" onclick="comLoad(\x27\x27)" id="com-t0">全部</button>';
  h+='<button class="btn bo" onclick="comLoad(\x27pending\x27)" id="com-t1">⏳ 待审核</button>';
  h+='<button class="btn bo" onclick="comLoad(\x27approved\x27)" id="com-t2">✅ 已通过</button>';
  h+='<button class="btn bo" onclick="comLoad(\x27rejected\x27)" id="com-t3">❌ 已拒绝</button>';
  h+='</div><div id="comList"><div class="lo"><div class="s"></div></div></div>';
  document.getElementById("mc").innerHTML=h;
  comLoad("");
};

var comFilter="";
function comLoad(filter){
  comFilter=filter||"";
  document.querySelectorAll('[id^="com-t"]').forEach(function(e){e.className="btn bo"});
  var el=document.getElementById("com-t"+(comFilter==="pending"?1:comFilter==="approved"?2:comFilter==="rejected"?3:0));
  if(el)el.className="btn bp";
  var url="/admin/comments?status="+comFilter+"&limit=50";
  fetch(url,{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success){document.getElementById("comList").innerHTML='<div class="em">加载失败</div>';return}
    var items=d.data&&d.data.items?d.data.items:[];
    if(!items.length){document.getElementById("comList").innerHTML='<div class="em">暂无评论</div>';return}
    var h='<div class="cd"><div class="st">评论 ('+items.length+')</div><table><tr><th>文章</th><th>昵称</th><th>内容</th><th>AI评分</th><th>状态</th><th>时间</th><th>操作</th></tr>';
    items.forEach(function(c){
      var st=c.status;
      var stHtml={pending:'<span class="bdg pd">待审</span>',approved:'<span class="bdg on">已通过</span>',rejected:'<span class="bdg off">已拒绝</span>'}[st]||'<span class="bdg pd">'+st+'</span>';
      var score=c.ai_score!==null&&c.ai_score!==undefined?'<span style="font-size:10px;color:'+(c.ai_score<0.3?'var(--green)':c.ai_score<0.7?'var(--dim)':'var(--red)')+'">'+c.ai_score.toFixed(2)+'</span>':'<span style="font-size:10px;color:var(--dim)">-</span>';
      h+='<tr><td style="max-width:120px;overflow:hidden;text-overflow:ellipsis;font-size:11px">'+esc(c.post_title||"-")+'</td>';
      h+='<td>'+esc(c.nickname||"-")+'</td>';
      h+='<td style="max-width:250px;overflow:hidden;text-overflow:ellipsis">'+esc(c.content||"").slice(0,80)+'</td>';
      h+='<td>'+score+'</td><td>'+stHtml+'</td>';
      h+='<td style="font-size:10px">'+(c.created_at||"").slice(0,16)+'</td>';
      h+='<td style="white-space:nowrap">';
      if(c.status==="pending"){h+='<button class="btn bp bs" onclick="comApprove('+c.id+')">通过</button> <button class="btn bo bs" onclick="comReject('+c.id+')">拒绝</button>'}
      else{h+='<button class="btn bo bs" onclick="comDelete('+c.id+')">删除</button>'}
      h+='</td></tr>';
    });
    h+='</table></div>';
    document.getElementById("comList").innerHTML=h;
  }).catch(function(){document.getElementById("comList").innerHTML='<div class="em">请求失败</div>'});
}

function comApprove(id){
  fetch("/admin/comments/"+id+"/review",{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({action:"approve"})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("已通过","success");comLoad(comFilter)}
    else{showToast(d.error||"操作失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function comReject(id){
  fetch("/admin/comments/"+id+"/review",{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({action:"reject"})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("已拒绝","success");comLoad(comFilter)}
    else{showToast(d.error||"操作失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function comDelete(id){
  if(!confirm("确定删除该评论？"))return;
  fetch("/admin/comments/"+id+"/review",{method:"PUT",headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify({action:"delete"})}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("已删除","success");comLoad(comFilter)}
    else{showToast(d.error||"操作失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

var aS={}; // 当前选中的 sub tab
function aLStats(){
  fetch("/admin/automation/stats",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success){document.getElementById("mc").innerHTML='<div class="em">加载失败，请确认已安装 APScheduler</div>';return}
    var s=d.data;
    var h='<div class="gr">';
    h+=hka('Cron 任务',s.total_jobs,'g');
    h+=hka('活跃任务',s.active_jobs,'b');
    h+=hka('工作流',s.total_workflows,'g');
    h+=hka('运行中',s.running_instances,'b');
    h+=hka('今日完成',s.completed_today,'g');
    h+=hka('今日失败',s.failed_today,'r');
    h+='</div>';
    // 调度器状态
    if(s.scheduler){
      h+='<div class="cd" style="margin-bottom:12px"><div class="st">🟢 调度器状态</div>';
      h+='<div style="font-size:12px;color:var(--muted)">实例: '+esc(s.scheduler.scheduler_id)+'</div>';
      h+='<div style="font-size:12px;color:var(--muted)">已调度任务: '+s.scheduler.scheduled_jobs+'</div>';
      h+='</div>';
    }
    // 操作按钮
    h+='<div style="display:flex;gap:8px;margin-bottom:12px">';
    h+='<button class="btn bp" onclick="aLTab(\'jobs\')">📋 任务管理</button>';
    h+='<button class="btn bp" onclick="aLTab(\'workflows\')">🔧 工作流</button>';
    h+='<button class="btn bp" onclick="aLTab(\'instances\')">📊 执行历史</button>';
    h+='<button class="btn bo" onclick="aLTab(\'logs\')">📄 日志</button>';
    h+='</div>';
    // 内容区域
    h+='<div id="aLContent"><div class="em">选择功能开始配置</div></div>';
    document.getElementById("mc").innerHTML=h;
  }).catch(function(){
    document.getElementById("mc").innerHTML='<div class="em">加载失败，请确认调度器已启动</div>';
  });
}

function hka(l,v,c){return '<div class="cd"><div class="l">'+l+'</div><div class="v '+(c||'')+'">'+(v!=null?v:'-')+'</div></div>'}

// ---- 子 Tab 切换 ----
function aLTab(tab){
  aS.current=tab;
  if(tab=='jobs')aLJobs();
  else if(tab=='workflows')aLWorkflows();
  else if(tab=='instances')aLInstances();
  else if(tab=='logs')aLLogs();
}

// ===== 任务管理 =====
var aJobs=[];
function aLJobs(){
  document.getElementById("aLContent").innerHTML='<div class="lo"><div class="s"></div>加载任务...</div>';
  fetch("/admin/automation/jobs?limit=100",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    aJobs=d.data.jobs||[];
    var h='<div class="cd"><div class="st">📋 Cron 任务 ('+d.data.total+')';
    h+=' <button class="btn bp bs" onclick="aJNew()" style="float:right">+ 新建</button></div>';
    h+='<table><tr><th>名称</th><th>类型</th><th>表达式</th><th>优先级</th><th>Agent</th><th>上次</th><th>状态</th><th>操作</th></tr>';
    if(!aJobs.length)h+='<tr><td colspan="8"><div class="em">暂无任务</div></td></tr>';
    else aJobs.forEach(function(j){
      var st=j.is_active?'<span class="bdg on">活跃</span>':'<span class="bdg off">暂停</span>';
      var ls=j.last_status?('<span class="bdg '+(j.last_status=='success'?'on':j.last_status=='failed'?'off':'pd')+'">'+j.last_status+'</span>'):'-';
      h+='<tr><td style="font-weight:600">'+esc(j.name)+'</td>';
      h+='<td>'+j.job_type+'</td>';
      h+='<td style="font-family:monospace;font-size:11px">'+esc(j.cron_expr||j.natural_expr||j.interval_seconds+'s')+'</td>';
      h+='<td>'+j.priority+'</td>';
      h+='<td>'+j.agent_type+'</td>';
      h+='<td style="font-size:11px">'+(j.last_run_at||'-')+'</td>';
      h+='<td>'+st+'</td>';
      h+='<td>'+
        '<button class="btn bo bs" onclick="aJRun('+j.id+')">▶</button> '+
        '<button class="btn bo bs" onclick="aJToggle('+j.id+','+j.is_active+')">'+(j.is_active?'⏸':'▶')+'</button> '+
        '<button class="btn bo bs" onclick="aJEdit('+j.id+')">✏️</button> '+
        '<button class="btn bo bs" onclick="aJDel('+j.id+')">🗑️</button></td></tr>';
    });
    h+='</table></div>';
    document.getElementById("aLContent").innerHTML=h;
  }).catch(function(){});
}

function aJForm(editJob){
  var j=editJob||{};
  var h='<div class="cd" id="aJForm" style="margin-bottom:12px">';
  h+='<div class="st">'+(j.id?'编辑任务':'新建任务')+'</div>';
  h+='<div class="g2">';
  h+='<div><div style="font-size:11px;color:var(--dim)">名称 *</div><input class="in" id="aJName" value="'+esc(j.name||'')+'" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">类型</div><select class="sl" id="aJType" style="width:100%"><option value="cron" '+(j.job_type=='cron'?'selected':'')+'>Cron</option><option value="interval" '+(j.job_type=='interval'?'selected':'')+'>间隔</option><option value="once" '+(j.job_type=='once'?'selected':'')+'>一次性</option></select></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">Cron 表达式 <span style="color:var(--dim)">或自然语言</span></div><input class="in" id="aJCron" value="'+esc(j.cron_expr||j.natural_expr||'')+'" placeholder="0 30 9 * * 1-5 或 每个交易日9:30" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">间隔秒数</div><input class="in" id="aJInterval" value="'+esc(j.interval_seconds||'')+'" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">优先级</div><select class="sl" id="aJPriority" style="width:100%"><option value="critical" '+(j.priority=='critical'?'selected':'')+'>高(关键)</option><option value="high" '+(j.priority=='high'?'selected':'')+'>高</option><option value="normal" '+(j.priority=='normal'?'selected':'')+'>中</option><option value="low" '+(j.priority=='low'?'selected':'')+'>低</option></select></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">Agent 类型</div><select class="sl" id="aJAgent" style="width:100%"><option value="system" '+(j.agent_type=='system'?'selected':'')+'>系统 Agent</option><option value="user" '+(j.agent_type=='user'?'selected':'')+'>用户 Agent</option></select></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">目标类型</div><select class="sl" id="aJTarget" style="width:100%"><option value="workflow" '+(j.target_type=='workflow'?'selected':'')+'>工作流</option><option value="api" '+(j.target_type=='api'?'selected':'')+'>API</option><option value="script" '+(j.target_type=='script'?'selected':'')+'>脚本</option></select></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">超时(秒)</div><input class="in" id="aJTimeout" value="'+esc(j.timeout_seconds||'300')+'" style="width:100%"></div>';
  h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">描述</div><input class="in" id="aJDesc" value="'+esc(j.description||'')+'" style="width:100%"></div>';
  h+='</div><div style="margin-top:8px"><button class="btn bp" onclick="aJSave('+(j.id||'')+')">保存</button> <button class="btn bo" onclick="document.getElementById(\'aJForm\').remove();aLJobs()">取消</button></div></div>';
  return h;
}

function aJSave(id){
  var name=document.getElementById("aJName").value.trim();
  if(!name){showToast("名称不能为空","error");return}
  var cron=document.getElementById("aJCron").value.trim();
  var data={
    name:name,
    job_type:document.getElementById("aJType").value,
    cron_expr:cron,
    natural_expr:cron,
    interval_seconds:parseInt(document.getElementById("aJInterval").value)||0,
    priority:document.getElementById("aJPriority").value,
    agent_type:document.getElementById("aJAgent").value,
    target_type:document.getElementById("aJTarget").value,
    timeout_seconds:parseInt(document.getElementById("aJTimeout").value)||300,
    description:document.getElementById("aJDesc").value.trim()
  };
  var url="/admin/automation/jobs"+(id?"/"+id:"");
  var method=id?"PUT":"POST";
  fetch(url,{method:method,headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(data)}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("保存成功","success");aLJobs()}
    else{showToast(d.error||"保存失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function aJToggle(id,active){
  fetch("/admin/automation/jobs/"+id+"/toggle",{method:"POST",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast(d.message||"已切换","success");aLJobs()}
    else{showToast(d.error||"操作失败","error")}
  }).catch(function(){});
}

function aJRun(id){
  fetch("/admin/automation/jobs/"+id+"/run",{method:"POST",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success)showToast("任务已触发","success");
    else showToast(d.error||"触发失败","error");
  }).catch(function(){});
}

function aJEdit(id){
  console.log("aJEdit called with id:", id, typeof id);
  var j=null;
  for(var i=0;i<aJobs.length;i++){console.log("  aJobs["+i+"].id:", aJobs[i].id, typeof aJobs[i].id);if(aJobs[i].id===id){j=aJobs[i];break}}
  console.log("  found j:", j ? j.name : null);
  if(!j){showToast("未找到任务","error");return}
  // 插入表单到表格上方
  var h=aJForm(j);
  console.log("  form HTML length:", h.length);
  var el=document.getElementById("aLContent");
  console.log("  aLContent element:", el);
  if(el)el.insertAdjacentHTML("afterbegin",h);
  window.scrollTo(0,0);
}

function aJNew(){var h=aJForm();var el=document.getElementById("aLContent");if(el){el.insertAdjacentHTML("afterbegin",h);window.scrollTo(0,0)}}

function aJDel(id){
  if(!confirm("确定删除此任务？"))return;
  fetch("/admin/automation/jobs/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("已删除","success");aLJobs()}
    else{showToast(d.error||"删除失败","error")}
  }).catch(function(){});
}

// ===== 工作流管理 =====
var aWfs=[];
function aLWorkflows(){
  document.getElementById("aLContent").innerHTML='<div class="lo"><div class="s"></div>加载工作流...</div>';
  fetch("/admin/automation/workflows?limit=100",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    aWfs=d.data.workflows||[];
    var h='<div class="cd"><div class="st">🔧 工作流定义 ('+d.data.total+')';
    h+=' <button class="btn bp bs" onclick="aWNew()" style="float:right">+ 新建</button></div>';
    h+='<table><tr><th>名称</th><th>版本</th><th>Agent</th><th>节点数</th><th>触发</th><th>状态</th><th>操作</th></tr>';
    if(!aWfs.length)h+='<tr><td colspan="7"><div class="em">暂无工作流</div></td></tr>';
    else aWfs.forEach(function(w){
      var def=(typeof w.definition=='string')?JSON.parse(w.definition||'{}'):(w.definition||{});
      var nodes=def.nodes||[];
      var st=w.is_active?'<span class="bdg on">启用</span>':'<span class="bdg off">禁用</span>';
      h+='<tr><td style="font-weight:600">'+esc(w.name)+'</td>';
      h+='<td>v'+w.version+'</td>';
      h+='<td>'+w.agent_type+'</td>';
      h+='<td>'+nodes.length+'</td>';
      h+='<td>'+(w.triggers&&w.triggers.length?w.triggers.map(function(t){return t.type}).join(","):'手动')+'</td>';
      h+='<td>'+st+'</td>';
      h+='<td>'+
        '<button class="btn bp bs" onclick="aWRun('+w.id+')">▶ 运行</button> '+
        '<button class="btn bo bs" onclick="aWEdit('+w.id+')">✏️</button> '+
        '<button class="btn bo bs" onclick="aWDel('+w.id+')">🗑️</button></td></tr>';
    });
    h+='</table></div>';
    document.getElementById("aLContent").innerHTML=h;
  }).catch(function(){});
}

function aWForm(editWf){
  var w=editWf||{};
  var def=(typeof w.definition=='string')?JSON.parse(w.definition||'{"nodes":[],"edges":[]}'):(w.definition||{nodes:[],edges:[]});
  var nodesTxt=JSON.stringify(def,null,2);
  var h='<div class="cd" id="aWForm" style="margin-bottom:12px">';
  h+='<div class="st">'+(w.id?'编辑工作流':'新建工作流')+'</div>';
  h+='<div class="g2">';
  h+='<div><div style="font-size:11px;color:var(--dim)">名称 *</div><input class="in" id="aWName" value="'+esc(w.name||'')+'" style="width:100%"></div>';
  h+='<div><div style="font-size:11px;color:var(--dim)">Agent 类型</div><select class="sl" id="aWAgent" style="width:100%"><option value="system" '+(w.agent_type=='system'?'selected':'')+'>系统 Agent</option><option value="user" '+(w.agent_type=='user'?'selected':'')+'>用户 Agent</option></select></div>';
  h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">描述</div><input class="in" id="aWDesc" value="'+esc(w.description||'')+'" style="width:100%"></div>';
  h+='<div style="grid-column:1/3"><div style="font-size:11px;color:var(--dim)">DAG 定义 (JSON) <span style="color:var(--dim)">节点+边</span></div>';
  h+='<textarea class="ta" id="aWDef" rows="15" style="font-family:monospace;font-size:11px;line-height:1.5">'+esc(nodesTxt)+'</textarea></div>';
  h+='<div style="grid-column:1/3;font-size:11px;color:var(--dim)">节点类型: ai_agent, data_collect, ai_process, condition, approve, publish, notify, wait, sub_workflow, market_check, http_request, script</div>';
  h+='</div><div style="margin-top:8px"><button class="btn bp" onclick="aWSave('+(w.id||'')+')">保存</button> <button class="btn bo" onclick="aWCloseForm()">取消</button></div></div>';
  return h;
}
function aWCloseForm(){document.getElementById("aWForm").remove();aLWorkflows()}
function aWNew(){var h=aWForm();document.getElementById("aLContent").insertAdjacentHTML("afterbegin",h);window.scrollTo(0,0);}

function aWSave(id){
  var name=document.getElementById("aWName").value.trim();
  if(!name){showToast("名称不能为空","error");return}
  var defText=document.getElementById("aWDef").value.trim();
  try{JSON.parse(defText)}catch(e){showToast("JSON 格式错误: "+e.message,"error");return}
  var data={name:name,description:document.getElementById("aWDesc").value.trim(),agent_type:document.getElementById("aWAgent").value,definition:defText};
  var url="/admin/automation/workflows"+(id?"/"+id:"");
  var method=id?"PUT":"POST";
  fetch(url,{method:method,headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"},body:JSON.stringify(data)}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("保存成功","success");aWCloseForm()}
    else{showToast(d.error||"保存失败","error")}
  }).catch(function(){showToast("请求失败","error")});
}

function aWRun(id){
  fetch("/admin/automation/workflows/"+id+"/run",{method:"POST",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast(d.message||"工作流已启动","success");aLInstances()}
    else{showToast(d.error||"启动失败","error")}
  }).catch(function(){});
}

function aWEdit(id){
  var w=null;
  for(var i=0;i<aWfs.length;i++){if(aWfs[i].id===id){w=aWfs[i];break}}
  if(!w){showToast("未找到工作流","error");return}
  var h=aWForm(w);
  document.getElementById("aLContent").insertAdjacentHTML("afterbegin",h);
  window.scrollTo(0,0);
}

function aWDel(id){
  if(!confirm("确定删除此工作流？"))return;
  fetch("/admin/automation/workflows/"+id,{method:"DELETE",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("已删除","success");aLWorkflows()}
    else{showToast(d.error||"删除失败","error")}
  }).catch(function(){});
}

// ===== 执行历史 =====
var aInsts=[];
function aLInstances(){
  document.getElementById("aLContent").innerHTML='<div class="lo"><div class="s"></div>加载执行历史...</div>';
  fetch("/admin/automation/instances?limit=50",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    aInsts=d.data.instances||[];
    var h='<div class="cd"><div class="st">📊 工作流执行历史 ('+d.data.total+')</div>';
    h+='<table><tr><th>ID</th><th>工作流</th><th>触发</th><th>状态</th><th>耗时</th><th>开始时间</th><th>操作</th></tr>';
    if(!aInsts.length)h+='<tr><td colspan="7"><div class="em">暂无执行记录</div></td></tr>';
    else aInsts.forEach(function(i){
      var stMap={'running':'<span class="bdg pd">运行中</span>','completed':'<span class="bdg on">完成</span>','failed':'<span class="bdg off">失败</span>','cancelled':'<span class="bdg off">已取消</span>','timeout':'<span class="bdg off">超时</span>','paused':'<span class="bdg pd">已暂停</span>'};
      var st=stMap[i.status]||i.status;
      h+='<tr><td>#'+i.id+'</td><td>'+(i.workflow_id||'')+'</td><td>'+i.trigger_type+'</td><td>'+st+'</td><td>'+(i.duration_ms?Math.round(i.duration_ms/1000)+'s':'-')+'</td><td style="font-size:11px">'+(i.created_at||'')+'</td>';
      h+='<td>';
      if(i.status=='running'||i.status=='paused'){
        h+='<button class="btn bo bs" onclick="aIPause('+i.id+',\''+i.status+'\')">'+(i.status=='paused'?'▶':'⏸')+'</button> ';
        h+='<button class="btn bo bs" onclick="aICancel('+i.id+')">🛑</button> ';
      }
      h+='<button class="btn bo bs" onclick="aIDetail('+i.id+')">📋</button></td></tr>';
    });
    h+='</table></div>';
    document.getElementById("aLContent").innerHTML=h;
  }).catch(function(){});
}

function aIPause(id,status){
  var action=status=='paused'?'resume':'pause';
  fetch("/admin/automation/instances/"+id+"/"+action,{method:"POST",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast(d.message,"success");aLInstances()}
    else showToast(d.error||"操作失败","error");
  }).catch(function(){});
}

function aICancel(id){
  if(!confirm("确定取消此工作流？"))return;
  fetch("/admin/automation/instances/"+id+"/cancel",{method:"POST",headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(d.success){showToast("已取消","success");aLInstances()}
    else showToast(d.error||"取消失败","error");
  }).catch(function(){});
}

function aIDetail(id){
  fetch("/admin/automation/instances/"+id,{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    var inst=d.data.instance;
    var nodes=d.data.nodes||[];
    var wfName=d.data.workflow_name||'未知';
    var h='<div class="modal-overlay" onclick="if(event.target==this)this.remove()"><div class="modal-box">';
    h+='<h3>📋 工作流执行 #'+inst.id+' - '+esc(wfName)+'</h3>';
    h+='<div class="modal-meta"><span>状态: '+(inst.status||'-')+'</span><span>触发: '+inst.trigger_type+'</span><span>耗时: '+(inst.duration_ms?Math.round(inst.duration_ms/1000)+'s':'-')+'</span></div>';
    h+='<div class="modal-meta"><span>开始: '+(inst.started_at||'-')+'</span><span>结束: '+(inst.finished_at||'-')+'</span></div>';
    if(inst.error_message)h+='<div class="modal-body" style="color:#f85149;margin-bottom:12px">❌ '+esc(inst.error_message)+'</div>';
    // 节点列表
    h+='<div class="st">节点执行详情</div><table><tr><th>节点</th><th>类型</th><th>状态</th><th>耗时</th><th>错误</th></tr>';
    nodes.forEach(function(n){
      var s=n.status=='completed'?'<span class="bdg on">完成</span>':n.status=='running'?'<span class="bdg pd">运行中</span>':n.status=='failed'?'<span class="bdg off">失败</span>':n.status=='waiting_approval'?'<span class="bdg pd">待审批</span>':'<span class="bdg off">'+n.status+'</span>';
      h+='<tr><td>'+esc(n.node_name||n.node_id)+'</td><td>'+n.node_type+'</td><td>'+s+'</td><td>'+(n.duration_ms?Math.round(n.duration_ms/1000)+'s':'-')+'</td><td style="color:#f85149;font-size:11px">'+(n.error_message?esc(n.error_message).slice(0,50):'')+'</td></tr>';
    });
    h+='</table>';
    h+='<div style="margin-top:12px"><button class="btn bo" onclick="this.closest(\'.modal-overlay\').remove()">关闭</button></div>';
    h+='</div></div>';
    document.body.insertAdjacentHTML("beforeend",h);
  }).catch(function(){});
}

// ===== 日志 =====
function aLLogs(){
  document.getElementById("aLContent").innerHTML='<div class="lo"><div class="s"></div>加载日志...</div>';
  fetch("/admin/automation/logs?limit=100",{headers:{"Authorization":"Bearer "+T}}).then(function(r){return r.json()}).then(function(d){
    if(!d.success||!d.data)return;
    var logs=d.data.logs||[];
    var h='<div class="cd"><div class="st">📄 执行日志 ('+d.data.total+')</div>';
    h+='<table><tr><th>类型</th><th>级别</th><th>消息</th><th>时间</th></tr>';
    if(!logs.length)h+='<tr><td colspan="4"><div class="em">暂无日志</div></td></tr>';
    else logs.forEach(function(l){
      var lvlMap={info:'<span class="bdg on">info</span>',warn:'<span class="bdg pd">warn</span>',error:'<span class="bdg off">error</span>',fatal:'<span class="bdg off" style="background:rgba(248,81,73,.2)">fatal</span>'};
      h+='<tr><td>'+l.source_type+'</td><td>'+(lvlMap[l.level]||l.level)+'</td><td style="max-width:400px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(l.message)+'</td><td style="font-size:11px">'+l.created_at+'</td></tr>';
    });
    h+='</table></div>';
    document.getElementById("aLContent").innerHTML=h;
  }).catch(function(){});
}

// ============================================================
// 管理员管理 — l_admins (2026-05-10 v2 - inline expand)
// ============================================================
var adminsData = [];
var admMe = null;  // current admin's own data

window.l_admins = function() {
  document.getElementById("pt").textContent = "管理员管理";
  var h = '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">';
  h += '<div style="font-size:13px;color:var(--muted)"><strong id="admStats">-</strong> 位管理员</div>';
  h += '<div style="display:flex;gap:8px">';
  h += '<button class="btn bp" id="admAddBtn" onclick="admToggleAdd()" style="display:none">+ 添加管理员</button>';
  h += '<button class="btn bo" onclick="admFocusSelf()">👤 我的设置</button>';
  h += '</div></div>';
  // Add admin form (hidden by default)
  h += '<div id="admAddForm" style="display:none" class="cd" style="margin-bottom:12px">';
  h += '<div class="st">添加管理员</div>';
  h += '<div class="g2">';
  h += '<div><div style="font-size:11px;color:var(--dim);margin-bottom:4px">手机号</div><input class="in" id="admAddPhone" placeholder="输入手机号" style="width:100%"></div>';
  h += '<div><div style="font-size:11px;color:var(--dim);margin-bottom:4px">角色</div><select class="sl" id="admAddRole" style="width:100%"><option value="admin">管理员</option><option value="operator">运营</option></select></div>';
  h += '<div style="grid-column:1/3;display:flex;flex-wrap:wrap;gap:8px;margin-top:4px" id="admAddPermsBody">';
  [['users','用户管理'],['content','内容管理'],['finance','财务管理'],['system','系统设置'],['matrix','Agent矩阵']].forEach(function(p){
    h += '<label style="font-size:12px;cursor:pointer;display:flex;align-items:center;gap:4px"><input type="checkbox" id="admAddPerm_'+p[0]+'" checked> '+p[1]+'</label>';
  });
  h += '</div>';
  h += '<div><div style="font-size:11px;color:var(--dim);margin-bottom:4px">真实姓名</div><input class="in" id="admAddName" placeholder="选填" style="width:100%"></div>';
  h += '<div><div style="font-size:11px;color:var(--dim);margin-bottom:4px">备注</div><input class="in" id="admAddNotes" placeholder="选填" style="width:100%"></div>';
  h += '</div>';
  h += '<div style="margin-top:8px"><button class="btn bp" onclick="admDoAdd()">确认添加</button> <button class="btn bo" onclick="admToggleAdd()">取消</button></div>';
  h += '</div>';
  // Card list
  h += '<div id="admList"><div class="lo"><div class="s"></div></div></div>';
  document.getElementById("mc").innerHTML = h;
  admLoad();
};

function admLoad() {
  fetch("/admin/admins/me", {headers:{"Authorization":"Bearer "+T}})
    .then(function(r){return r.json()})
    .then(function(d){
      if(!d.success)return;
      admMe = d.data;
      if(admMe.role === "super_admin") {
        var btn = document.getElementById("admAddBtn");
        if(btn) btn.style.display = "inline-block";
      }
    }).catch(function(){});
  
  fetch("/admin/admins", {headers:{"Authorization":"Bearer "+T}})
    .then(function(r){
      if(r.status === 403) return null;
      return r.json();
    })
    .then(function(d){
      if(d && d.success) {
        adminsData = d.data || [];
        admRender();
      } else {
        if(admMe) {
          adminsData = [admMe];
          admRender();
        }
      }
    }).catch(function(){});
}

function admRender() {
  document.getElementById("admStats").textContent = adminsData.length;
  var h = '';
  adminsData.forEach(function(a){
    var expanded = (a._expanded) ? true : false;
    // ── Card container ──
    h += '<div class="cd" style="margin-bottom:12px" id="admCard_'+a.id+'">';
    // ── Summary row ──
    h += '<div style="display:flex;align-items:center;gap:14px">';
    // Avatar
    var avatarHtml = '';
    if(a.avatar_url) {
      avatarHtml = '<img src="'+esc(a.avatar_url)+'" style="width:46px;height:46px;border-radius:50%;object-fit:cover;flex-shrink:0;cursor:pointer" onclick="admUploadAvatar('+a.id+')" title="点击更换头像">';
    } else {
      avatarHtml = '<div style="width:46px;height:46px;flex-shrink:0;cursor:pointer" onclick="admUploadAvatar('+a.id+')" title="点击上传头像">'+dicebearAvatar(a.real_name||a.nickname||a.phone||'A','initials',46)+'</div>';
    }
    h += avatarHtml;
    // Name + role + info
    h += '<div style="flex:1;min-width:0">';
    h += '<div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">';
    h += '<strong style="font-size:14px">'+esc(a.real_name||a.nickname||'管理员')+'</strong>';
    if(a.role === 'super_admin') h += '<span class="bdg" style="background:#d4a000;color:#000;font-size:10px">超管</span>';
    else if(a.role === 'admin') h += '<span class="bdg on" style="font-size:10px">管理员</span>';
    else h += '<span class="bdg pd" style="font-size:10px">运营</span>';
    h += '</div>';
    h += '<div style="font-size:12px;color:var(--muted);margin-top:2px">'+esc(a.phone||'')+' · '+(a.email||'-')+' · 创建 '+(a.admin_since||a.registered_at||'').slice(0,10)+'</div>';
    // Permission badges
    var perms = a.permissions||[];
    if(perms.length) {
      var permMap = {users:'用户',content:'内容',finance:'财务',system:'系统',matrix:'矩阵',admins:'管理'};
      h += '<div style="display:flex;gap:4px;margin-top:4px;flex-wrap:wrap">';
      perms.forEach(function(p){
        var label = permMap[p]||p;
        h += '<span style="font-size:10px;background:rgba(0,212,170,.1);color:var(--accent);padding:1px 6px;border-radius:3px">'+label+'</span>';
      });
      h += '</div>';
    }
    h += '</div>';
    // Right side: last login + buttons
    h += '<div style="text-align:right;flex-shrink:0">';
    if(a.last_login) h += '<div style="font-size:10px;color:var(--dim)">最后登录<br>'+(a.last_login||'').slice(0,10)+'</div>';
    h += '<div style="margin-top:6px;display:flex;gap:4px;justify-content:flex-end">';
    h += '<button class="btn bo bs" onclick="admToggleExpand('+a.id+')">'+(expanded?'收起':'编辑')+'</button>';
    if(a.role !== 'super_admin') {
      h += '<button class="btn bo bs" onclick="admConfirmRemove('+a.id+')" style="color:#f85149">移除</button>';
    }
    h += '</div></div></div>';
    // ── Expanded edit area ──
    if(expanded) {
      h += '<div style="border-top:1px solid var(--border);margin-top:12px;padding-top:12px">';
      // Hidden file input for avatar
      h += '<input type="file" id="admFile_'+a.id+'" accept="image/*" style="display:none" onchange="admUploadAvatarFile('+a.id+',this)">';
      // Avatar upload hint
      h += '<div style="font-size:11px;color:var(--dim);margin-bottom:10px">点击头像上传新头像（≤800×800，≤1MB）</div>';
      // Two-column form
      var isSelf = (admMe && admMe.id === a.id);
      h += '<div class="g2">';
      // Left column - basic info
      h += '<div>';
      h += '<div style="font-size:11px;color:var(--dim);margin-bottom:4px">真实姓名</div>';
      h += '<input class="in" id="admEdit_'+a.id+'_realName" value="'+esc(a.real_name||'')+'" style="width:100%">';
      h += '</div>';
      h += '<div>';
      h += '<div style="font-size:11px;color:var(--dim);margin-bottom:4px">内部联系手机</div>';
      h += '<input class="in" id="admEdit_'+a.id+'_intPhone" value="'+esc(a.internal_phone||'')+'" style="width:100%">';
      h += '</div>';
      h += '<div>';
      h += '<div style="font-size:11px;color:var(--dim);margin-bottom:4px">内部联系邮箱</div>';
      h += '<input class="in" id="admEdit_'+a.id+'_intEmail" value="'+esc(a.internal_email||'')+'" style="width:100%">';
      h += '</div>';
      h += '<div>';
      h += '<div style="font-size:11px;color:var(--dim);margin-bottom:4px">备注</div>';
      h += '<input class="in" id="admEdit_'+a.id+'_notes" value="'+esc(a.notes||'')+'" style="width:100%">';
      h += '</div>';
      // Role (only for super_admin editing others)
      if(!isSelf) {
        h += '<div>';
        h += '<div style="font-size:11px;color:var(--dim);margin-bottom:4px">角色</div>';
        h += '<select class="sl" id="admEdit_'+a.id+'_role" style="width:100%">';
        h += '<option value="super_admin" '+(a.role==='super_admin'?'selected':'')+'>超级管理员</option>';
        h += '<option value="admin" '+(a.role==='admin'?'selected':'')+'>管理员</option>';
        h += '<option value="operator" '+(a.role==='operator'?'selected':'')+'>运营</option>';
        h += '</select></div>';
      }
      // Permissions (not for super_admin)
      if(!isSelf && a.role !== 'super_admin') {
        h += '<div style="grid-column:1/3">';
        h += '<div style="font-size:11px;color:var(--dim);margin-bottom:4px">权限</div>';
        h += '<div style="display:flex;flex-wrap:wrap;gap:8px">';
        var curPerms = a.permissions||[];
        [['users','用户管理'],['content','内容管理'],['finance','财务管理'],['system','系统设置'],['matrix','Agent矩阵']].forEach(function(p){
          var checked = curPerms.indexOf(p[0])>=0?'checked':'';
          h += '<label style="font-size:12px;cursor:pointer;display:flex;align-items:center;gap:4px">';
          h += '<input type="checkbox" id="admEdit_'+a.id+'_perm_'+p[0]+'" '+checked+'> '+p[1]+'</label>';
        });
        h += '</div></div>';
      }
      h += '</div>'; // end g2
      
      // Password change — 短信验证码方式（两行：新密码+确认，验证码）
      h += '<div style="margin-top:12px;padding:10px;background:var(--bg);border-radius:6px">';
      h += '<div style="font-size:12px;font-weight:600;margin-bottom:6px">修改密码</div>';
      h += '<div style="font-size:11px;color:var(--rose);margin-bottom:6px">密码规则：至少10位，需包含大写字母、小写字母、数字、特殊字符中至少3种</div>';
      h += '<div style="display:flex;gap:8px">';
      h += '<input class="in" id="admEdit_'+a.id+'_pwd" type="password" placeholder="新密码" style="flex:1">';
      h += '<input class="in" id="admEdit_'+a.id+'_pwdConfirm" type="password" placeholder="确认新密码" style="flex:1">';
      h += '</div>';
      h += '<div style="margin-top:6px;display:flex;gap:8px;align-items:center">';
      h += '<span style="font-size:11px;color:var(--dim);flex-shrink:0">手机验证</span>';
      h += '<span style="font-size:12px;font-weight:500">'+esc(a.phone)+'</span>';
      h += '<button class="btn bo bs" id="admCodeBtn_'+a.id+'" onclick="admSendCode('+a.id+')">发送验证码</button>';
      h += '<input class="in" id="admEdit_'+a.id+'_code" placeholder="6位验证码" maxlength="6" style="flex:1">';
      h += '</div>';
      h += '</div>';
      
      // Action buttons
      h += '<div style="margin-top:12px;display:flex;gap:8px">';
      h += '<button class="btn bp" onclick="admSaveEdit('+a.id+')">保存</button>';
      h += '<button class="btn bo" onclick="admToggleExpand('+a.id+')">取消</button>';
      if(isSelf) {
        h += '<button class="btn bo" style="margin-left:auto" onclick="admChangePhone('+a.id+')">📱 修改手机号</button>';
      }
      h += '</div>';
      
      // Audit log
      if(a.recent_logs && a.recent_logs.length) {
        h += '<div style="margin-top:12px">';
        h += '<div style="font-size:11px;color:var(--dim);margin-bottom:4px">最近操作</div>';
        h += '<div style="max-height:100px;overflow-y:auto;font-size:11px;color:var(--muted);border:1px solid var(--border);border-radius:4px;padding:4px">';
        a.recent_logs.slice(0,10).forEach(function(l){
          h += '<div style="padding:2px 4px">';
          h += '<span style="color:var(--dim)">'+(l.created_at||'').slice(0,16)+'</span> ';
          h += esc(l.action)+' '+(l.detail?esc(l.detail):'');
          h += '</div>';
        });
        h += '</div></div>';
      }
      
      h += '</div>'; // end expanded area
    }
    h += '</div>'; // end cd
  });
  document.getElementById("admList").innerHTML = h;
}

// ── Toggle card expand/collapse ──
function admToggleExpand(uid) {
  for(var i=0;i<adminsData.length;i++) {
    if(adminsData[i].id === uid) {
      adminsData[i]._expanded = !adminsData[i]._expanded;
      // Fetch detail data if expanding and not already loaded
      if(adminsData[i]._expanded && !adminsData[i].recent_logs) {
        fetch("/admin/admins/"+uid, {headers:{"Authorization":"Bearer "+T}})
          .then(function(r){return r.json()})
          .then(function(d){
            if(d && d.success) {
              var detail = d.data;
              for(var j=0;j<adminsData.length;j++) {
                if(adminsData[j].id === detail.id) {
                  adminsData[j].recent_logs = detail.recent_logs;
                  adminsData[j].internal_email = detail.internal_email;
                  adminsData[j].internal_phone = detail.internal_phone;
                  adminsData[j].real_name = detail.real_name;
                  adminsData[j].notes = detail.notes;
                  adminsData[j].permissions = detail.permissions;
                  break;
                }
              }
              admRender();
            }
          }).catch(function(){});
      } else {
        admRender();
      }
      break;
    }
  }
}

// ── Avatar upload ──
function admUploadAvatar(uid) {
  // For self or others? For now only self can upload their own
  if(!admMe || admMe.id !== uid) {
    showToast("只能修改自己的头像","error");
    return;
  }
  var fileInput = document.getElementById("admFile_"+uid);
  if(fileInput) fileInput.click();
}

function admUploadAvatarFile(uid, input) {
  if(!input.files || !input.files[0]) return;
  var file = input.files[0];
  // Validate size
  if(file.size > 1024 * 1024) {
    showToast("图片不能超过 1MB（当前约 "+(file.size/1024).toFixed(0)+"KB）","error");
    return;
  }
  // Validate dimensions
  var img = new Image();
  img.onload = function() {
    if(img.width > 800 || img.height > 800) {
      showToast("图片尺寸不能超过 800×800（当前 "+img.width+"×"+img.height+"）","error");
      return;
    }
    // Upload
    var formData = new FormData();
    formData.append("avatar", file);
    fetch("/admin/admins/me/avatar", {
      method:"POST",
      headers:{"Authorization":"Bearer "+T},
      body:formData
    }).then(function(r){return r.json()}).then(function(d){
      if(d.success) {
        showToast("头像已更新","success");
        // Update local data and re-render
        for(var i=0;i<adminsData.length;i++) {
          if(adminsData[i].id === uid) {
            adminsData[i].avatar_url = d.data.avatar_url;
            break;
          }
        }
        admRender();
      } else {
        showToast(d.error||"上传失败","error");
      }
    }).catch(function(){showToast("上传请求失败","error")});
  };
  img.onerror = function() { showToast("无法加载图片","error"); };
  img.src = URL.createObjectURL(file);
}

// ── Add admin (super_admin only) ──
function admToggleAdd() {
  var el = document.getElementById("admAddForm");
  if(el) el.style.display = el.style.display==="none"?"block":"none";
}

function admDoAdd() {
  var phone = document.getElementById("admAddPhone").value.trim();
  if(!phone) { showToast("请输入手机号","error"); return; }
  var perms = [];
  ['users','content','finance','system','matrix'].forEach(function(k){
    var el = document.getElementById("admAddPerm_"+k);
    if(el && el.checked) perms.push(k);
  });
  var data = {
    phone: phone,
    role: document.getElementById("admAddRole").value,
    permissions: perms,
    real_name: document.getElementById("admAddName").value.trim(),
    notes: document.getElementById("admAddNotes").value.trim()
  };
  fetch("/admin/admins", {method:"POST", headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"}, body:JSON.stringify(data)})
    .then(function(r){return r.json()})
    .then(function(d){
      if(d.success) { showToast(d.message,"success"); admToggleAdd(); admLoad(); }
      else { showToast(d.error||"添加失败","error"); }
    }).catch(function(){showToast("请求失败","error")});
}

// ── Save edit ──
function admSaveEdit(uid) {
  var data = {};
  var el, val;
  
  el = document.getElementById("admEdit_"+uid+"_realName");
  if(el) data.real_name = el.value.trim();
  el = document.getElementById("admEdit_"+uid+"_intPhone");
  if(el) data.internal_phone = el.value.trim();
  el = document.getElementById("admEdit_"+uid+"_intEmail");
  if(el) data.internal_email = el.value.trim();
  el = document.getElementById("admEdit_"+uid+"_notes");
  if(el) data.notes = el.value.trim();
  
  // Role
  var isSelf = (admMe && admMe.id === uid);
  if(!isSelf) {
    el = document.getElementById("admEdit_"+uid+"_role");
    if(el) data.role = el.value;
    
    // Permissions
    var perms = [];
    ['users','content','finance','system','matrix'].forEach(function(k){
      var cb = document.getElementById("admEdit_"+uid+"_perm_"+k);
      if(cb && cb.checked) perms.push(k);
    });
    if(perms.length) data.permissions = perms;
  }
  
  // Password — 新密码+确认+短信验证码
  var pwdEl = document.getElementById("admEdit_"+uid+"_pwd");
  var confirmEl = document.getElementById("admEdit_"+uid+"_pwdConfirm");
  var codeEl = document.getElementById("admEdit_"+uid+"_code");
  if(pwdEl && pwdEl.value.trim()) {
    if(confirmEl && pwdEl.value.trim() !== confirmEl.value.trim()) {
      showToast("两次密码不一致","error"); return;
    }
    data.password = pwdEl.value.trim();
    if(codeEl && codeEl.value.trim()) data.code = codeEl.value.trim();
    else { showToast("请输入短信验证码","error"); return; }
  }
  
  // 有密码数据时发到 /admin/admins/<uid>，纯 profile 自改走 /admin/admins/me
  var hasPwd = data.password !== undefined;
  var url = (isSelf && !hasPwd) ? "/admin/admins/me" : "/admin/admins/"+uid;
  fetch(url, {method:"PUT", headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"}, body:JSON.stringify(data)})
    .then(function(r){return r.json()})
    .then(function(d){
      if(d.success) { showToast(d.message||"已更新","success"); admLoad(); }
      else { showToast(d.error||"保存失败","error"); }
    }).catch(function(){showToast("请求失败","error")});
}

// ── Send SMS code for password change ──
function admSendCode(uid) {
  // 从已加载的数据中取手机号（避免调 /admin/admins/<uid> 需 super_admin 权限）
  var phone = '';
  for(var i=0;i<adminsData.length;i++) {
    if(adminsData[i].id === uid) { phone = adminsData[i].phone; break; }
  }
  if(admMe && admMe.id === uid && !phone) phone = admMe.phone;
  if(!phone){showToast("该管理员没有绑定手机","error");return}
  // 必须带 Authorization header，否则后端要求图形验证码
  fetch("/auth/sms/send", {method:"POST", headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"}, body:JSON.stringify({phone:phone, purpose:"modify_password"})})
        .then(function(r){return r.json()})
        .then(function(d2){
          if(d2.success) showToast("验证码已发送到 "+phone,"success");
          else showToast(d2.error||"发送失败","error");
        }).catch(function(){showToast("请求失败","error")});
}

// ── Remove admin ──
function admConfirmRemove(uid) {
  fetch("/admin/admins/"+uid, {headers:{"Authorization":"Bearer "+T}})
    .then(function(r){return r.json()})
    .then(function(d){
      if(!d.success){showToast("获取信息失败","error");return}
      var name = d.data.real_name||d.data.nickname||d.data.phone||"该管理员";
      if(!confirm("确定将 "+name+" 降为普通用户？")) return;
      fetch("/admin/admins/"+uid, {method:"DELETE", headers:{"Authorization":"Bearer "+T}})
        .then(function(r2){return r2.json()})
        .then(function(d2){
          if(d2.success) { showToast(d2.message,"success"); admLoad(); }
          else { showToast(d2.error||"操作失败","error"); }
        }).catch(function(){showToast("请求失败","error")});
    }).catch(function(){showToast("请求失败","error")});
}

// ── Focus own card ──
function admFocusSelf() {
  if(!admMe) { showToast("正在加载...",""); return; }
  var found = false;
  for(var i=0;i<adminsData.length;i++) {
    if(adminsData[i].id === admMe.id) {
      if(!adminsData[i]._expanded) {
        adminsData[i]._expanded = true;
        // Fetch detail
        fetch("/admin/admins/"+admMe.id, {headers:{"Authorization":"Bearer "+T}})
          .then(function(r){return r.json()})
          .then(function(d){
            if(d && d.success) {
              var detail = d.data;
              for(var j=0;j<adminsData.length;j++) {
                if(adminsData[j].id === detail.id) {
                  adminsData[j].recent_logs = detail.recent_logs;
                  adminsData[j].internal_email = detail.internal_email;
                  adminsData[j].internal_phone = detail.internal_phone;
                  adminsData[j].real_name = detail.real_name;
                  adminsData[j].notes = detail.notes;
                  adminsData[j].permissions = detail.permissions;
                  break;
                }
              }
              admRender();
            }
          }).catch(function(){});
      }
      admRender();
      found = true;
      break;
    }
  }
  if(!found) {
    adminsData = [admMe];
    adminsData[0]._expanded = true;
    admRender();
  }
  // Scroll to top
  window.scrollTo(0, 0);
}

// ── Change phone (self-service) ──
function admChangePhone(uid) {
  if(!confirm("修改手机号需要向新手机发送验证码。确定继续？")) return;
  var newPhone = prompt("请输入新手机号：");
  if(!newPhone || !/^1\\d{10}$/.test(newPhone.replace(/\\D/g,''))) {
    showToast("请输入有效的手机号","error");
    return;
  }
  newPhone = newPhone.replace(/\\D/g,'');
  // Send code to new phone
  fetch("/auth/sms/send", {method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify({phone:newPhone, purpose:"change_phone"})})
    .then(function(r){return r.json()})
    .then(function(d){
      if(d.success) {
        var code = prompt("验证码已发送到 "+newPhone+"，请输入：");
        if(!code) return;
        fetch("/admin/admins/me/phone", {method:"PUT", headers:{"Authorization":"Bearer "+T,"Content-Type":"application/json"}, body:JSON.stringify({phone:newPhone, code:code})})
          .then(function(r2){return r2.json()})
          .then(function(d2){
            if(d2.success) { showToast("手机号已更新，请重新登录","success"); setTimeout(function(){logout()},1500); }
            else { showToast(d2.error||"修改失败","error"); }
          }).catch(function(){showToast("请求失败","error")});
      } else {
        showToast(d.error||"发送验证码失败","error");
      }
    }).catch(function(){showToast("请求失败","error")});
}

</script>
<script src="/static/lib/quill/quill.js" async></script>
</body>
</html>