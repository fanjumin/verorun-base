{
    "name": "Subscription",
    "identifier": "subscription",
    "version": "1.0.0",
    "description": "Unified Subscription Management — Pay-as-you-go feature marketplace with dual-environment payment routing (cn: Alipay/WeChat, intl: Stripe/PayPal)",
    "author": "VeroRun",
    "min_app_version": "0.10.0",
    "category": "system",
    "icon": "credit_card",
    "icon_url": "https://cdn.verorun.com/plugins/subscription/icon.png",
    "readme_url": "https://cdn.verorun.com/plugins/subscription/README.md",
    "screenshots": [],
    "tags": ["subscription", "payment", "billing"],
    "dependencies": {},
    "enabled": true,
    "admin_url": "/plugin/subscription/admin/",
    "admin_label": "Subscription Settings",
    "menu": {
        "group": "System",
        "key": "subscription_admin",
        "icon": "credit_card",
        "label": "Subscription Settings",
        "embed_url": "/plugin/subscription/admin/"
    },
    "config": {
        "trial_days": 0,
        "grace_days": 3,
        "auto_renew_default": true
    },
    "permissions": [
        "api:read",
        "api:write",
        "admin:access"
    ],
    "hooks": {
        "provides": [
            "subscription/has",
            "subscription/list",
            "subscription/subscribe",
            "subscription/cancel",
            "subscription/renew"
        ],
        "listens": []
    },
    "settings_schema": {
        "type": "object",
        "properties": {
            "trial_days": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "description": "Free trial period in days (0 = no trial)"
            },
            "grace_days": {
                "type": "integer",
                "default": 3,
                "minimum": 0,
                "description": "Grace period after expiration before disabling"
            },
            "auto_renew_default": {
                "type": "boolean",
                "default": true,
                "description": "Default auto-renew for new subscriptions"
            }
        }
    }
}
