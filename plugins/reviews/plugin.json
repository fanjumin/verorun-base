{
    "name": "Product Reviews",
    "name_i18n_key": "plugin.name",
    "identifier": "reviews",
    "version": "1.1.1",
    "description": "商品评价系统 — 用户对已购商品打分、写评价、晒图",
    "author": "VeroRun",
    "min_app_version": "0.10.0",
    "category": "shop",
    "icon": "star",
    "tags": ["评价", "商品", "晒图"],
    "dependencies": {},
    "config": {},
    "permissions": [
        "shop.product.read",
        "user.read"
    ],
    "hooks": {
        "provides": [
            "review/validate"
        ],
        "listens": [
            "order.paid"
        ]
    },
    "dashboard": {
        "stats": [
            { "key": "total_reviews",  "title": "评价总数",    "type": "counter" },
            { "key": "avg_rating",     "title": "平均评分",    "type": "gauge" },
            { "key": "positive_rate",  "title": "好评率",      "type": "gauge" },
            { "key": "reviews_24h",    "title": "24h 新增评价", "type": "counter" },
            { "key": "with_images",    "title": "带图评价",    "type": "counter" }
        ]
    },
    "settings_schema": {
        "type": "object",
        "properties": {}
    }
}
