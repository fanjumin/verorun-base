{
    "name": "Payment Gateway",
    "identifier": "payment",
    "version": "1.1.0",
    "category": "shop",
    "tags": ["payment", "alipay", "wechat", "stripe", "paypal", "gateway"],
    "icon": "plugins",
    "icon_url": "",
    "screenshots": [],
    "readme_url": "",
    "description": "Payment Gateway — Alipay/WeChat/Stripe/PayPal configuration management (independent PG schema)",
    "author": "VeroRun",
    "min_app_version": "0.10.0",
    "dependencies": {},
    "config": {
        "default_currency": "CNY"
    },
    "permissions": [
        "api:read",
        "api:write",
        "admin:access"
    ],
    "hooks": {
        "provides": [
            "payment/create",
            "payment/confirm",
            "payment/verify_notify"
        ],
        "listens": []
    },
    "admin_url": "#payment",
    "menu": {
        "group": "Business Center",
        "key": "payment",
        "icon": "plugins",
        "label": "Payment Config"
    },
    "dashboard": {
        "stats": [
            { "key": "total_logs", "title": "支付日志数", "type": "counter" },
            { "key": "total_configs", "title": "已配置渠道", "type": "counter" },
            { "key": "recent_payments", "title": "24h 支付量", "type": "gauge" }
        ]
    },
    "settings_schema": {
        "type": "object",
        "properties": {
            "default_currency": {
                "type": "string",
                "default": "CNY",
                "description": "Default currency for payment orders"
            }
        }
    }
}
