{
    "name": "AI Site Builder",
    "name_i18n_key": "plugin.name",
    "identifier": "site_builder",
    "version": "2.1.0",
    "category": "content",
    "icon": "layout",
    "icon_url": "",
    "screenshots": [],
    "readme_url": "README.md",
    "description": "LLM-driven website builder: prompt templates, site tasks & unified design tokens (decoupled from core, independent database)",
    "author": "VeroRun",
    "min_app_version": "2.0.0",

    "dependencies": {},

    "replaces_plugins": [],

    "admin_url": "/admin/site-builder/prompts",
    "admin_label": "AI Site Builder",

    "config": {
        "db_url_env": "SITE_BUILDER_DB_URL",
        "database_name": "site_builder",
        "schema": "site_builder",
        "internal_base_url_env": "MAIN_SITE_INTERNAL_URL",
        "internal_token_env": "INTERNAL_SERVICE_TOKEN"
    },

    "permissions": [
        "admin:access",
        "database:write",
        "network:request",
        "file:write"
    ],

    "hooks": {
        "provides": [
            "site_builder.build",
            "site_builder.publish",
            "site_settings.tokens"
        ],
        "listens": []
    },

    "menu": {
        "group": "System",
        "items": [
            {
                "key": "site_builder",
                "icon": "layout",
                "label": "AI Site Builder",
                "label_i18n_key": "menu.site_builder",
                "url": "/admin/site-builder/prompts"
            },
            {
                "key": "site_settings",
                "icon": "sliders",
                "label": "Site Settings",
                "label_i18n_key": "menu.site_settings",
                "url": "/admin/site-settings"
            }
        ]
    },

    "settings_schema": {
        "type": "object",
        "properties": {}
    }
}
