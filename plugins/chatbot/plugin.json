{
    "name": "AI Advisor",
    "identifier": "chatbot",
    "version": "0.1.0",
    "category": "ai_agent",
    "icon": "message-circle",
    "tags": ["chatbot", "customer-service", "ai", "rag", "advisor"],
    "description": "Site-wide AI advisor chatbot. Uses independent database (chatbot.db) for configs, sessions, and agent registry. Cross-reads main DB for knowledge base and user tickets.",
    "author": "VeroRun",
    "min_app_version": "0.10.0",
    "dependencies": {},
    "enabled": true,
    "config": {
        "enabled": "1",
        "auto_escalate": "1",
        "title": "AI Advisor",
        "subtitle": "Powered by AI Engine",
        "welcome_message": "Hello! I am your AI advisor. How can I help you today?",
        "help_hint": "Type help to see what I can do for you",
        "avatar_url": "",
        "agent_id": "chat_assistant",
        "max_history": "20",
        "float_button_text": "AI Advisor",
        "handoff_keywords": "[\"人工\", \"客服\", \"转人工\", \"联系真人\", \"联系工作人员\", \"商务\", \"合作\", \"投诉\", \"定制\", \"开发\"]",
        "handoff_max_fails": "3"
    },
    "permissions": ["api:read", "network:request"],
    "hooks": {
        "provides": ["chatbot/config", "chatbot/chat"],
        "listens": []
    },
    "agents": [
        {
            "name": "Advisor Agent",
            "identifier": "chat_assistant",
            "role_type": "sub",
            "domain": "chatbot",
            "prompt_file": "prompts/sub_chatbot_prompt.md",
            "model_policy": {"strategy": "tier", "tier": "standard", "allow_user_override": true, "fallback": "inherit"},
            "capabilities": ["chatbot.faq", "chatbot.ticket", "chatbot.human_handoff"],
            "enabled_by_default": true
        }
    ],
    "menu": {
        "group": "AI & Content",
        "key": "chatbot",
        "icon": "message-circle",
        "label": "AI Advisor"
    },
    "settings_schema": {
        "type": "object",
        "properties": {
            "enabled": {"title": "Enable AI Advisor", "type": "boolean", "default": true},
            "auto_escalate": {"title": "Auto-Create Ticket on Handoff", "type": "boolean", "default": true},
            "title": {"title": "Chat Window Title", "type": "string"},
            "subtitle": {"title": "Subtitle", "type": "string"},
            "welcome_message": {"title": "Welcome Message", "type": "string"},
            "help_hint": {"title": "Help Hint", "type": "string"},
            "avatar_url": {"title": "Avatar URL", "type": "string"},
            "agent_id": {"title": "Bound Agent ID", "type": "string", "description": "Agent identifier in agent_matrix table"},
            "max_history": {"title": "Max History Rounds", "type": "integer", "default": 20, "minimum": 1, "maximum": 50},
            "float_button_text": {"title": "Float Button Text", "type": "string"}
        }
    }
}
