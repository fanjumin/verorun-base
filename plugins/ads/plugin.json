{
    "name": "Ad Management",
    "identifier": "ads",
    "version": "1.0.0",
    "category": "Operations",
    "tags": ["advertising", "banner", "placement", "analytics", "ai-ready"],
    "icon": "ads",
    "description": "Ad Management — Ad placements, zones, impressions/clicks stats, and AI-ready APIs",
    "author": "VeroRun",
    "min_app_version": "0.10.0",
    "dependencies": {},
    "enabled": true,
    "admin_url": "",
    "admin_label": "Ad Settings",
    "config": {
        "default_width": 320,
        "default_height": 0,
        "max_placements": 50
    },
    "permissions": [
        "ads.read",
        "ads.write"
    ],
    "hooks": {
        "provides": [
            "ads/get_placements",
            "ads/render_ad",
            "ads/get_stats",
            "ads/record_impression",
            "ads/record_click"
        ],
        "listens": []
    },
    "menu": {
        "group": "Payment & Operations",
        "key": "ads",
        "icon": "ads",
        "label": "Ad Management"
    },
    "settings_schema": {
        "type": "object",
        "properties": {
            "default_width": {
                "type": "integer",
                "default": 320,
                "description": "Default ad width"
            },
            "default_height": {
                "type": "integer",
                "default": 0,
                "description": "Default ad height (0 = auto)"
            },
            "max_placements": {
                "type": "integer",
                "default": 50,
                "description": "Maximum placement count"
            }
        }
    }
}
