{
    "name": "Ad Management",
    "identifier": "ads",
    "version": "1.1.0",
    "category": "content",
    "tags": ["advertising", "banner", "placement", "analytics", "ai-ready"],
    "icon": "ads",
    "description": "Ad Management — Ad placements, zones, impressions/clicks stats, and AI-ready APIs",
    "author": "VeroRun",
    "min_app_version": "0.10.0",
    "dependencies": {},
    "enabled": true,
    "admin_url": "",
    "admin_label": "Ad Settings",
    "config": {
        "default_width": 320,
        "default_height": 0,
        "max_placements": 50
    },
    "permissions": [
        "api:read",
        "api:write",
        "admin:access"
    ],
    "hooks": {
        "provides": [
            "ads/get_placements",
            "ads/render_ad",
            "ads/get_stats",
            "ads/record_impression",
            "ads/record_click"
        ],
        "listens": []
    },
    "declare_roles": [
        {
            "name": "Ad Optimizer",
            "slug": "ad_optimizer",
            "role_type": "sub",
            "domain": "advertising",
            "description": "Manages ad placements, zones, impressions/clicks stats, and ad optimization via the ads plugin",
            "managed_modules": ["plugins.ads"],
            "provider": "dashscope",
            "model_name": "qwen-turbo",
            "system_prompt": "You are the ad management agent. Use the ads AI tools to list/create/update/delete ad placements, manage zones, query statistics, analyze performance, and generate render snippets.",
            "is_active": 1
        }
    ],
    "agents": [
        {
            "name": "Ad Optimizer",
            "identifier": "ad_optimizer",
            "role_type": "sub",
            "domain": "advertising",
            "prompt_file": "agents/ad_optimizer_prompt.md",
            "model_policy": {
                "strategy": "tier",
                "tier": "cheap",
                "allow_user_override": true,
                "fallback": "inherit"
            },
            "capabilities": [
                "ads.list",
                "ads.create",
                "ads.update",
                "ads.delete",
                "ads.stats",
                "ads.analyze",
                "ads.snippet"
            ],
            "enabled_by_default": true
        }
    ],
    "dashboard": {
        "stats": [
            {"key": "total_placements", "title": "Total Placements", "type": "counter"},
            {"key": "total_impressions", "title": "Total Impressions", "type": "counter"},
            {"key": "total_clicks", "title": "Total Clicks", "type": "counter"},
            {"key": "active_placements", "title": "Active Placements", "type": "gauge"}
        ]
    },
    "menu": {
        "group": "AI & Content",
        "key": "ads",
        "icon": "ads",
        "label": "Ad Management"
    },
    "settings_schema": {
        "type": "object",
        "properties": {
            "default_width": {
                "type": "integer",
                "default": 320,
                "description": "Default ad width"
            },
            "default_height": {
                "type": "integer",
                "default": 0,
                "description": "Default ad height (0 = auto)"
            },
            "max_placements": {
                "type": "integer",
                "default": 50,
                "description": "Maximum placement count"
            }
        }
    }
}
