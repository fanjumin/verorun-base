{
    "name": "Analytics",
    "identifier": "analytics",
    "version": "1.3.0",
    "description": "Analytics Middleware & Dashboard — Server-side Cookieless Analytics",
    "author": "VeroRun",
    "min_app_version": "0.10.0",
    "dependencies": {},
    "enabled": true,
    "admin_url": "",
    "admin_label": "Analytics Settings",
    "config": {
        "sample_rate": 1.0,
        "geoip_enabled": true,
        "service_name": "admin"
    },
    "permissions": [
        "analytics.read",
        "analytics.write"
    ],
    "hooks": {
        "provides": [
            "analytics/track_event",
            "analytics/get_realtime",
            "analytics/get_trend"
        ],
        "listens": []
    },
    "menu": {
        "group": "Monitoring & Data",
        "key": "analytics",
        "icon": "analytics",
        "label": "Analytics",
        "embed_url": "/admin/analytics/"
    },
    "settings_schema": {
        "type": "object",
        "properties": {
            "sample_rate": {
                "type": "number",
                "default": 1.0,
                "minimum": 0.0,
                "maximum": 1.0,
                "description": "Sampling rate for request capture"
            },
            "geoip_enabled": {
                "type": "boolean",
                "default": true,
                "description": "Enable GeoIP location lookup"
            },
            "service_name": {
                "type": "string",
                "default": "admin",
                "description": "Service name label for analytics logs"
            },
            "maxmind_account_id": {
                "type": "string",
                "default": "",
                "description": "MaxMind Account ID for GeoLite2 download"
            },
            "maxmind_license_key": {
                "type": "string",
                "default": "",
                "description": "MaxMind License Key for GeoLite2 download"
            }
        }
    }
}
