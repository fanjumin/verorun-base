{
    "name": "Mini App Builder",
    "name_i18n_key": "plugin.name",
    "identifier": "mini_app_builder",
    "version": "2.0.0",
    "category": "tools",
    "icon": "deploy",
    "icon_url": "",
    "screenshots": [],
    "readme_url": "README.md",
    "description": "Mini-program generation & developer account management (merged with dev_accounts)",
    "author": "VeroRun",
    "min_app_version": "2.0.0",

    "dependencies": {},

    "provides_credential_management": true,
    "replaces_plugins": ["dev_accounts"],

    "admin_url": "/admin/site-builder/mini-app",
    "admin_label": "Mini Apps",

    "config": {
        "output_base": "workspace/mini_apps",
        "task_ttl_seconds": 3600,
        "max_concurrent_tasks": 5,
        "ai_generation_enabled": true,
        "encryption_key_env": "MINI_APP_ENCRYPTION_KEY"
    },

    "permissions": [
        "admin:access",
        "database:write",
        "network:request",
        "file:write",
        "crypto:encrypt"
    ],

    "hooks": {
        "provides": [
            "mini_app.generate",
            "mini_app.deploy",
            "mini_app.preview",
            "dev_accounts.created",
            "dev_accounts.updated",
            "dev_accounts.deleted"
        ],
        "listens": [
            "site.created",
            "brand.updated"
        ]
    },

    "dashboard": {
        "stats": [
            {"key": "total_accounts", "title": "Total Accounts", "type": "counter"},
            {"key": "active_accounts", "title": "Active Accounts", "type": "counter"},
            {"key": "total_projects", "title": "Total Projects", "type": "counter"},
            {"key": "total_versions", "title": "Total Versions", "type": "counter"}
        ]
    },

    "menu": {
        "group": "System",
        "items": [
            {
                "key": "mini_apps",
                "icon": "deploy",
                "label": "Mini Apps",
                "label_i18n_key": "menu.mini_apps",
                "url": "/admin/site-builder/mini-app"
            },
            {
                "key": "dev_accounts",
                "icon": "key",
                "label": "Developer Accounts",
                "label_i18n_key": "menu.dev_accounts",
                "url": "/admin/dev-accounts"
            }
        ]
    },

    "settings_schema": {
        "type": "object",
        "properties": {}
    }
}
