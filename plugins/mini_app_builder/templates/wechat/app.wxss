page {
    --primary-color: {{ primary_color }};
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 28rpx;
    color: #333;
    background: #f5f5f5;
}

.container {
    padding: 0;
}

button {
    border: none;
    border-radius: 12rpx;
}

button::after {
    border: none;
}