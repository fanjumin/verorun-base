<view class="chat-widget">
    <view class="cw-toggle" bindtap="onToggle" wx:if="{{ !showWidget }}">
        <text class="cw-toggle-icon">Chat</text>
    </view>

    <view class="cw-panel" wx:if="{{ showWidget }}">
        <view class="cw-header" style="background-color: {{ primaryColor }}">
            <text class="cw-title">AI Advisor</text>
            <view class="cw-close" bindtap="onClose">
                <text>Close</text>
            </view>
        </view>

        <scroll-view class="cw-messages" scroll-y="true" scroll-into-view="cw-msg-{{ messages.length - 1 }}">
            <view class="cw-message-list">
                <view class="cw-message {{ item.role === 'user' ? 'cw-user' : 'cw-assistant' }}"
                      wx:for="{{ messages }}"
                      wx:key="index"
                      id="cw-msg-{{ index }}">
                    <text class="cw-message-role">{{ item.role === 'user' ? 'You' : 'AI' }}</text>
                    <text class="cw-message-text">{{ item.content }}</text>
                </view>

                <view class="cw-typing" wx:if="{{ isStreaming }}">
                    <text>AI is typing...</text>
                </view>
            </view>
        </scroll-view>

        <view class="cw-input-bar">
            <input class="cw-input"
                   placeholder="{{ placeholder }}"
                   value="{{ inputValue }}"
                   bindinput="onInput"
                   confirm-type="send"
                   bindconfirm="onSend" />
            <button class="cw-send-btn"
                    bindtap="onSend"
                    style="background-color: {{ primaryColor }}"
                    disabled="{{ !inputValue || isStreaming }}">
                Send
            </button>
        </view>
    </view>
</view>