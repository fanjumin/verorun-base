.chat-page {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background: #f0f0f0;
}

.chat-header {
    padding: 20rpx 32rpx;
    background: var(--primary-color);
    color: #fff;
    text-align: center;
    flex-shrink: 0;
}

.chat-title {
    font-size: 32rpx;
    font-weight: 600;
}

.chat-messages {
    flex: 1;
    padding: 24rpx;
    overflow-y: auto;
}

.message-list {
    display: flex;
    flex-direction: column;
}

.message {
    margin-bottom: 24rpx;
    max-width: 80%;
}

.message.user {
    align-self: flex-end;
}

.message.assistant {
    align-self: flex-start;
}

.message-role {
    font-size: 22rpx;
    color: #999;
    display: block;
    margin-bottom: 4rpx;
}

.message.user .message-role {
    text-align: right;
}

.message-text {
    font-size: 28rpx;
    padding: 16rpx 24rpx;
    border-radius: 16rpx;
    display: inline-block;
    word-break: break-all;
    line-height: 1.6;
}

.message.assistant .message-text {
    background: #fff;
    color: #333;
}

.message.user .message-text {
    background: var(--primary-color);
    color: #fff;
}

.typing-indicator {
    padding: 16rpx 0;
}

.typing-indicator text {
    font-size: 24rpx;
    color: #999;
    font-style: italic;
}

.chat-input-bar {
    padding: 16rpx 24rpx;
    background: #fff;
    border-top: 1rpx solid #e0e0e0;
    display: flex;
    align-items: center;
    gap: 16rpx;
    flex-shrink: 0;
}

.chat-input {
    flex: 1;
    height: 72rpx;
    background: #f5f5f5;
    border-radius: 36rpx;
    padding: 0 28rpx;
    font-size: 28rpx;
}

.send-btn {
    padding: 0 32rpx;
    height: 72rpx;
    line-height: 72rpx;
    background: var(--primary-color);
    color: #fff;
    font-size: 26rpx;
    border-radius: 36rpx;
}

.send-btn[disabled] {
    opacity: 0.5;
}