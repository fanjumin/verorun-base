.chat-page {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background: #f0f0f0;
}

.chat-header {
    padding: 20rpx 30rpx;
    background: var(--primary-color);
    color: #ffffff;
}

.chat-title {
    font-size: 36rpx;
    font-weight: bold;
}

.chat-subtitle {
    font-size: 24rpx;
    opacity: 0.8;
    display: block;
}

.chat-messages {
    flex: 1;
    padding: 20rpx;
    overflow-y: auto;
}

.msg-item {
    margin-bottom: 20rpx;
    display: flex;
}

.msg-user {
    justify-content: flex-end;
}

.msg-assistant {
    justify-content: flex-start;
}

.msg-bubble {
    max-width: 80%;
    padding: 20rpx 30rpx;
    border-radius: 20rpx;
    font-size: 30rpx;
    line-height: 1.6;
    word-break: break-all;
}

.msg-user .msg-bubble {
    background: var(--primary-color);
    color: #ffffff;
}

.msg-assistant .msg-bubble {
    background: #ffffff;
    color: #333333;
}

.typing-indicator {
    opacity: 0.6;
}

.chat-input-area {
    display: flex;
    padding: 20rpx;
    background: #ffffff;
    border-top: 1rpx solid #e5e5e5;
}

.chat-input {
    flex: 1;
    height: 72rpx;
    padding: 0 20rpx;
    background: #f5f5f5;
    border-radius: 36rpx;
    font-size: 30rpx;
}

.send-btn {
    margin-left: 16rpx;
    padding: 0 30rpx;
    height: 72rpx;
    background: var(--primary-color);
    color: #ffffff;
    border-radius: 36rpx;
    font-size: 28rpx;
    line-height: 72rpx;
}