{
    "name": "Social Push",
    "identifier": "social_push",
    "version": "1.2.0",
    "category": "social",
    "tags": ["social", "publish", "wechat", "weibo", "toutiao", "twitter", "linkedin", "reddit", "telegram", "content"],
    "icon": "social_media",
    "icon_url": "",
    "screenshots": [],
    "readme_url": "README.md",
    "description": "Social Push — Multi-platform social content publishing (WeChat OA / Weibo / Toutiao) with publish history",
    "author": "VeroRun",
    "min_app_version": "0.10.0",
    "dependencies": {},
    "config": {},
    "permissions": [
        "social_push.read",
        "social_push.write",
        "social_push.publish",
        "network.request"
    ],
    "hooks": {
        "provides": [
            "social_push/publish"
        ],
        "listens": []
    },
    "menu": {
        "group": "Publishing",
        "key": "social",
        "icon": "social_media",
        "label": "Social Push"
    },
    "dashboard": {
        "stats": [
            {"key": "total_publishes", "title": "累计发布", "type": "counter"},
            {"key": "today_publishes", "title": "今日发布", "type": "counter"}
        ]
    },
    "settings_schema": {
        "type": "object",
        "properties": {
            "wechat_app_id": {
                "type": "string",
                "default": "",
                "description": "WeChat Official Account AppID"
            },
            "wechat_app_secret": {
                "type": "string",
                "default": "",
                "description": "WeChat Official Account AppSecret (sensitive)"
            },
            "weibo_app_key": {
                "type": "string",
                "default": "",
                "description": "Weibo App Key"
            },
            "weibo_access_token": {
                "type": "string",
                "default": "",
                "description": "Weibo Access Token (sensitive)"
            },
            "toutiao_app_id": {
                "type": "string",
                "default": "",
                "description": "Toutiao App ID"
            },
            "toutiao_access_token": {
                "type": "string",
                "default": "",
                "description": "Toutiao Access Token (sensitive)"
            },
            "twitter_api_key": {
                "type": "string",
                "default": "",
                "description": "Twitter API Key"
            },
            "twitter_api_secret": {
                "type": "string",
                "default": "",
                "description": "Twitter API Secret (sensitive)"
            },
            "twitter_access_token": {
                "type": "string",
                "default": "",
                "description": "Twitter Access Token (sensitive)"
            },
            "twitter_access_secret": {
                "type": "string",
                "default": "",
                "description": "Twitter Access Token Secret (sensitive)"
            },
            "twitter_bearer_token": {
                "type": "string",
                "default": "",
                "description": "Twitter Bearer Token (sensitive)"
            },
            "linkedin_client_id": {
                "type": "string",
                "default": "",
                "description": "LinkedIn Client ID"
            },
            "linkedin_client_secret": {
                "type": "string",
                "default": "",
                "description": "LinkedIn Client Secret (sensitive)"
            },
            "linkedin_access_token": {
                "type": "string",
                "default": "",
                "description": "LinkedIn Access Token (sensitive)"
            },
            "reddit_client_id": {
                "type": "string",
                "default": "",
                "description": "Reddit Client ID"
            },
            "reddit_client_secret": {
                "type": "string",
                "default": "",
                "description": "Reddit Client Secret (sensitive)"
            },
            "reddit_username": {
                "type": "string",
                "default": "",
                "description": "Reddit Username"
            },
            "reddit_password": {
                "type": "string",
                "default": "",
                "description": "Reddit Password (sensitive)"
            },
            "telegram_bot_token": {
                "type": "string",
                "default": "",
                "description": "Telegram Bot Token (sensitive)"
            },
            "telegram_channel": {
                "type": "string",
                "default": "",
                "description": "Telegram Channel / Chat ID"
            }
        }
    }
}
