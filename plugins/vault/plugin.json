{
    "name": "Vault",
    "identifier": "vault",
    "version": "2.0.0",
    "description": "Data vault — full/incremental backup, AES-256-GCM encryption, scheduled backups, audit logging, multi-target storage",
    "author": "VeroRun",
    "min_app_version": "0.10.0",
    "category": "system",
    "icon": "vault",
    "tags": ["backup", "storage", "system", "encryption", "scheduler"],
    "dependencies": {
        "python": ["croniter", "cryptography", "paramiko", "requests"]
    },
    "enabled": true,
    "config": {
        "backup_dir": "data/vault",
        "keep_days": 30,
        "include_files": true,
        "include_config": true,
        "encryption": {
            "enabled": false,
            "algorithm": "aes256-gcm",
            "key_source": "env"
        },
        "compression": {
            "algorithm": "gzip",
            "level": 6
        },
        "storage": {
            "type": "local",
            "s3_bucket": "",
            "s3_region": "",
            "s3_access_key": "",
            "s3_secret_key": "",
            "oss_endpoint": "",
            "oss_bucket": "",
            "oss_access_key": "",
            "oss_secret_key": ""
        },
        "schedule": {
            "enabled": false,
            "interval_hours": 24
        },
        "notifications": {
            "email": {
                "enabled": false,
                "smtp_host": "",
                "smtp_port": 465,
                "smtp_user": "",
                "smtp_password": "",
                "recipients": []
            },
            "webhook": {
                "enabled": false,
                "url": "",
                "headers": {}
            },
            "feishu": {
                "enabled": false,
                "webhook_url": ""
            },
            "dingtalk": {
                "enabled": false,
                "webhook_url": ""
            }
        }
    },
    "permissions": [
        "vault.read",
        "vault.write",
        "vault.download",
        "vault.admin"
    ],
    "hooks": {
        "provides": [
            "vault/create_backup",
            "vault/list_backups",
            "vault/delete_backup",
            "vault/health_check",
            "vault/audit_log"
        ],
        "listens": []
    },
    "menu": {
        "group": "System",
        "key": "vault",
        "icon": "vault",
        "label": "Vault",
        "embed_url": "/admin/vault/"
    },
    "settings_schema": {
        "type": "object",
        "properties": {
            "backup_dir": { "type": "string", "default": "data/vault" },
            "keep_days": { "type": "integer", "default": 30, "minimum": 1 },
            "include_files": { "type": "boolean", "default": true },
            "include_config": { "type": "boolean", "default": true },
            "encryption": { "type": "object" },
            "compression": { "type": "object" },
            "storage": { "type": "object" },
            "schedule": { "type": "object" },
            "notifications": { "type": "object" }
        }
    }
}
