.chat-widget {
    z-index: 999;
}

.cw-toggle {
    position: fixed;
    right: 32rpx;
    bottom: 200rpx;
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    background: #333;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.2);
}

.cw-toggle-icon {
    font-size: 28rpx;
    color: #fff;
}

.cw-panel {
    position: fixed;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 80vh;
    background: #fff;
    border-radius: 24rpx 24rpx 0 0;
    box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.1);
    display: flex;
    flex-direction: column;
}

.cw-header {
    padding: 24rpx 32rpx;
    border-radius: 24rpx 24rpx 0 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #fff;
}

.cw-title {
    font-size: 32rpx;
    font-weight: 600;
}

.cw-close {
    font-size: 28rpx;
    opacity: 0.8;
}

.cw-messages {
    flex: 1;
    padding: 24rpx;
    overflow-y: auto;
}

.cw-message-list {
    display: flex;
    flex-direction: column;
}

.cw-message {
    margin-bottom: 24rpx;
    max-width: 85%;
}

.cw-user {
    align-self: flex-end;
}

.cw-assistant {
    align-self: flex-start;
}

.cw-message-role {
    font-size: 22rpx;
    color: #999;
    display: block;
    margin-bottom: 4rpx;
}

.cw-message-text {
    font-size: 28rpx;
    color: #333;
    background: #f0f0f0;
    padding: 16rpx 24rpx;
    border-radius: 16rpx;
    display: inline-block;
    word-break: break-all;
}

.cw-user .cw-message-text {
    background: #333;
    color: #fff;
}

.cw-typing {
    padding: 16rpx 0;
}

.cw-typing text {
    font-size: 24rpx;
    color: #999;
    font-style: italic;
}

.cw-input-bar {
    padding: 16rpx 24rpx;
    border-top: 1rpx solid #eee;
    display: flex;
    align-items: center;
    gap: 16rpx;
}

.cw-input {
    flex: 1;
    height: 72rpx;
    background: #f5f5f5;
    border-radius: 36rpx;
    padding: 0 28rpx;
    font-size: 28rpx;
}

.cw-send-btn {
    padding: 0 32rpx;
    height: 72rpx;
    line-height: 72rpx;
    color: #fff;
    font-size: 26rpx;
    border-radius: 36rpx;
}

.cw-send-btn[disabled] {
    opacity: 0.5;
}