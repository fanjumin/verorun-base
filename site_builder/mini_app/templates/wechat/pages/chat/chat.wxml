<view class="chat-page">
    <!-- Header -->
    <view class="chat-header">
        <text class="chat-title">{{ appName }} AI Advisor</text>
    </view>

    <!-- Messages -->
    <scroll-view class="chat-messages" scroll-y="true" scroll-into-view="msg-{{ messages.length - 1 }}">
        <view class="message-list">
            <view class="message {{ item.role }}"
                  wx:for="{{ messages }}"
                  wx:key="index"
                  id="msg-{{ index }}">
                <text class="message-role">{{ item.role === 'user' ? 'You' : 'AI' }}</text>
                <text class="message-text">{{ item.content }}</text>
            </view>

            <view class="typing-indicator" wx:if="{{ isStreaming }}">
                <text>AI is typing...</text>
            </view>
        </view>
    </scroll-view>

    <!-- Input -->
    <view class="chat-input-bar">
        <input class="chat-input"
               placeholder="Type your message..."
               value="{{ inputValue }}"
               bindinput="onInput"
               confirm-type="send"
               bindconfirm="onSend" />
        <button class="send-btn" bindtap="onSend" disabled="{{ !inputValue || isStreaming }}">
            Send
        </button>
    </view>
</view>