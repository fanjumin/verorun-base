<view class="chat-page">
    <view class="chat-header">
        <text class="chat-title">{{ app_name }}</text>
        <text class="chat-subtitle">AI Advisor</text>
    </view>

    <scroll-view class="chat-messages" scroll-y scroll-into-view="msg-{{messages.length - 1}}">
        <view wx:for="{{messages}}" wx:key="index" id="msg-{{index}}"
              class="msg-item {{item.role === 'user' ? 'msg-user' : 'msg-assistant'}}">
            <view class="msg-bubble">
                <text>{{item.content}}</text>
            </view>
        </view>
        <view wx:if="{{isStreaming}}" class="msg-item msg-assistant">
            <view class="msg-bubble typing-indicator">
                <text>...</text>
            </view>
        </view>
    </scroll-view>

    <view class="chat-input-area">
        <input class="chat-input" value="{{inputValue}}"
               placeholder="Type your question..."
               bindinput="onInput"
               confirm-type="send"
               bindconfirm="onSend"/>
        <button class="send-btn" bindtap="onSend" disabled="{{isStreaming}}">
            Send
        </button>
    </view>
</view>