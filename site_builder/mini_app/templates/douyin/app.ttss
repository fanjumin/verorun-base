/* Global styles for {{ app_name }} Douyin Mini-Program */
page {
    --primary-color: {{ primary_color }};
    --bg-color: #f5f5f5;
    --text-color: #333333;
    --text-secondary: #999999;
    --border-color: #e5e5e5;
    background-color: var(--bg-color);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--text-color);
}

.container {
    padding: 20rpx;
}

.btn-primary {
    background-color: var(--primary-color);
    color: #ffffff;
    border-radius: 12rpx;
    padding: 20rpx 40rpx;
    text-align: center;
    font-size: 32rpx;
}

.btn-primary:active {
    opacity: 0.8;
}

.card {
    background: #ffffff;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}