[Unit]
Description=Health Check Service (8085)
After=network.target

[Service]
Type=simple
User=verorun
WorkingDirectory=/home/verorun/verorun-workspace
EnvironmentFile=/etc/default/health-guardian
# 使用 runner.py 启动（手动控制 sys.path，避免 platform/ 目录 shadow 标准库）
ExecStart=/usr/bin/python3 /home/verorun/verorun-workspace/health_service/runner.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
