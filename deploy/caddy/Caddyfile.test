# ============================================================
# Caddyfile.test — On-Demand TLS 机制验证配置（非生产）
# ============================================================
# 目的：在生产机非标端口 8443 上验证「On-Demand TLS + ask 校验」全流程，
#       完全不碰生产 80/443，不依赖公网 ACME，不消耗 Let's Encrypt 配额。
#
# 关键：测试用 Caddy 内置 CA（tls internal，自签名证书），只验证机制：
#   新域名请求 → Caddy 调用 ask(/internal/caddy/check) → 合法则动态签发（自签名）
# 真实 Let's Encrypt 签发需公网 80/443（ACME 挑战），留待生产切换阶段。
#
# 启动：caddy run --config Caddyfile.test
# 验证：
#   # 已登记域名（site_domains 有 platform.easykai.cn 且 is_published=1）→ 应握手成功
#   curl -vk --resolve platform.easykai.cn:8443:127.0.0.1 https://platform.easykai.cn:8443/
#   # 未登记域名 → ask 返回 403，Caddy 拒绝签发，握手失败
#   curl -vk --resolve random-xyz.easykai.cn:8443:127.0.0.1 https://random-xyz.easykai.cn:8443/
# ============================================================

{
    # 非标端口，避免与生产 Nginx(80/443) 冲突
    http_port 8080
    https_port 8443

    # On-Demand TLS：握手时向校验 API 询问是否放行签发
    on_demand_tls {
        ask http://127.0.0.1:8084/internal/caddy/check
        interval 2m
        burst 5
    }
}

# 通配 catch-all：任意子域名，按需签证书（测试用内置 CA）
*.easykai.cn {
    tls internal {
        on_demand
    }
    reverse_proxy 127.0.0.1:8081
}
